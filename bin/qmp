#!/usr/bin/env python3
"""Send a QMP command to the harness VM and print the response.

Usage:
    qmp <command> [<args-json>]

Examples:
    qmp query-status
    qmp system_reset
    qmp inject-nmi
    qmp stop
    qmp cont
    qmp quit
    qmp human-monitor-command '{"command-line":"info registers"}'
"""

import json
import os
import socket
import sys

SOCK_PATH = os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
    "run", "qmp.sock"
)


def recv_obj(sock):
    buf = b""
    while not buf.endswith(b"\n"):
        chunk = sock.recv(4096)
        if not chunk:
            sys.exit("qmp: socket closed unexpectedly")
        buf += chunk
    return json.loads(buf.decode())


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: qmp <command> [<args-json>]")

    cmd_name = sys.argv[1]
    args = json.loads(sys.argv[2]) if len(sys.argv) > 2 else None

    if not os.path.exists(SOCK_PATH):
        sys.exit(f"qmp: socket {SOCK_PATH} does not exist (is the VM running?)")

    s = socket.socket(socket.AF_UNIX)
    try:
        s.connect(SOCK_PATH)
    except (ConnectionRefusedError, FileNotFoundError) as e:
        sys.exit(f"qmp: cannot connect to {SOCK_PATH}: {e}")

    recv_obj(s)  # banner
    s.sendall(b'{"execute":"qmp_capabilities"}\n')
    recv_obj(s)

    cmd = {"execute": cmd_name}
    if args is not None:
        cmd["arguments"] = args
    s.sendall((json.dumps(cmd) + "\n").encode())

    reply = recv_obj(s)
    print(json.dumps(reply, indent=2))

    if "error" in reply:
        sys.exit(1)


if __name__ == "__main__":
    main()
