#!/bin/sh
# pull — rsync crash dumps + test artifacts back to the host.
# Never fails the caller; missing paths on the guest are not errors.
#
# Identity and port come from ../vmenv.sh (see bin/push).

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VM_ROOT="$ROOT"
. "$ROOT/vmenv.sh"

SRC="${PULL_SRC:-$VM_TARGET}"

mkdir -p "$ROOT/logs/dumps" "$ROOT/logs/artifacts"

rsync -a -e "$VM_RSYNC_RSH" "$SRC:/var/crash/"   "$ROOT/logs/dumps/"     2>/dev/null || true
rsync -a -e "$VM_RSYNC_RSH" "$SRC:/root/h2-out/" "$ROOT/logs/artifacts/" 2>/dev/null || true

exit 0
