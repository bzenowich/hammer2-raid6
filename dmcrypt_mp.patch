+/**
+ * --------------------------------------
+ * AES-XTS with NEON (arm64 without the Crypto Extensions)
+ * --------------------------------------
+ */
+
+#ifdef HAVE_NEON_CRYPTO
+
+static int aes_neon_selftest_result = -1;	/* -1 not run, 0 ok, 1 bad */
+
+/*
+ * Compare against the generic code once, at the first probe: a sector
+ * each way under AES-128 and AES-256 keys.  The NEON code is never used
+ * if it disagrees.
+ */
+static int
+aes_neon_selftest(void)
+{
+	struct {
+		struct aes_neon_xts_ctx n;
+		struct aes_xts_ctx g;
+		uint8_t key[64], a[512], b[512], iv[16];
+	} *t;
+	int kb, i, bad = 0;
+
+	t = kmalloc(sizeof(*t), M_CRYPTOAPI, M_WAITOK);
+	for (kb = 32; kb <= 64; kb += 32) {
+		for (i = 0; i < 64; ++i)
+			t->key[i] = i * 7 + 3 + kb;
+		for (i = 0; i < 512; ++i)
+			t->a[i] = i * 13 + 1;
+		memset(t->iv, 0, sizeof(t->iv));
+		t->iv[0] = 0x5a; t->iv[3] = kb;
+		memcpy(t->b, t->a, sizeof(t->a));
+		aes_xts_setkey(&t->g, t->key, kb);
+		aes_xts_crypt(&t->g, t->a, 512, t->iv, true);
+		kernel_fpu_begin();
+		aes_neon_xts_setkey(&t->n, t->key, kb);
+		aes_neon_xts_crypt(&t->n, t->b, 512, t->iv, 1);
+		kernel_fpu_end();
+		if (memcmp(t->a, t->b, 512) != 0)
+			bad = 1;
+		kernel_fpu_begin();
+		aes_neon_xts_crypt(&t->n, t->b, 512, t->iv, 0);
+		kernel_fpu_end();
+		aes_xts_crypt(&t->g, t->a, 512, t->iv, false);
+		if (memcmp(t->a, t->b, 512) != 0)
+			bad = 1;
+	}
+	explicit_bzero(t, sizeof(*t));
+	kfree(t, M_CRYPTOAPI);
+	if (bad)
+		kprintf("cryptoapi: NEON AES-XTS self-test FAILED, not using it\n");
+	return bad;
+}
+
+static int
+aes_neon_xts_probe(int keysize_in_bits)
+{
+	if (neon_crypto_disable)
+		return (-1);
+	if (keysize_in_bits != 256 && keysize_in_bits != 512)
+		return (-1);
+	if (aes_neon_selftest_result < 0)
+		aes_neon_selftest_result = aes_neon_selftest();
+	return (aes_neon_selftest_result ? -1 : 0);
+}
+
+static int
+aes_neon_xts_setkey_api(void *_ctx, const uint8_t *keydata,
+    int keylen_in_bytes)
+{
+	int error;
+
+	if (keylen_in_bytes != 32 && keylen_in_bytes != 64)
+		return (EINVAL);
+	/* the key schedule is in a SIMD-compiled file too */
+	kernel_fpu_begin();
+	error = aes_neon_xts_setkey(_ctx, keydata, keylen_in_bytes);
+	kernel_fpu_end();
+	return (error ? EINVAL : 0);
+}
+
+static void
+aes_neon_xts_crypt_api(void *_ctx, uint8_t *data, int datalen,
+    const uint8_t *iv, bool encrypt)
+{
+	kernel_fpu_begin();
+	aes_neon_xts_crypt(_ctx, data, datalen, iv, encrypt);
+	kernel_fpu_end();
+}
+
+const struct cryptoapi_cipher_spec cipher_aes_neon_xts = {
+	.ciphername = "aes-xts",
+	.description = "AES-XTS (NEON, bitsliced)",
+	.blocksize = AES_XTS_BLOCK_LEN,
+	.ivsize = AES_XTS_IV_LEN,
+	.ctxsize = sizeof(struct aes_neon_xts_ctx),
+	.ctxalign = 16,
+	.probe = aes_neon_xts_probe,
+	.setkey = aes_neon_xts_setkey_api,
+	.crypt = aes_neon_xts_crypt_api,
+};
+
+#endif /* HAVE_NEON_CRYPTO */
