+/*
+ * Adiantum, portable C.  Written from the paper and Google's MIT-licensed
+ * Python reference (github.com/google/adiantum), and checked against its
+ * test vectors.
+ *
+ *   key setup:  XChaCha12(K, nonce 1 || 0^23) gives K_E (32 bytes, AES-256),
+ *               K_T, K_M (16 each, clamped Poly1305 r) and K_N (1072, NH)
+ *   H(T, X) =   Poly1305_{K_T}(le128(8 * |X|) || T)
+ *             + Poly1305_{K_M}(NH(X) per 1 KB chunk)        (no final "+ s")
+ *   encrypt:    P = P_L || P_R, P_R the last 16 bytes
+ *               P_M = P_R + H(T, P_L)              (mod 2^128, little-endian)
+ *               C_M = AES_{K_E}(P_M)
+ *               C_L = P_L ^ XChaCha12(K, nonce C_M || 1 || 0^7)
+ *               C_R = C_M - H(T, C_L)
+ */
+
+#ifdef _KERNEL
+#include <sys/param.h>
+#include <sys/systm.h>
+#else
+#include <stdint.h>
+#include <string.h>
+#include <strings.h>
+#endif
+
+#include <crypto/adiantum/adiantum.h>
+
+static inline uint32_t
+ld32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	    ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static inline uint64_t
+ld64(const uint8_t *p)
+{
+	return (uint64_t)ld32(p) | ((uint64_t)ld32(p + 4) << 32);
+}
+
+static inline void
+st32(uint8_t *p, uint32_t v)
+{
+	p[0] = v; p[1] = v >> 8; p[2] = v >> 16; p[3] = v >> 24;
+}
+
+static inline void
+st64(uint8_t *p, uint64_t v)
+{
+	st32(p, (uint32_t)v);
+	st32(p + 4, (uint32_t)(v >> 32));
+}
+
+/************************************************************************
+ * ChaCha12 / HChaCha12 / XChaCha12
+ ************************************************************************/
+
+#define ROTL32(v, n)	(((v) << (n)) | ((v) >> (32 - (n))))
+#define QR(a, b, c, d) do {						\
+	a += b; d ^= a; d = ROTL32(d, 16);				\
+	c += d; b ^= c; b = ROTL32(b, 12);				\
+	a += b; d ^= a; d = ROTL32(d, 8);				\
+	c += d; b ^= c; b = ROTL32(b, 7);				\
+} while (0)
+
+static const uint32_t chacha_const[4] = {
+	0x61707865, 0x3320646e, 0x79622d32, 0x6b206574	/* "expand 32-byte k" */
+};
+
+static void
+chacha12_rounds(uint32_t x[16])
+{
+	int i;
+
+	for (i = 0; i < 6; ++i) {
+		QR(x[0], x[4], x[8], x[12]);
+		QR(x[1], x[5], x[9], x[13]);
+		QR(x[2], x[6], x[10], x[14]);
+		QR(x[3], x[7], x[11], x[15]);
+		QR(x[0], x[5], x[10], x[15]);
+		QR(x[1], x[6], x[11], x[12]);
+		QR(x[2], x[7], x[8], x[13]);
+		QR(x[3], x[4], x[9], x[14]);
+	}
+}
+
+void
+adiantum_hchacha12(const uint32_t key[8], const uint8_t nonce[16],
+    uint32_t out[8])
+{
+	uint32_t x[16];
+	int i;
+
+	for (i = 0; i < 4; ++i)
+		x[i] = chacha_const[i];
+	for (i = 0; i < 8; ++i)
+		x[4 + i] = key[i];
+	for (i = 0; i < 4; ++i)
+		x[12 + i] = ld32(nonce + 4 * i);
+	chacha12_rounds(x);
+	for (i = 0; i < 4; ++i) {
+		out[i] = x[i];
+		out[4 + i] = x[12 + i];
+	}
+	explicit_bzero(x, sizeof(x));
+}
+
+static void
+generic_chacha12_xor(const uint32_t key[8], const uint8_t nonce[8],
+    uint8_t *data, size_t len)
+{
+	uint32_t s[16], x[16];
+	uint8_t ks[64];
+	uint64_t ctr = 0;
+	size_t n, i;
+
+	for (i = 0; i < 4; ++i)
+		s[i] = chacha_const[i];
+	for (i = 0; i < 8; ++i)
+		s[4 + i] = key[i];
+	s[14] = ld32(nonce);
+	s[15] = ld32(nonce + 4);
+	while (len > 0) {
+		s[12] = (uint32_t)ctr;
+		s[13] = (uint32_t)(ctr >> 32);
+		memcpy(x, s, sizeof(x));
+		chacha12_rounds(x);
+		for (i = 0; i < 16; ++i)
+			st32(ks + 4 * i, x[i] + s[i]);
+		n = len < 64 ? len : 64;
+		for (i = 0; i < n; ++i)
+			data[i] ^= ks[i];
+		data += n;
+		len -= n;
+		++ctr;
+	}
+	explicit_bzero(x, sizeof(x));
+	explicit_bzero(ks, sizeof(ks));
+}
+
+/* data ^= XChaCha12(key, nonce16 || nonce8) */
+static void
+xchacha12_xor(const struct adiantum_ops *ops, const uint32_t key[8],
+    const uint8_t nonce16[16], const uint8_t nonce8[8], uint8_t *data,
+    size_t len)
+{
+	uint32_t subkey[8];
+
+	adiantum_hchacha12(key, nonce16, subkey);
+	ops->chacha12_xor(subkey, nonce8, data, len);
+	explicit_bzero(subkey, sizeof(subkey));
+}
+
+/************************************************************************
+ * Poly1305 without the final addition (44-bit limbs, 64x64->128 products)
+ ************************************************************************/
+
+#define M44	0xfffffffffffULL
+#define M42	0x3ffffffffffULL
+
+typedef unsigned __int128 u128;
+
+static void
+poly_setr(uint64_t r[3], const uint8_t k[16])
+{
+	uint64_t t0 = ld64(k), t1 = ld64(k + 8);
+
+	r[0] = t0 & 0xffc0fffffffULL;
+	r[1] = ((t0 >> 44) | (t1 << 20)) & 0xfffffc0ffffULL;
+	r[2] = (t1 >> 24) & 0x00ffffffc0fULL;
+}
+
+/* full 16-byte blocks get 2^128 added (hibit 1 << 40 in limb 2) */
+static void
+poly_blocks(uint64_t h[3], const uint64_t r[3], const uint8_t *m,
+    size_t nblocks, uint64_t hibit)
+{
+	uint64_t r0 = r[0], r1 = r[1], r2 = r[2];
+	uint64_t s1 = r1 * (5 << 2), s2 = r2 * (5 << 2);
+	uint64_t h0 = h[0], h1 = h[1], h2 = h[2], c, t0, t1;
+	u128 d0, d1, d2;
+
+	while (nblocks-- > 0) {
+		t0 = ld64(m);
+		t1 = ld64(m + 8);
+		h0 += t0 & M44;
+		h1 += ((t0 >> 44) | (t1 << 20)) & M44;
+		h2 += ((t1 >> 24) & M42) | hibit;
+
+		d0 = (u128)h0 * r0 + (u128)h1 * s2 + (u128)h2 * s1;
+		d1 = (u128)h0 * r1 + (u128)h1 * r0 + (u128)h2 * s2;
+		d2 = (u128)h0 * r2 + (u128)h1 * r1 + (u128)h2 * r0;
+
+		c = (uint64_t)(d0 >> 44); h0 = (uint64_t)d0 & M44;
+		d1 += c;
+		c = (uint64_t)(d1 >> 44); h1 = (uint64_t)d1 & M44;
+		d2 += c;
+		c = (uint64_t)(d2 >> 42); h2 = (uint64_t)d2 & M42;
+		h0 += c * 5;
+		c = h0 >> 44; h0 &= M44;
+		h1 += c;
+		m += 16;
+	}
+	h[0] = h0; h[1] = h1; h[2] = h2;
+}
+
+/* any length; a partial last block is padded with 1, 0... and no hibit */
+static void
+poly_update(uint64_t h[3], const uint64_t r[3], const uint8_t *m, size_t len)
+{
+	uint8_t buf[16];
+	size_t n = len / 16;
+
+	if (n > 0)
+		poly_blocks(h, r, m, n, 1ULL << 40);
+	len -= n * 16;
+	if (len > 0) {
+		memset(buf, 0, sizeof(buf));
+		memcpy(buf, m + n * 16, len);
+		buf[len] = 1;
+		poly_blocks(h, r, buf, 1, 0);
+	}
+}
+
+/* h mod 2^130-5, then its low 128 bits */
+static void
+poly_emit(const uint64_t hin[3], uint64_t out[2])
+{
+	uint64_t h0 = hin[0], h1 = hin[1], h2 = hin[2];
+	uint64_t g0, g1, g2, c, mask;
+
+	c = h1 >> 44; h1 &= M44; h2 += c;
+	c = h2 >> 42; h2 &= M42; h0 += c * 5;
+	c = h0 >> 44; h0 &= M44; h1 += c;
+	c = h1 >> 44; h1 &= M44; h2 += c;
+	c = h2 >> 42; h2 &= M42; h0 += c * 5;
+	c = h0 >> 44; h0 &= M44; h1 += c;
+
+	/* g = h + 5 - 2^130; use it if it didn't go negative */
+	g0 = h0 + 5; c = g0 >> 44; g0 &= M44;
+	g1 = h1 + c; c = g1 >> 44; g1 &= M44;
+	g2 = h2 + c - (1ULL << 42);
+	mask = (g2 >> 63) - 1;		/* all ones if g2 >= 0 */
+	h0 = (h0 & ~mask) | (g0 & mask);
+	h1 = (h1 & ~mask) | (g1 & mask);
+	h2 = (h2 & ~mask) | (g2 & mask);
+
+	out[0] = h0 | (h1 << 44);
+	out[1] = (h1 >> 20) | (h2 << 24);
+}
+
+/************************************************************************
+ * NH (4 passes, stride 2, 32-bit words)
+ ************************************************************************/
+
+static void
+generic_nh(const uint32_t *key, const uint8_t *msg, size_t len,
+    uint64_t sums[4])
+{
+	uint64_t s0 = 0, s1 = 0, s2 = 0, s3 = 0;
+	uint32_t m0, m1, m2, m3;
+
+	for (; len >= 16; len -= 16, msg += 16, key += 4) {
+		m0 = ld32(msg); m1 = ld32(msg + 4);
+		m2 = ld32(msg + 8); m3 = ld32(msg + 12);
+#define NHP(s, o)							\
+		s += (uint64_t)(uint32_t)(m0 + key[o + 0]) *		\
+		    (uint32_t)(m2 + key[o + 2]);			\
+		s += (uint64_t)(uint32_t)(m1 + key[o + 1]) *		\
+		    (uint32_t)(m3 + key[o + 3]);
+		NHP(s0, 0)
+		NHP(s1, 4)
+		NHP(s2, 8)
+		NHP(s3, 12)
+#undef NHP
+	}
+	sums[0] = s0; sums[1] = s1; sums[2] = s2; sums[3] = s3;
+}
+
+const struct adiantum_ops adiantum_generic_ops = {
+	.chacha12_xor = generic_chacha12_xor,
+	.nh = generic_nh,
+};
+
+/************************************************************************
+ * Adiantum
+ ************************************************************************/
+
+void
+adiantum_setkey(struct adiantum_ctx *ctx, const uint8_t key[ADIANTUM_KEY_SIZE])
+{
+	uint8_t ks[32 + 16 + 16 + 4 * ADIANTUM_NH_KEY_WORDS];
+	uint8_t nonce16[16], nonce8[8];
+	int i;
+
+	for (i = 0; i < 8; ++i)
+		ctx->stream_key[i] = ld32(key + 4 * i);
+	memset(nonce16, 0, sizeof(nonce16));
+	memset(nonce8, 0, sizeof(nonce8));
+	nonce16[0] = 1;
+	memset(ks, 0, sizeof(ks));
+	xchacha12_xor(&adiantum_generic_ops, ctx->stream_key, nonce16, nonce8,
+	    ks, sizeof(ks));
+
+	rijndael_set_key(&ctx->aes, ks, 256);
+	poly_setr(ctx->rt, ks + 32);
+	poly_setr(ctx->rm, ks + 48);
+	for (i = 0; i < ADIANTUM_NH_KEY_WORDS; ++i)
+		ctx->nh_key[i] = ld32(ks + 64 + 4 * i);
+	explicit_bzero(ks, sizeof(ks));
+}
+
+/* Poly1305_{K_M} over the NH hash of each 1 KB chunk of msg */
+static void
+hash_msg(const struct adiantum_ctx *ctx, const struct adiantum_ops *ops,
+    const uint8_t *msg, size_t len, uint64_t out[2])
+{
+	uint64_t h[3] = { 0, 0, 0 }, sums[4], tail[4];
+	uint8_t nhout[32], pad[16];
+	size_t n, full;
+	int i;
+
+	while (len > 0) {
+		n = len < ADIANTUM_NH_CHUNK ? len : ADIANTUM_NH_CHUNK;
+		full = n & ~(size_t)15;
+		if (full > 0) {
+			ops->nh(ctx->nh_key, msg, full, sums);
+		} else {
+			sums[0] = sums[1] = sums[2] = sums[3] = 0;
+		}
+		if (n > full) {
+			/* zero-padded partial unit, only in the last chunk */
+			memset(pad, 0, sizeof(pad));
+			memcpy(pad, msg + full, n - full);
+			generic_nh(ctx->nh_key + full / 4, pad, 16, tail);
+			for (i = 0; i < 4; ++i)
+				sums[i] += tail[i];
+		}
+		for (i = 0; i < 4; ++i)
+			st64(nhout + 8 * i, sums[i]);
+		poly_blocks(h, ctx->rm, nhout, 2, 1ULL << 40);
+		msg += n;
+		len -= n;
+	}
+	poly_emit(h, out);
+}
+
+/* Poly1305_{K_T}(le128(8 * msglen) || tweak) */
+static void
+hash_tweak(const struct adiantum_ctx *ctx, size_t msglen,
+    const uint8_t *tweak, size_t tweaklen, uint64_t out[2])
+{
+	uint64_t h[3] = { 0, 0, 0 };
+	uint8_t lenblk[16];
+
+	memset(lenblk, 0, sizeof(lenblk));
+	st64(lenblk, (uint64_t)msglen * 8);
+	poly_blocks(h, ctx->rt, lenblk, 1, 1ULL << 40);
+	poly_update(h, ctx->rt, tweak, tweaklen);
+	poly_emit(h, out);
+}
+
+/* blk (le128) += sign * (a + b) */
+static void
+blk_addsub(uint8_t blk[16], const uint64_t a[2], const uint64_t b[2],
+    int subtract)
+{
+	uint64_t lo, hi, x0, x1, c;
+
+	/* v = a + b mod 2^128 */
+	lo = a[0] + b[0];
+	c = lo < a[0];
+	hi = a[1] + b[1] + c;
+	x0 = ld64(blk);
+	x1 = ld64(blk + 8);
+	if (subtract) {
+		c = x0 < lo;
+		x0 -= lo;
+		x1 = x1 - hi - c;
+	} else {
+		x0 += lo;
+		c = x0 < lo;
+		x1 = x1 + hi + c;
+	}
+	st64(blk, x0);
+	st64(blk + 8, x1);
+}
+
+void
+adiantum_crypt(const struct adiantum_ctx *ctx, const struct adiantum_ops *ops,
+    uint8_t *data, size_t len, const uint8_t *tweak, size_t tweaklen,
+    int encrypt)
+{
+	static const uint8_t nonce8[8] = { 1, 0, 0, 0, 0, 0, 0, 0 };
+	size_t bulk = len - 16;
+	uint8_t *right = data + bulk;
+	uint8_t mid[16];
+	uint64_t ht[2], hm[2];
+
+	hash_tweak(ctx, bulk, tweak, tweaklen, ht);
+
+	/* the right block plus the hash of the left part, as it is now */
+	hash_msg(ctx, ops, data, bulk, hm);
+	memcpy(mid, right, 16);
+	blk_addsub(mid, ht, hm, 0);
+
+	/* P_M -> C_M or C_M -> P_M; the stream always uses C_M */
+	if (encrypt) {
+		rijndael_encrypt(&ctx->aes, mid, mid);
+		xchacha12_xor(ops, ctx->stream_key, mid, nonce8, data, bulk);
+	} else {
+		xchacha12_xor(ops, ctx->stream_key, mid, nonce8, data, bulk);
+		rijndael_decrypt(&ctx->aes, mid, mid);
+	}
+
+	/* minus the hash of the left part as it is after the stream */
+	hash_msg(ctx, ops, data, bulk, hm);
+	blk_addsub(mid, ht, hm, 1);
+	memcpy(right, mid, 16);
+	explicit_bzero(mid, sizeof(mid));
+}
