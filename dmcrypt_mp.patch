+ * LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED
+ * AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY,
+ * OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY
+ * OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF
+ * SUCH DAMAGE.
+ */
+
+/*
+ * Adiantum: length-preserving encryption for processors without AES
+ * instructions (Crowley and Biggers, IACR ToSC 2018(4)).  An HBSH
+ * construction: NH + Poly1305 hash, one AES-256 block, XChaCha12 for the
+ * bulk.  Wide-block, so changing any bit of a sector changes all of its
+ * ciphertext, unlike XTS's 16-byte granularity.  Byte-compatible with
+ * Linux's "xchacha12,aes-adiantum-plain64" when the tweak is the 16-byte
+ * IV zero-extended to 32 bytes.
+ */
+
+#ifndef _CRYPTO_ADIANTUM_H_
+#define _CRYPTO_ADIANTUM_H_
+
+#include <sys/types.h>
+#include <crypto/rijndael/rijndael.h>
+
+#define ADIANTUM_KEY_SIZE	32
+#define ADIANTUM_TWEAK_SIZE	32
+#define ADIANTUM_NH_KEY_WORDS	268	/* (1024 + 3 * 16) / 4 */
+#define ADIANTUM_NH_CHUNK	1024
+
+struct adiantum_ctx {
+	uint32_t	stream_key[8];	/* the user key, for XChaCha12 */
+	uint64_t	rt[3];		/* Poly1305 r for the tweak (44-bit limbs) */
+	uint64_t	rm[3];		/* Poly1305 r for the NH hashes */
+	uint32_t	nh_key[ADIANTUM_NH_KEY_WORDS];
+	rijndael_ctx	aes;		/* K_E, AES-256 */
+} __attribute__((aligned(16)));
+
+/*
+ * The bulk primitives, portable or NEON.
+ *  chacha12_xor: data ^= ChaCha12(key, nonce, counter 0..), len any.
+ *  nh: the four 64-bit NH sums over len bytes (a multiple of 16, at most
+ *      ADIANTUM_NH_CHUNK), key advancing 4 words per 16-byte unit.
+ */
+struct adiantum_ops {
+	void	(*chacha12_xor)(const uint32_t key[8], const uint8_t nonce[8],
+		    uint8_t *data, size_t len);
+	void	(*nh)(const uint32_t *key, const uint8_t *msg, size_t len,
+		    uint64_t sums[4]);
+};
+
+extern const struct adiantum_ops adiantum_generic_ops;
+#if defined(__aarch64__)
+/* compiled with SIMD; in the kernel bracket calls with kernel_fpu_begin/end */
+extern const struct adiantum_ops adiantum_neon_ops;
+#endif
+
+void	adiantum_setkey(struct adiantum_ctx *ctx,
+	    const uint8_t key[ADIANTUM_KEY_SIZE]);
+/* len >= 16; tweaklen at most ADIANTUM_TWEAK_SIZE */
+void	adiantum_crypt(const struct adiantum_ctx *ctx,
+	    const struct adiantum_ops *ops, uint8_t *data, size_t len,
+	    const uint8_t *tweak, size_t tweaklen, int encrypt);
+
+/* exposed for tests */
+void	adiantum_hchacha12(const uint32_t key[8], const uint8_t nonce[16],
+	    uint32_t out[8]);
+
+#endif /* _CRYPTO_ADIANTUM_H_ */
