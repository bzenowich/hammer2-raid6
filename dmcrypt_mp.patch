index 0000000000..e993a4b2ec
--- /dev/null
+++ b/sys/crypto/adiantum/adiantum_neon.c
@@ -0,0 +1,192 @@
+/*
+ * Copyright (c) 2026 The DragonFly Project.  All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ *
+ * 1. Redistributions of source code must retain the above copyright
+ *    notice, this list of conditions and the following disclaimer.
+ * 2. Redistributions in binary form must reproduce the above copyright
+ *    notice, this list of conditions and the following disclaimer in
+ *    the documentation and/or other materials provided with the
+ *    distribution.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS
+ * ``AS IS'' AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT
+ * LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS
+ * FOR A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO EVENT SHALL THE
+ * COPYRIGHT HOLDERS OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT,
+ * INCIDENTAL, SPECIAL, EXEMPLARY OR CONSEQUENTIAL DAMAGES (INCLUDING,
+ * BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;
+ * LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED
+ * AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY,
+ * OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY
+ * OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF
+ * SUCH DAMAGE.
+ */
+
+/*
+ * NEON versions of Adiantum's bulk primitives: ChaCha12 four blocks at a
+ * time (one block per 32-bit lane) and NH with widening multiply-adds.
+ * Compiled with SIMD enabled; in the kernel the caller brackets each
+ * adiantum_crypt() with kernel_fpu_begin()/kernel_fpu_end().
+ */
+
+#ifdef _KERNEL
+#include <sys/param.h>
+#include <sys/systm.h>
+#else
+#include <stdint.h>
+#include <string.h>
+#include <strings.h>
+#endif
+#include <arm_neon.h>
+
+#include <crypto/adiantum/adiantum.h>
+
+static const uint8_t rot8_idx[16] __attribute__((aligned(16))) = {
+	3, 0, 1, 2, 7, 4, 5, 6, 11, 8, 9, 10, 15, 12, 13, 14
+};
+
+#define ROT16(v)  vreinterpretq_u32_u16(vrev32q_u16(vreinterpretq_u16_u32(v)))
+#define ROT8(v)   vreinterpretq_u32_u8(vqtbl1q_u8(vreinterpretq_u8_u32(v), r8))
+#define ROTL(v, n) vsriq_n_u32(vshlq_n_u32(v, n), v, 32 - (n))
+
+#define VQR(a, b, c, d) do {						\
+	a = vaddq_u32(a, b); d = veorq_u32(d, a); d = ROT16(d);		\
+	c = vaddq_u32(c, d); b = veorq_u32(b, c); b = ROTL(b, 12);	\
+	a = vaddq_u32(a, b); d = veorq_u32(d, a); d = ROT8(d);		\
+	c = vaddq_u32(c, d); b = veorq_u32(b, c); b = ROTL(b, 7);	\
+} while (0)
+
+/* out[4] = lane b of a,b,c,d for each block b: a 4x4 transpose */
+#define TRANSPOSE4(a, b, c, d) do {					\
+	uint32x4_t t0_ = vtrn1q_u32(a, b), t1_ = vtrn2q_u32(a, b);	\
+	uint32x4_t t2_ = vtrn1q_u32(c, d), t3_ = vtrn2q_u32(c, d);	\
+	a = vreinterpretq_u32_u64(vtrn1q_u64(vreinterpretq_u64_u32(t0_),	\
+	    vreinterpretq_u64_u32(t2_)));				\
+	b = vreinterpretq_u32_u64(vtrn1q_u64(vreinterpretq_u64_u32(t1_),	\
+	    vreinterpretq_u64_u32(t3_)));				\
+	c = vreinterpretq_u32_u64(vtrn2q_u64(vreinterpretq_u64_u32(t0_),	\
+	    vreinterpretq_u64_u32(t2_)));				\
+	d = vreinterpretq_u32_u64(vtrn2q_u64(vreinterpretq_u64_u32(t1_),	\
+	    vreinterpretq_u64_u32(t3_)));				\
+} while (0)
+
+/* 256 bytes of keystream for counters ctr..ctr+3, XORed into out */
+static inline void
+chacha12_4blk(const uint32_t s[16], uint64_t ctr, const uint8_t *in,
+    uint8_t *out)
+{
+	const uint8x16_t r8 = vld1q_u8(rot8_idx);
+	uint32_t lo[4], hi[4];
+	uint32x4_t x[16], o[16];
+	int i;
+
+	for (i = 0; i < 4; ++i) {
+		lo[i] = (uint32_t)(ctr + i);
+		hi[i] = (uint32_t)((ctr + i) >> 32);
+	}
+	for (i = 0; i < 16; ++i)
+		o[i] = vdupq_n_u32(s[i]);
+	o[12] = vld1q_u32(lo);
+	o[13] = vld1q_u32(hi);
+	for (i = 0; i < 16; ++i)
+		x[i] = o[i];
+
+	for (i = 0; i < 6; ++i) {
+		VQR(x[0], x[4], x[8], x[12]);
+		VQR(x[1], x[5], x[9], x[13]);
+		VQR(x[2], x[6], x[10], x[14]);
+		VQR(x[3], x[7], x[11], x[15]);
+		VQR(x[0], x[5], x[10], x[15]);
+		VQR(x[1], x[6], x[11], x[12]);
+		VQR(x[2], x[7], x[8], x[13]);
+		VQR(x[3], x[4], x[9], x[14]);
+	}
+	for (i = 0; i < 16; ++i)
+		x[i] = vaddq_u32(x[i], o[i]);
+	TRANSPOSE4(x[0], x[1], x[2], x[3]);
+	TRANSPOSE4(x[4], x[5], x[6], x[7]);
+	TRANSPOSE4(x[8], x[9], x[10], x[11]);
+	TRANSPOSE4(x[12], x[13], x[14], x[15]);
+
+	/* block b is x[b], x[4+b], x[8+b], x[12+b] */
+	for (i = 0; i < 16; ++i) {
+		int off = 64 * (i & 3) + 16 * (i >> 2);
+
+		vst1q_u8(out + off, veorq_u8(vld1q_u8(in + off),
+		    vreinterpretq_u8_u32(x[i])));
+	}
+}
+
+static void
+neon_chacha12_xor(const uint32_t key[8], const uint8_t nonce[8],
+    uint8_t *data, size_t len)
+{
+	static const uint32_t cst[4] = {
+		0x61707865, 0x3320646e, 0x79622d32, 0x6b206574
+	};
+	uint8_t buf[256] __attribute__((aligned(16)));
+	uint32_t s[16];
+	uint64_t ctr = 0;
+	int i;
+
+	for (i = 0; i < 4; ++i)
+		s[i] = cst[i];
+	for (i = 0; i < 8; ++i)
+		s[4 + i] = key[i];
+	s[12] = s[13] = 0;
+	memcpy(&s[14], nonce, 8);	/* little-endian host */
+
+	for (; len >= 256; len -= 256, data += 256, ctr += 4)
+		chacha12_4blk(s, ctr, data, data);
+	if (len > 0) {
+		memset(buf, 0, sizeof(buf));
+		memcpy(buf, data, len);
+		chacha12_4blk(s, ctr, buf, buf);
+		memcpy(data, buf, len);
+		explicit_bzero(buf, sizeof(buf));
+	}
+}
+
+/*
+ * NH: for 16-byte unit u and pass p, t = m + key[4(u+p) .. 4(u+p)+3];
+ * sum_p += t0 * t2 + t1 * t3.  vmlal_u32 of the low and high halves gives
+ * those two products in two 64-bit lanes, added together at the end.
+ */
+static void
+neon_nh(const uint32_t *key, const uint8_t *msg, size_t len, uint64_t sums[4])
+{
+	uint64x2_t a0 = vdupq_n_u64(0), a1 = a0, a2 = a0, a3 = a0;
+	uint32x4_t k0 = vld1q_u32(key), k1 = vld1q_u32(key + 4);
+	uint32x4_t k2 = vld1q_u32(key + 8), k3, m, t;
+
+	key += 12;
+	for (; len >= 16; len -= 16, msg += 16) {
+		k3 = vld1q_u32(key);
+		key += 4;
+		m = vreinterpretq_u32_u8(vld1q_u8(msg));
+		t = vaddq_u32(m, k0);
+		a0 = vmlal_u32(a0, vget_low_u32(t), vget_high_u32(t));
+		t = vaddq_u32(m, k1);
+		a1 = vmlal_u32(a1, vget_low_u32(t), vget_high_u32(t));
+		t = vaddq_u32(m, k2);
+		a2 = vmlal_u32(a2, vget_low_u32(t), vget_high_u32(t));
+		t = vaddq_u32(m, k3);
+		a3 = vmlal_u32(a3, vget_low_u32(t), vget_high_u32(t));
+		k0 = k1;
+		k1 = k2;
+		k2 = k3;
+	}
+	sums[0] = vaddvq_u64(a0);
+	sums[1] = vaddvq_u64(a1);
+	sums[2] = vaddvq_u64(a2);
+	sums[3] = vaddvq_u64(a3);
+}
+
+const struct adiantum_ops adiantum_neon_ops = {
+	.chacha12_xor = neon_chacha12_xor,
+	.nh = neon_nh,
+};
