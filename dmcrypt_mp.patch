+/************************************************************************
+ * MULTI-CORE WORKERS
+ ************************************************************************/
+
+/*
+ * Split the bio into pieces and queue them to the workers.  Returns 0
+ * if the caller should do the work synchronously instead (workers off
+ * or not running), 1 if the request was queued; the last piece to
+ * finish then calls dmtc_req_done().
+ */
+static int
+dmtc_dispatch(dm_target_crypt_config_t *priv, struct bio *bio,
+    uint8_t *data_buf, struct malloc_pipe *mpipe, int mode)
+{
+	struct dmtc_req *req;
+	struct dmtc_worker *w;
+	struct dmtc_worker *wake[DMTC_MAXPIECES];
+	struct dmtc_piece *p;
+	int bytes, sectors, npieces, per, off, i, k, pass, pmin, nw, nwake;
+	int me, start;
+
+	nw = dmtc_nworkers;
+	cpu_ccfence();
+	if (dmtc_mp == 0 || nw == 0 || dmtc_stopping)
+		return 0;
+
+	bytes = bio->bio_buf->b_bcount;
+	if (__predict_false(bytes > DMTC_BUF_SIZE))
+		panic("dmtc: Allocated data buffer is too small");
+
+	pmin = dmtc_piece_min;
+	if (pmin < priv->sector_size)
+		pmin = priv->sector_size;
+	npieces = bytes / pmin;
+	if (npieces > nw)
+		npieces = nw;
+	if (npieces > DMTC_MAXPIECES)
+		npieces = DMTC_MAXPIECES;
+	if (npieces < 1)
+		npieces = 1;
+
+	req = (struct dmtc_req *)(data_buf + DMTC_BUF_SIZE);
+	req->bio = bio;
+	req->priv = priv;
+	req->mpipe = mpipe;
+	req->data_buf = data_buf;
+	req->src = bio->bio_buf->b_data;
+	req->mode = mode;
+	req->error = 0;
+	req->remaining = npieces;
+
+	/* sector-aligned pieces; the last one takes the remainder */
+	sectors = bytes / priv->sector_size;
+	per = sectors / npieces;
+	off = 0;
+	for (i = 0; i < npieces; ++i) {
+		p = &req->pieces[i];
+		p->req = req;
+		p->off = off;
+		p->len = (i == npieces - 1) ? bytes - off :
+		    per * priv->sector_size;
+		off += p->len;
+	}
+
+	/*
+	 * Queue them and pick up to npieces idle workers to wake, those on
+	 * other CPUs first.  Nothing in req may be touched once the lock is
+	 * dropped: a worker may already have completed it.
+	 */
+	me = mycpuid;
+	start = atomic_fetchadd_int(&dmtc_rr, 1);
+	nwake = 0;
+	spin_lock(&dmtc_spin);
+	for (i = 0; i < npieces; ++i)
+		TAILQ_INSERT_TAIL(&dmtc_queue, &req->pieces[i], entry);
+	for (pass = 0; pass < 2 && nwake < npieces; ++pass) {
+		for (k = 0; k < nw && nwake < npieces; ++k) {
+			i = (start + k) % nw;
+			w = &dmtc_workers[i];
+			if (w->idle == 0 || (pass == 0 && i == me))
+				continue;
+			w->idle = 0;
+			wake[nwake++] = w;
+		}
+	}
+	spin_unlock(&dmtc_spin);
+	for (i = 0; i < nwake; ++i)
+		wakeup(wake[i]);
+	return 1;
+}
+
+static void
+dmtc_piece_run(struct dmtc_piece *p)
+{
+	struct dmtc_req *req = p->req;
+	uint8_t *work = req->data_buf + p->off;
+	uint8_t *src = req->src + p->off;
+	int error;
+
+	/*
+	 * Never en/decrypt the caller's buffer in place: writes must not
+	 * change it, and a read buffer can have bogus pages.
+	 */
+	memcpy(work, src, p->len);
+	error = dmtc_bio_encdec(req->priv, work, p->len,
+	    req->bio->bio_offset + p->off, req->mode);
+	if (error == 0 && req->mode == CRYPTOAPI_CIPHER_DECRYPT)
+		memcpy(src, work, p->len);
+	if (error)
+		atomic_cmpset_int(&req->error, 0, error);
+
+	if (atomic_fetchadd_int(&req->remaining, -1) == 1)
+		dmtc_req_done(req);
+}
+
+/*
+ * All pieces are done.  Same completion as the synchronous
+ * dmtc_bio_write_encrypt() and dmtc_bio_read_decrypt().
+ */
+static void
+dmtc_req_done(struct dmtc_req *req)
+{
+	struct bio *bio = req->bio;
+	struct bio *obio;
+	struct malloc_pipe *mpipe = req->mpipe;
+	uint8_t *data_buf = req->data_buf;
+	dm_target_crypt_config_t *priv = req->priv;
+	int error = req->error;
+
+	if (req->mode == CRYPTOAPI_CIPHER_ENCRYPT) {
+		if (error) {
+			kprintf("dm_target_crypt: dmtc_bio_write_encrypt "
+			    "error = %d\n", error);
+			bio->bio_buf->b_error = error;
+			bio->bio_buf->b_flags |= B_ERROR;
+			mpipe_free(mpipe, data_buf);
+			obio = pop_bio(bio);
+			biodone(obio);
+			return;
+		}
+		bio->bio_buf->b_error = 0;
+		bio->bio_caller_info2.ptr = bio->bio_buf->b_data; /* orig_buf */
+		bio->bio_buf->b_data = data_buf;
+		bio->bio_done = dmtc_bio_write_done;
+		vn_strategy(priv->pdev->pdev_vnode, bio);
+	} else {
+		bio->bio_buf->b_error = error;
+		if (error) {
+			kprintf("dm_target_crypt: dmtc_bio_read_decrypt "
+			    "error = %d\n", error);
+			bio->bio_buf->b_flags |= B_ERROR;
+		}
+		obio = pop_bio(bio);
+		biodone(obio);
+		mpipe_free(mpipe, data_buf);
+	}
+}
+
+static void
+dmtc_worker_main(void *arg)
+{
+	struct dmtc_worker *w = arg;
+	struct dmtc_piece *p;
+
+	spin_lock(&dmtc_spin);
+	for (;;) {
+		p = TAILQ_FIRST(&dmtc_queue);
+		if (p == NULL) {
+			if (dmtc_stopping)
+				break;
+			w->idle = 1;
+			ssleep(w, &dmtc_spin, 0, "dmtcw", 0);
+			w->idle = 0;
+			continue;
+		}
+		TAILQ_REMOVE(&dmtc_queue, p, entry);
+		spin_unlock(&dmtc_spin);
+		dmtc_piece_run(p);
+		spin_lock(&dmtc_spin);
+	}
+	w->idle = 0;
+	w->td = NULL;
+	spin_unlock(&dmtc_spin);
+	wakeup(&dmtc_workers);
+	kthread_exit();
+}
+
+static void
+dmtc_workers_start(void)
+{
+	struct dmtc_worker *w;
+	int i;
+
+	dmtc_stopping = 0;
+	spin_init(&dmtc_spin, "dmtcq");
+	TAILQ_INIT(&dmtc_queue);
+	dmtc_workers = kmalloc(sizeof(*dmtc_workers) * ncpus, M_DMCRYPT,
+	    M_WAITOK | M_ZERO);
+	for (i = 0; i < ncpus; ++i) {
+		w = &dmtc_workers[i];
+		if (kthread_create_cpu(dmtc_worker_main, w, &w->td, i,
+		    "dmtc %d", i) != 0) {
+			kprintf("dm_target_crypt: no worker on cpu %d\n", i);
+			break;
+		}
+		dmtc_nworkers = i + 1;
+	}
+	kprintf("dm_target_crypt: %d worker threads\n", dmtc_nworkers);
+}
+
+/*
+ * Called once no crypt target exists any more, so every queue is
+ * empty; the workers just have to be told to exit.
+ */
+static void
+dmtc_workers_stop(void)
+{
+	struct dmtc_worker *w;
+	int i, n;
+
+	n = dmtc_nworkers;
+	dmtc_stopping = 1;
+	dmtc_nworkers = 0;
+	for (i = 0; i < n; ++i) {
+		w = &dmtc_workers[i];
+		spin_lock(&dmtc_spin);
+		while (w->td != NULL) {
+			spin_unlock(&dmtc_spin);
+			wakeup(w);
+			tsleep(&dmtc_workers, 0, "dmtcx", hz / 10);
+			spin_lock(&dmtc_spin);
+		}
+		spin_unlock(&dmtc_spin);
+	}
+	spin_uninit(&dmtc_spin);
+	kfree(dmtc_workers, M_DMCRYPT);
+	dmtc_workers = NULL;
+}
