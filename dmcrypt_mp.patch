+	0x60, 0x51, 0x7f, 0xa9, 0x19, 0xb5, 0x4a, 0x0d, 0x2d, 0xe5, 0x7a, 0x9f, 0x93, 0xc9, 0x9c, 0xef,
+	0xa0, 0xe0, 0x3b, 0x4d, 0xae, 0x2a, 0xf5, 0xb0, 0xc8, 0xeb, 0xbb, 0x3c, 0x83, 0x53, 0x99, 0x61,
+	0x17, 0x2b, 0x04, 0x7e, 0xba, 0x77, 0xd6, 0x26, 0xe1, 0x69, 0x14, 0x63, 0x55, 0x21, 0x0c, 0x7d,
+};
+
+/* byte index tables, state is column-major: byte 4*c + r */
+static const uint8_t shiftrows_idx[16] __attribute__((aligned(16))) = {
+	0, 5, 10, 15, 4, 9, 14, 3, 8, 13, 2, 7, 12, 1, 6, 11
+};
+static const uint8_t invshiftrows_idx[16] __attribute__((aligned(16))) = {
+	0, 13, 10, 7, 4, 1, 14, 11, 8, 5, 2, 15, 12, 9, 6, 3
+};
+/* row r of each column takes row r+1: a 32-bit rotate right by 8 */
+static const uint8_t ror8_idx[16] __attribute__((aligned(16))) = {
+	1, 2, 3, 0, 5, 6, 7, 4, 9, 10, 11, 8, 13, 14, 15, 12
+};
+
+/************************************************************************
+ * Key schedule (scalar)
+ ************************************************************************/
+
+int
+aes_neon_setkey(struct aes_neon_key *k, const uint8_t *key, int keybytes)
+{
+	uint8_t *w = k->rk;
+	uint8_t t[4], tmp, rcon = 1;
+	int nk, nw, i;
+
+	if (keybytes == 16)
+		k->nr = 10;
+	else if (keybytes == 32)
+		k->nr = 14;
+	else
+		return -1;
+	nk = keybytes / 4;
+	nw = 4 * (k->nr + 1);
+	memcpy(w, key, keybytes);
+	for (i = nk; i < nw; ++i) {
+		memcpy(t, w + 4 * (i - 1), 4);
+		if (i % nk == 0) {
+			tmp = t[0];
+			t[0] = aes_sbox[t[1]] ^ rcon;
+			t[1] = aes_sbox[t[2]];
+			t[2] = aes_sbox[t[3]];
+			t[3] = aes_sbox[tmp];
+			rcon = (rcon << 1) ^ ((rcon & 0x80) ? 0x1b : 0);
+		} else if (nk > 6 && i % nk == 4) {
+			t[0] = aes_sbox[t[0]];
+			t[1] = aes_sbox[t[1]];
+			t[2] = aes_sbox[t[2]];
+			t[3] = aes_sbox[t[3]];
+		}
+		w[4 * i + 0] = w[4 * (i - nk) + 0] ^ t[0];
+		w[4 * i + 1] = w[4 * (i - nk) + 1] ^ t[1];
+		w[4 * i + 2] = w[4 * (i - nk) + 2] ^ t[2];
+		w[4 * i + 3] = w[4 * (i - nk) + 3] ^ t[3];
+	}
+	return 0;
+}
+
+/************************************************************************
+ * Round primitives
+ ************************************************************************/
+
+struct aes_tabs {
+	uint8x16x4_t	s[4];		/* the S-box or inverse S-box */
+	uint8x16_t	sr;		/* (inv)shiftrows permutation */
+	uint8x16_t	ror8;
+};
+
+static inline uint8x16_t
+sub_bytes(const struct aes_tabs *t, uint8x16_t x)
+{
+	const uint8x16_t c40 = vdupq_n_u8(0x40);
+	uint8x16_t y;
+
+	/* out-of-range indexes leave the lane alone in TBX */
+	y = vqtbl4q_u8(t->s[0], x);
+	x = vsubq_u8(x, c40);
+	y = vqtbx4q_u8(y, t->s[1], x);
+	x = vsubq_u8(x, c40);
+	y = vqtbx4q_u8(y, t->s[2], x);
+	x = vsubq_u8(x, c40);
+	y = vqtbx4q_u8(y, t->s[3], x);
+	return y;
+}
+
+static inline uint8x16_t
+xtime(uint8x16_t x)
+{
+	uint8x16_t hi = vreinterpretq_u8_s8(vshrq_n_s8(vreinterpretq_s8_u8(x), 7));
+
+	return veorq_u8(vshlq_n_u8(x, 1), vandq_u8(hi, vdupq_n_u8(0x1b)));
+}
+
+static inline uint8x16_t
+rot16(uint8x16_t x)		/* row r takes row r+2 */
+{
+	return vreinterpretq_u8_u16(vrev32q_u16(vreinterpretq_u16_u8(x)));
+}
+
+/* b_r = 2a_r ^ 3a_{r+1} ^ a_{r+2} ^ a_{r+3} = xtime(a_r^a_{r+1}) ^ ... */
+static inline uint8x16_t
+mix_columns(const struct aes_tabs *t, uint8x16_t a)
+{
+	uint8x16_t r1 = vqtbl1q_u8(a, t->ror8);
+	uint8x16_t s = veorq_u8(a, r1);
+
+	return veorq_u8(veorq_u8(xtime(s), r1), rot16(s));
+}
+
+/* InvMixColumns = MixColumns after a_r ^= 4(a_r ^ a_{r+2}) */
+static inline uint8x16_t
+inv_mix_columns(const struct aes_tabs *t, uint8x16_t a)
+{
+	uint8x16_t w = xtime(xtime(veorq_u8(a, rot16(a))));
+
+	return mix_columns(t, veorq_u8(a, w));
+}
+
+static inline void
+load_tabs(struct aes_tabs *t, int decrypt)
+{
+	const uint8_t *s = decrypt ? aes_isbox : aes_sbox;
+
+	t->s[0] = vld1q_u8_x4(s);
+	t->s[1] = vld1q_u8_x4(s + 64);
+	t->s[2] = vld1q_u8_x4(s + 128);
+	t->s[3] = vld1q_u8_x4(s + 192);
+	t->sr = vld1q_u8(decrypt ? invshiftrows_idx : shiftrows_idx);
+	t->ror8 = vld1q_u8(ror8_idx);
+}
+
+/************************************************************************
+ * One and four blocks
+ ************************************************************************/
+
+static inline uint8x16_t
+enc1(const struct aes_tabs *t, const struct aes_neon_key *k, uint8x16_t x)
+{
+	const uint8_t *rk = k->rk;
+	int r;
+
+	x = veorq_u8(x, vld1q_u8(rk));
+	for (r = 1; r < k->nr; ++r) {
+		x = sub_bytes(t, vqtbl1q_u8(x, t->sr));
+		x = veorq_u8(mix_columns(t, x), vld1q_u8(rk + 16 * r));
+	}
+	x = sub_bytes(t, vqtbl1q_u8(x, t->sr));
+	return veorq_u8(x, vld1q_u8(rk + 16 * k->nr));
+}
+
+static inline uint8x16_t
+dec1(const struct aes_tabs *t, const struct aes_neon_key *k, uint8x16_t x)
+{
+	const uint8_t *rk = k->rk;
+	int r;
+
+	x = veorq_u8(x, vld1q_u8(rk + 16 * k->nr));
+	for (r = k->nr - 1; r > 0; --r) {
+		x = sub_bytes(t, vqtbl1q_u8(x, t->sr));
+		x = inv_mix_columns(t, veorq_u8(x, vld1q_u8(rk + 16 * r)));
+	}
+	x = sub_bytes(t, vqtbl1q_u8(x, t->sr));
+	return veorq_u8(x, vld1q_u8(rk));
+}
+
+void
+aes_neon_encrypt_block(const struct aes_neon_key *k, uint8_t blk[16])
+{
+	struct aes_tabs t;
+
+	load_tabs(&t, 0);
+	vst1q_u8(blk, enc1(&t, k, vld1q_u8(blk)));
+}
+
+void
+aes_neon_decrypt_block(const struct aes_neon_key *k, uint8_t blk[16])
+{
+	struct aes_tabs t;
+
+	load_tabs(&t, 1);
+	vst1q_u8(blk, dec1(&t, k, vld1q_u8(blk)));
+}
+
+/************************************************************************
+ * Bitsliced AES, eight blocks at a time
+ *
+ * Eight 16-byte blocks are 1024 bits; they are held as eight registers
+ * b[0..7] where b[i] byte lane p holds bit i of state byte p of each
+ * block (block j in bit j).  Byte lanes keep the state layout, so
+ * ShiftRows and the MixColumns rotations are the same TBL/REV byte
+ * permutations as in the one-block code, xtime is a renaming of the
+ * registers plus three XORs, and SubBytes is the Boyar-Peralta 113-gate
+ * circuit (J. Boyar, R. Peralta, "A depth-16 circuit for the AES S-box",
+ * 2011) evaluated on all 128 bytes at once.  The inverse S-box is the
+ * forward one between two inverse-affine maps: S^-1(y) = L(S(L(y) ^ 5)) ^ 5
+ * with L the linear part of the inverse affine transform.
+ ************************************************************************/
+
+typedef uint8x16_t v128;
+
+#define X(a, b)	veorq_u8(a, b)
+#define A(a, b)	vandq_u8(a, b)
+#define N(a)	vmvnq_u8(a)
+
+#define SWAPMOVE(lo, hi, n, m) do {					\
+	v128 t_ = A(X(vshrq_n_u8(lo, n), hi), vdupq_n_u8(m));		\
+	hi = X(hi, t_);							\
+	lo = X(lo, vshlq_n_u8(t_, n));					\
+} while (0)
+
+/* blocks <-> bit planes; an 8x8 bit transpose per byte lane, an involution */
+static inline void
+bitslice(v128 x[8])
+{
+	SWAPMOVE(x[0], x[1], 1, 0x55); SWAPMOVE(x[2], x[3], 1, 0x55);
+	SWAPMOVE(x[4], x[5], 1, 0x55); SWAPMOVE(x[6], x[7], 1, 0x55);
+	SWAPMOVE(x[0], x[2], 2, 0x33); SWAPMOVE(x[1], x[3], 2, 0x33);
+	SWAPMOVE(x[4], x[6], 2, 0x33); SWAPMOVE(x[5], x[7], 2, 0x33);
+	SWAPMOVE(x[0], x[4], 4, 0x0f); SWAPMOVE(x[1], x[5], 4, 0x0f);
+	SWAPMOVE(x[2], x[6], 4, 0x0f); SWAPMOVE(x[3], x[7], 4, 0x0f);
+}
+
+static inline void
+bs_sbox(v128 q[8])
+{
+	v128 x0 = q[7], x1 = q[6], x2 = q[5], x3 = q[4];
+	v128 x4 = q[3], x5 = q[2], x6 = q[1], x7 = q[0];
+	v128 y1, y2, y3, y4, y5, y6, y7, y8, y9, y10, y11, y12, y13, y14;
+	v128 y15, y16, y17, y18, y19, y20, y21;
+	v128 z0, z1, z2, z3, z4, z5, z6, z7, z8, z9, z10, z11, z12, z13;
+	v128 z14, z15, z16, z17;
+	v128 t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12, t13;
+	v128 t14, t15, t16, t17, t18, t19, t20, t21, t22, t23, t24, t25;
+	v128 t26, t27, t28, t29, t30, t31, t32, t33, t34, t35, t36, t37;
+	v128 t38, t39, t40, t41, t42, t43, t44, t45, t46, t47, t48, t49;
+	v128 t50, t51, t52, t53, t54, t55, t56, t57, t58, t59, t60, t61;
+	v128 t62, t63, t64, t65, t66, t67;
+	v128 s0, s1, s2, s3, s4, s5, s6, s7;
+
+	/* top linear transformation */
+	y14 = X(x3, x5);	y13 = X(x0, x6);	y9 = X(x0, x3);
+	y8 = X(x0, x5);		t0 = X(x1, x2);		y1 = X(t0, x7);
+	y4 = X(y1, x3);		y12 = X(y13, y14);	y2 = X(y1, x0);
+	y5 = X(y1, x6);		y3 = X(y5, y8);		t1 = X(x4, y12);
+	y15 = X(t1, x5);	y20 = X(t1, x1);	y6 = X(y15, x7);
+	y10 = X(y15, t0);	y11 = X(y20, y9);	y7 = X(x7, y11);
+	y17 = X(y10, y11);	y19 = X(y10, y8);	y16 = X(t0, y11);
+	y21 = X(y13, y16);	y18 = X(x0, y16);
+
+	/* non-linear middle */
+	t2 = A(y12, y15);	t3 = A(y3, y6);		t4 = X(t3, t2);
+	t5 = A(y4, x7);		t6 = X(t5, t2);		t7 = A(y13, y16);
+	t8 = A(y5, y1);		t9 = X(t8, t7);		t10 = A(y2, y7);
+	t11 = X(t10, t7);	t12 = A(y9, y11);	t13 = A(y14, y17);
+	t14 = X(t13, t12);	t15 = A(y8, y10);	t16 = X(t15, t12);
+	t17 = X(t4, t14);	t18 = X(t6, t16);	t19 = X(t9, t14);
+	t20 = X(t11, t16);	t21 = X(t17, y20);	t22 = X(t18, y19);
+	t23 = X(t19, y21);	t24 = X(t20, y18);
+
+	t25 = X(t21, t22);	t26 = A(t21, t23);	t27 = X(t24, t26);
+	t28 = A(t25, t27);	t29 = X(t28, t22);	t30 = X(t23, t24);
+	t31 = X(t22, t26);	t32 = A(t31, t30);	t33 = X(t32, t24);
+	t34 = X(t23, t33);	t35 = X(t27, t33);	t36 = A(t24, t35);
+	t37 = X(t36, t34);	t38 = X(t27, t36);	t39 = A(t29, t38);
+	t40 = X(t25, t39);
+
+	t41 = X(t40, t37);	t42 = X(t29, t33);	t43 = X(t29, t40);
+	t44 = X(t33, t37);	t45 = X(t42, t41);
+	z0 = A(t44, y15);	z1 = A(t37, y6);	z2 = A(t33, x7);
+	z3 = A(t43, y16);	z4 = A(t40, y1);	z5 = A(t29, y7);
+	z6 = A(t42, y11);	z7 = A(t45, y17);	z8 = A(t41, y10);
+	z9 = A(t44, y12);	z10 = A(t37, y3);	z11 = A(t33, y4);
+	z12 = A(t43, y13);	z13 = A(t40, y5);	z14 = A(t29, y2);
+	z15 = A(t42, y9);	z16 = A(t45, y14);	z17 = A(t41, y8);
+
+	/* bottom linear transformation */
+	t46 = X(z15, z16);	t47 = X(z10, z11);	t48 = X(z5, z13);
+	t49 = X(z9, z10);	t50 = X(z2, z12);	t51 = X(z2, z5);
+	t52 = X(z7, z8);	t53 = X(z0, z3);	t54 = X(z6, z7);
+	t55 = X(z16, z17);	t56 = X(z12, t48);	t57 = X(t50, t53);
+	t58 = X(z4, t46);	t59 = X(z3, t54);	t60 = X(t46, t57);
+	t61 = X(z14, t57);	t62 = X(t52, t58);	t63 = X(t49, t58);
+	t64 = X(z4, t59);	t65 = X(t61, t62);	t66 = X(z1, t63);
+	s0 = X(t59, t63);	s6 = X(t56, N(t62));	s7 = X(t48, N(t60));
+	t67 = X(t64, t65);	s3 = X(t53, t66);	s4 = X(t51, t66);
+	s5 = X(t47, t65);	s1 = X(t64, N(s3));	s2 = X(t55, N(t67));
+
+	q[7] = s0; q[6] = s1; q[5] = s2; q[4] = s3;
+	q[3] = s4; q[2] = s5; q[1] = s6; q[0] = s7;
+}
+
+/* q = L(q) ^ 0x05, the inverse affine transform */
+static inline void
+bs_inv_affine(v128 q[8])
+{
+	v128 o[8];
+	int i;
+
+	for (i = 0; i < 8; ++i)
+		o[i] = X(X(q[(i + 2) & 7], q[(i + 5) & 7]), q[(i + 7) & 7]);
+	q[0] = N(o[0]); q[1] = o[1]; q[2] = N(o[2]); q[3] = o[3];
+	q[4] = o[4]; q[5] = o[5]; q[6] = o[6]; q[7] = o[7];
+}
+
+static inline void
+bs_inv_sbox(v128 q[8])
+{
+	bs_inv_affine(q);
+	bs_sbox(q);
+	bs_inv_affine(q);
+}
+
+static inline void
+bs_xtime(const v128 a[8], v128 o[8])
+{
+	o[0] = a[7];
+	o[1] = X(a[0], a[7]);
+	o[2] = a[1];
+	o[3] = X(a[2], a[7]);
+	o[4] = X(a[3], a[7]);
+	o[5] = a[4];
+	o[6] = a[5];
+	o[7] = a[6];
+}
+
+static inline void
+bs_mix_columns(v128 q[8], uint8x16_t ror8)
+{
+	v128 r[8], s[8], xs[8];
+	int i;
+
+	for (i = 0; i < 8; ++i) {
+		r[i] = vqtbl1q_u8(q[i], ror8);
+		s[i] = X(q[i], r[i]);
+	}
+	bs_xtime(s, xs);
+	for (i = 0; i < 8; ++i)
+		q[i] = X(X(xs[i], r[i]), rot16(s[i]));
+}
+
+static inline void
+bs_inv_mix_columns(v128 q[8], uint8x16_t ror8)
+{
+	v128 u[8], w1[8], w2[8];
+	int i;
+
+	for (i = 0; i < 8; ++i)
+		u[i] = X(q[i], rot16(q[i]));
+	bs_xtime(u, w1);
+	bs_xtime(w1, w2);
+	for (i = 0; i < 8; ++i)
+		q[i] = X(q[i], w2[i]);
+	bs_mix_columns(q, ror8);
+}
+
+static inline void
+bs_shift(v128 q[8], uint8x16_t idx)
+{
+	int i;
+
+	for (i = 0; i < 8; ++i)
+		q[i] = vqtbl1q_u8(q[i], idx);
+}
+
+static inline void
+bs_ark(v128 q[8], const uint8_t *bk)
+{
+	int i;
+
+	for (i = 0; i < 8; ++i)
+		q[i] = X(q[i], vld1q_u8(bk + 16 * i));
+}
+
+/* q is bitsliced; bk the bitsliced round keys (128 bytes per round) */
+static void
+bs_encrypt(v128 q[8], const uint8_t *bk, int nr)
+{
+	const uint8x16_t sr = vld1q_u8(shiftrows_idx);
+	const uint8x16_t ror8 = vld1q_u8(ror8_idx);
+	int r;
+
+	bs_ark(q, bk);
+	for (r = 1; r < nr; ++r) {
+		bs_shift(q, sr);
+		bs_sbox(q);
+		bs_mix_columns(q, ror8);
+		bs_ark(q, bk + 128 * r);
+	}
+	bs_shift(q, sr);
+	bs_sbox(q);
+	bs_ark(q, bk + 128 * nr);
+}
+
+static void
+bs_decrypt(v128 q[8], const uint8_t *bk, int nr)
+{
+	const uint8x16_t isr = vld1q_u8(invshiftrows_idx);
+	const uint8x16_t ror8 = vld1q_u8(ror8_idx);
+	int r;
+
+	bs_ark(q, bk + 128 * nr);
+	for (r = nr - 1; r > 0; --r) {
+		bs_shift(q, isr);
+		bs_inv_sbox(q);
+		bs_ark(q, bk + 128 * r);
+		bs_inv_mix_columns(q, ror8);
+	}
+	bs_shift(q, isr);
+	bs_inv_sbox(q);
+	bs_ark(q, bk);
+}
+
+/************************************************************************
+ * XTS
+ ************************************************************************/
+
+int
+aes_neon_xts_setkey(struct aes_neon_xts_ctx *ctx, const uint8_t *key,
+    int keybytes)
+{
+	int half = keybytes / 2, r, i, p;
+	const uint8_t *rk;
+	uint8_t *bk;
+
+	if (aes_neon_setkey(&ctx->k1, key, half) != 0 ||
+	    aes_neon_setkey(&ctx->k2, key + half, half) != 0)
+		return -1;
+	/* bit i of round-key byte p, broadcast to every block */
+	for (r = 0; r <= ctx->k1.nr; ++r) {
+		rk = ctx->k1.rk + 16 * r;
+		bk = ctx->bk + 128 * r;
+		for (i = 0; i < 8; ++i)
+			for (p = 0; p < 16; ++p)
+				bk[16 * i + p] = -((rk[p] >> i) & 1);
+	}
+	return 0;
+}
+
+/*
+ * Multiply the tweak by x in GF(2^128), little-endian (IEEE P1619):
+ * shift the 128-bit value left by one, folding bit 127 back as 0x87.
+ */
+static inline uint8x16_t
+xts_mulx(uint8x16_t t)
+{
+	static const uint64_t cst[2] __attribute__((aligned(16))) = { 1, 0x87 };
+	uint64x2_t v = vreinterpretq_u64_u8(t);
+	uint64x2_t top = vreinterpretq_u64_s64(
+	    vshrq_n_s64(vreinterpretq_s64_u64(v), 63));
+	uint64x2_t c = vandq_u64(top, vld1q_u64(cst));
+
+	/* lane 0 gets 0x87 from lane 1's top bit, lane 1 gets lane 0's carry */
+	c = vextq_u64(c, c, 1);
+	return vreinterpretq_u8_u64(veorq_u64(vshlq_n_u64(v, 1), c));
+}
+
+void
+aes_neon_xts_crypt(const struct aes_neon_xts_ctx *ctx, uint8_t *data,
+    size_t len, const uint8_t iv[16], int encrypt)
+{
+	struct aes_tabs t;
+	uint8_t tw[16] __attribute__((aligned(16)));
+	uint8x16_t T, tt[8], x[8];
+	size_t nblk = len / 16, n, i;
+
+	memcpy(tw, iv, 8);
+	memset(tw + 8, 0, 8);
+	load_tabs(&t, 0);
+	T = enc1(&t, &ctx->k2, vld1q_u8(tw));
+
+	while (nblk > 0) {
+		n = nblk < 8 ? nblk : 8;
+		for (i = 0; i < 8; ++i) {
+			tt[i] = T;
+			if (i < n) {
+				x[i] = X(vld1q_u8(data + 16 * i), T);
+				T = xts_mulx(T);
+			} else {
+				x[i] = vdupq_n_u8(0);
+			}
+		}
+		bitslice(x);
+		if (encrypt)
+			bs_encrypt(x, ctx->bk, ctx->k1.nr);
+		else
+			bs_decrypt(x, ctx->bk, ctx->k1.nr);
+		bitslice(x);
+		for (i = 0; i < n; ++i)
+			vst1q_u8(data + 16 * i, X(x[i], tt[i]));
+		data += 16 * n;
+		nblk -= n;
+	}
+}
