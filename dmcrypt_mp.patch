+/*
+ * AES with ARMv8 Advanced SIMD (NEON), for cores without the ARMv8
+ * Cryptography Extensions (the Raspberry Pi 4's Cortex-A72).
+ *
+ * Everything in aes_neon.c is compiled with the SIMD registers enabled,
+ * so in the kernel every call must be bracketed by kernel_fpu_begin()
+ * and kernel_fpu_end(), key setup included.
+ */
+
+#ifndef _CRYPTO_AES_NEON_H_
+#define _CRYPTO_AES_NEON_H_
+
+#include <sys/types.h>
+
+#define AES_NEON_MAXNR	14
+
+struct aes_neon_key {
+	uint8_t	rk[16 * (AES_NEON_MAXNR + 1)];	/* encryption round keys */
+	int	nr;				/* 10 or 14 */
+} __attribute__((aligned(16)));
+
+struct aes_neon_xts_ctx {
+	struct aes_neon_key k1;		/* data key */
+	struct aes_neon_key k2;		/* tweak key */
+	uint8_t	bk[128 * (AES_NEON_MAXNR + 1)];	/* k1 bitsliced */
+} __attribute__((aligned(16)));
+
+/* keybytes 16 or 32; returns 0 or EINVAL-like -1 */
+int	aes_neon_setkey(struct aes_neon_key *k, const uint8_t *key,
+	    int keybytes);
+void	aes_neon_encrypt_block(const struct aes_neon_key *k, uint8_t blk[16]);
+void	aes_neon_decrypt_block(const struct aes_neon_key *k, uint8_t blk[16]);
+/* keybytes 32 (AES-128) or 64 (AES-256), the two keys concatenated */
+int	aes_neon_xts_setkey(struct aes_neon_xts_ctx *ctx, const uint8_t *key,
+	    int keybytes);
+/*
+ * XTS over len bytes (a multiple of 16) in place.  As in the generic
+ * cryptoapi code, only the first 8 bytes of iv are used (the sector
+ * number); the other 8 are taken as zero.
+ */
+void	aes_neon_xts_crypt(const struct aes_neon_xts_ctx *ctx, uint8_t *data,
+	    size_t len, const uint8_t iv[16], int encrypt);
+
+#endif /* _CRYPTO_AES_NEON_H_ */
