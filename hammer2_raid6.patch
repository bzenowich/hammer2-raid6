+/*
+ * RAID 6 disk replacement (online resilver).
+ *
+ * Identifies the failed disk by matching old_dev against volume paths,
+ * opens new_dev, resilvering all data to it, then atomically swaps it
+ * into the volume array.
+ */
+static int
+hammer2_ioctl_raid_replace(hammer2_inode_t *ip, void *data)
+{
+	hammer2_ioc_raid_replace_t *rr = data;
+	hammer2_dev_t *hmp;
+	hammer2_devvp_t *dev;
+	struct vnode *new_devvp = NULL;
+	struct vnode *old_devvp;
+	struct nlookupdata nd;
+	int failed_disk_idx = -1;
+	int error;
+	int i;
+
+	hmp = ip->pmp->pfs_hmps[0];
+	if (hmp == NULL)
+		return EINVAL;
+	if (hmp->raid_type != HAMMER2_RAID_TYPE_RAID6)
+		return ENOTSUP;
+
+	/* Ensure path is NUL-terminated */
+	rr->old_dev[sizeof(rr->old_dev) - 1] = 0;
+	rr->new_dev[sizeof(rr->new_dev) - 1] = 0;
+
+	/* Find which disk index matches old_dev */
+	for (i = 0; i < hmp->nvolumes; i++) {
+		if (hmp->volumes[i].dev &&
+		    hmp->volumes[i].dev->path &&
+		    strcmp(hmp->volumes[i].dev->path, rr->old_dev) == 0) {
+			failed_disk_idx = i;
+			break;
+		}
+	}
+	if (failed_disk_idx < 0) {
+		kprintf("hammer2: raid replace: %s not found in array\n",
+			rr->old_dev);
+		return ENOENT;
+	}
+
+	/* Open the replacement device */
+	error = nlookup_init(&nd, rr->new_dev, UIO_SYSSPACE, NLC_FOLLOW);
+	if (error == 0)
+		error = nlookup(&nd);
+	if (error == 0)
+		error = cache_vref(&nd.nl_nch, nd.nl_cred, &new_devvp);
+	nlookup_done(&nd);
+	if (error) {
+		kprintf("hammer2: raid replace: cannot open %s: %d\n",
+			rr->new_dev, error);
+		return error;
+	}
+	if (!vn_isdisk(new_devvp, &error)) {
+		vrele(new_devvp);
+		return error;
+	}
+
+	/* Open the device for writing */
+	vn_lock(new_devvp, LK_EXCLUSIVE | LK_RETRY);
+	error = VOP_OPEN(new_devvp, FREAD | FWRITE, FSCRED, NULL);
+	vn_unlock(new_devvp);
+	if (error) {
+		vrele(new_devvp);
+		kprintf("hammer2: raid replace: cannot open %s: %d\n",
+			rr->new_dev, error);
+		return error;
+	}
+
+	/*
+	 * Install the new device before the resilver so that writes made
+	 * while it runs reach it (hammer2_raid6_disk_writable).  The disk
+	 * stays failed for reads and allocation until the resilver is done.
+	 * Taking rebuild_lk exclusive waits out writers that already
+	 * decided to skip this disk.
+	 */
+	lockmgr(&hmp->rebuild_lk, LK_EXCLUSIVE);
+	if (!hmp->raid_failed[failed_disk_idx] || hmp->rebuild_active) {
+		lockmgr(&hmp->rebuild_lk, LK_RELEASE);
+		kprintf("hammer2: raid replace: disk %d %s\n", failed_disk_idx,
+			hmp->rebuild_active ? "another rebuild is running" :
+			"is not failed (fail-disk it first)");
+		vn_lock(new_devvp, LK_EXCLUSIVE | LK_RETRY);
+		VOP_CLOSE(new_devvp, FREAD | FWRITE, NULL);
+		vn_unlock(new_devvp);
+		vrele(new_devvp);
+		return EBUSY;
+	}
+	error = hammer2_raid6_replace_check(hmp, failed_disk_idx, new_devvp,
+					    rr->new_dev);
+	if (error) {
+		lockmgr(&hmp->rebuild_lk, LK_RELEASE);
+		vn_lock(new_devvp, LK_EXCLUSIVE | LK_RETRY);
+		VOP_CLOSE(new_devvp, FREAD | FWRITE, NULL);
+		vn_unlock(new_devvp);
+		vrele(new_devvp);
+		return error;
+	}
+	dev = hmp->volumes[failed_disk_idx].dev;
+	old_devvp = dev->devvp;
+	/* failed but never closed (auto-fail): release it now */
+	hammer2_raid6_close_member_locked(hmp, failed_disk_idx, NULL);
+	if (hmp->stripe_bitmap_size)
+		hmp->rebuild_done = kmalloc(hmp->stripe_bitmap_size,
+					    M_HAMMER2, M_WAITOK | M_ZERO);
+	dev->devvp = new_devvp;
+	dev->open = 1;
+	hammer2_io_retarget_disk(hmp, failed_disk_idx, new_devvp);
+	hmp->rebuild_disk = failed_disk_idx;
+	hmp->rebuild_werror = 0;
+	hmp->rebuild_active = 1;
+	lockmgr(&hmp->rebuild_lk, LK_RELEASE);
+
+	kprintf("hammer2: RAID6 resilver disk %d (%s) -> %s\n",
+		failed_disk_idx, rr->old_dev, rr->new_dev);
+
+	/* Run the resilver (this may take a long time) */
+	error = hammer2_io_raid6_resilver(hmp, ip->pmp, failed_disk_idx, new_devvp);
+
+	lockmgr(&hmp->rebuild_lk, LK_EXCLUSIVE);
+	hmp->rebuild_active = 0;
+	/* writers hold rebuild_lk shared, so rebuild_werror is final */
+	if (error == 0 && hmp->rebuild_werror)
+		error = hmp->rebuild_werror;
+	if (hmp->rebuild_done) {
+		kfree(hmp->rebuild_done, M_HAMMER2);
+		hmp->rebuild_done = NULL;
+	}
+	if (error) {
+		kprintf("hammer2: resilver failed: %d\n", error);
+		dev->devvp = old_devvp;
+		dev->open = 0;
+		hammer2_io_retarget_disk(hmp, failed_disk_idx, old_devvp);
+		lockmgr(&hmp->rebuild_lk, LK_RELEASE);
+		/*
+		 * VOP_CLOSE on a devfs spec vnode expects the vnode locked
+		 * exclusively (devfs_spec_close → vn_lock → upgrade panics
+		 * otherwise).  Mirror the VOP_OPEN lock/unlock above.
+		 */
+		vn_lock(new_devvp, LK_EXCLUSIVE | LK_RETRY);
+		VOP_CLOSE(new_devvp, FREAD | FWRITE, NULL);
+		vn_unlock(new_devvp);
+		vrele(new_devvp);
+		return error;
+	}
+
+	/*
+	 * The new disk is complete.  Bring it online; this is under
+	 * rebuild_lk so no seal sees it half-way.
+	 */
+	hammer2_voldata_lock(hmp);
+
+	if (dev->path)
+		kfree(dev->path, M_HAMMER2);
+	dev->path = kstrdup(rr->new_dev, M_HAMMER2);
+
+	/* Clear failure state */
+	if (hmp->raid_failed[failed_disk_idx]) {
+		hmp->raid_failed[failed_disk_idx] = 0;
+		atomic_add_int(&hmp->raid_nfailed, -1);
+	}
+
+	/*
+	 * The new disk holds no space map copy; have the next two
+	 * flushes write both copies whole.
+	 */
+	hammer2_raid6_sm_dirty_all(hmp);
+
+	/* Update on-disk RAID config disk state (both runtime and persisted) */
+	hmp->raid_config.disk_state[failed_disk_idx] =
+		HAMMER2_RAID6_DISK_ONLINE;
+	hmp->voldata.raid_config.disk_state[failed_disk_idx] =
+		HAMMER2_RAID6_DISK_ONLINE;
+	if (hmp->raid_nfailed == 0) {
+		hmp->raid_config.flags &= ~HAMMER2_RAID6_FLAG_DEGRADED;
+		hmp->voldata.raid_config.flags &= ~HAMMER2_RAID6_FLAG_DEGRADED;
+	}
+	hammer2_voldata_modify(hmp);
+
+	hammer2_voldata_unlock(hmp);
+	lockmgr(&hmp->rebuild_lk, LK_RELEASE);
+
+	/* The mount's reference to the old vnode; ours moves to dev. */
+	if (old_devvp)
+		vrele(old_devvp);
+
+	/* Flush the updated config to all disks */
+	hammer2_vfs_sync(ip->pmp->mp, MNT_WAIT);
+
+	if (hmp->raid_nfailed == 0) {
+		kprintf("hammer2: RAID6 disk %d online; "
+			"array fully healthy (%d disks)\n",
+			failed_disk_idx, hmp->raid_config.ndisks);
+	} else {
+		kprintf("hammer2: RAID6 disk %d online; "
+			"%d disk(s) still failed\n",
+			failed_disk_idx, hmp->raid_nfailed);
+	}
+	rr->error = 0;
+	rr->progress = 100;
+
+	return 0;
+}
+
+/*
+ * Mark a RAID6 disk as failed from userspace.
+ *
+ * After this call the kernel stops submitting I/O to that device.
+ * The device can then be detached (e.g. vnconfig -u) without EBUSY.
+ * Use HAMMER2IOC_RAID_REPLACE to resilver onto a replacement disk.
+ */
+static int
+hammer2_ioctl_raid_fail_disk(hammer2_inode_t *ip, void *data)
+{
+	hammer2_ioc_raid_fail_disk_t *rfd = data;
+	hammer2_dev_t *hmp;
+	int error;
+	int i;
+
+	hmp = ip->pmp->pfs_hmps[0];
+	if (hmp == NULL)
+		return EINVAL;
+	if (hmp->raid_type != HAMMER2_RAID_TYPE_RAID6)
+		return ENOTSUP;
+
+	rfd->dev[sizeof(rfd->dev) - 1] = 0;
+
+	for (i = 0; i < hmp->nvolumes; i++) {
+		if (hmp->volumes[i].dev == NULL ||
+		    hmp->volumes[i].dev->path == NULL)
+			continue;
+		if (strcmp(hmp->volumes[i].dev->path, rfd->dev) != 0)
+			continue;
+
+		if (!hmp->raid_failed[i]) {
+			/*
+			 * Ensure all pending writes complete before
+			 * marking the disk failed.
+			 */
+			hammer2_vfs_sync_pmp(ip->pmp, MNT_WAIT);
+			error = hammer2_raid6_mark_failed(hmp, i, 0);
+			if (error) {
+				kprintf("hammer2: raid fail-disk: already %d "
+					"disk(s) failed, cannot tolerate "
+					"more\n", hmp->raid_nfailed);
+				return error;
+			}
+			/* Release the open file reference on the failed disk */
+			hammer2_raid6_close_member(hmp, i, NULL);
+			kprintf("hammer2: RAID6 disk %d (%s) marked failed; "
+				"operating in degraded mode\n",
+				i, rfd->dev);
+		} else {
+			kprintf("hammer2: RAID6 disk %d (%s) already failed\n",
+				i, rfd->dev);
+		}
+		rfd->disk_idx = i;
+		return 0;
+	}
+
+	kprintf("hammer2: raid fail-disk: %s not found in array\n", rfd->dev);
+	return ENOENT;
+}
+
+/*
+ * Query resilver progress.
+ *
+ * Returns the current resilver state from hmp without blocking.
+ * Safe to call while HAMMER2IOC_RAID_REPLACE is running in another thread.
+ * The stripes_done counter is updated by the resilver loop every 256 stripes.
+ */
+static int
+hammer2_ioctl_resilver_status(hammer2_inode_t *ip, void *data)
+{
+	hammer2_ioc_resilver_status_t *rs = data;
+	hammer2_dev_t *hmp;
+	uint64_t done, total;
+
+	hmp = ip->pmp->pfs_hmps[0];
+	if (hmp == NULL)
+		return EINVAL;
+	if (hmp->raid_type != HAMMER2_RAID_TYPE_RAID6)
+		return ENOTSUP;
+
+	/*
+	 * Snapshot the volatile counters.  No lock needed: the resilver
+	 * loop only writes these fields, we only read them.  A slightly
+	 * stale value is acceptable for a progress display.
+	 */
+	rs->running   = hmp->resilver_running;
+	rs->disk_idx  = hmp->resilver_disk_idx;
+	done          = hmp->resilver_stripes_done;
+	total         = hmp->resilver_stripes_total;
+	rs->stripes_done  = done;
+	rs->stripes_total = total;
+	rs->error     = 0;
+
+	if (total == 0 || !rs->running) {
+		rs->progress = rs->running ? 0 : 100;
+	} else {
+		rs->progress = (int)((done * 100) / total);
+		if (rs->progress > 99)
+			rs->progress = 99; /* reserve 100 for completion */
+	}
+
+	/*
+	 * G2: surface persisted per-disk fail-state so `hammer2 raid status`
+	 * can prove the fail-disk ioctl survived umount/remount.  Walk the
+	 * in-memory raid_failed[] (init_volumes already lifted disk_state[]
+	 * out of voldata at mount time) so absent-disk degraded mounts are
+	 * reflected too.
+	 */
+	rs->ndisks = hmp->raid_config.ndisks;
+	bzero(rs->disk_state, sizeof(rs->disk_state));
+	bzero(rs->cksum_errors, sizeof(rs->cksum_errors));
+	bzero(rs->cksum_healed, sizeof(rs->cksum_healed));
+	bzero(rs->cksum_unrepairable, sizeof(rs->cksum_unrepairable));
+	{
+		uint32_t i;
+		uint32_t lim = rs->ndisks;
+		if (lim > HAMMER2_MAX_VOLUMES)
+			lim = HAMMER2_MAX_VOLUMES;
+		for (i = 0; i < lim; i++) {
+			rs->disk_state[i] = hmp->raid_failed[i] ?
+			    HAMMER2_RAID6_DISK_FAILED :
+			    HAMMER2_RAID6_DISK_ONLINE;
+			rs->cksum_errors[i] = hmp->raid_cksum_errors[i];
+			rs->cksum_healed[i] = hmp->raid_cksum_healed[i];
+			rs->cksum_unrepairable[i] =
+			    hmp->raid_cksum_unrepairable[i];
+		}
+	}
+	rs->selfheal_writes_done = hmp->repair_writes_done;
