+/*
+ * test_raid6.c — Standalone unit test for HAMMER2 GF(2^8) math and RAID 6
+ *                syndrome generation / recovery.
+ *
+ * Build:  cc -O2 -o test_raid6 test_raid6.c
+ * Run:    ./test_raid6
+ *
+ * This is a userspace test.  It includes the RAID 6 source directly
+ * with a minimal shim to avoid kernel headers.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <string.h>
+#include <assert.h>
+#include <time.h>
+
+/* Shim: hammer2_raid6.c includes "hammer2.h" which is kernel-only.
+ * We provide just enough to satisfy the include.
+ */
+#define _HAMMER2_SHIM_
+#ifndef _HAMMER2_SHIM_DONE_
+#define _HAMMER2_SHIM_DONE_
+
+/* Provide the hammer2.h include as a no-op by defining the guard */
+#define HAMMER2_H_
+
+/* hammer2_raid6.h needs uint8_t and __inline */
+#define __inline inline
+
+#endif /* _HAMMER2_SHIM_DONE_ */
+
+/* Now include the actual RAID 6 implementation directly */
+#include "hammer2_raid6.h"
+
+/* Paste the implementation — we redefine the include of hammer2.h */
+/* Instead of #include "hammer2.h", we already have stdint.h etc */
+
+/* ---- Inline the table definitions and functions from hammer2_raid6.c ---- */
+
+uint8_t hammer2_gf_exp[256];
+uint8_t hammer2_gf_log[256];
+uint8_t hammer2_gf_inv[256];
+uint8_t hammer2_gf_mul_table[256][256];
+
+void
+hammer2_raid6_init(void)
+{
+	int i, j;
+	uint8_t x;
+
+	x = 1;
+	for (i = 0; i < 255; i++) {
+		hammer2_gf_exp[i] = x;
+		hammer2_gf_log[x] = (uint8_t)i;
+		x = hammer2_gf_mul2(x);
+	}
+	hammer2_gf_log[0] = 0;
+	hammer2_gf_exp[255] = hammer2_gf_exp[0];
+
+	hammer2_gf_inv[0] = 0;
+	for (i = 1; i < 256; i++) {
+		hammer2_gf_inv[i] = hammer2_gf_exp[255 - hammer2_gf_log[i]];
+	}
+
+	for (i = 0; i < 256; i++) {
+		hammer2_gf_mul_table[i][0] = 0;
+		hammer2_gf_mul_table[0][i] = 0;
+	}
+	for (i = 1; i < 256; i++) {
+		for (j = 1; j < 256; j++) {
+			int log_sum = (int)hammer2_gf_log[i] +
+				      (int)hammer2_gf_log[j];
+			if (log_sum >= 255)
+				log_sum -= 255;
+			hammer2_gf_mul_table[i][j] =
+				hammer2_gf_exp[log_sum];
+		}
+	}
+}
+
+void
+hammer2_raid6_gen_syndrome(int ndisks, size_t bytes, void **ptrs)
+{
+	int ndata = ndisks - 2;
+	uint8_t *p = ptrs[ndisks - 2];
+	uint8_t *q = ptrs[ndisks - 1];
+	uint8_t *dp;
+	size_t d;
+	int z;
+
+	dp = ptrs[ndata - 1];
+	for (d = 0; d < bytes; d++) {
+		p[d] = dp[d];
+		q[d] = dp[d];
+	}
+
+	for (z = ndata - 2; z >= 0; z--) {
+		dp = ptrs[z];
+		for (d = 0; d < bytes; d++) {
+			p[d] ^= dp[d];
+			q[d] = hammer2_gf_mul2(q[d]) ^ dp[d];
+		}
+	}
+}
+
+void
+hammer2_raid6_2data_recov(int ndisks, size_t bytes,
+			  int faila, int failb, void **ptrs)
+{
+	int ndata = ndisks - 2;
+	uint8_t *p = ptrs[ndisks - 2];
+	uint8_t *q = ptrs[ndisks - 1];
+	uint8_t *dpa, *dpb;
+	uint8_t coeff_a, coeff_b, coeff_diff_inv;
+	size_t d;
+	int z;
+
+	dpa = ptrs[faila];
+	dpb = ptrs[failb];
+
+	coeff_a = hammer2_gf_exp[faila];
+	coeff_b = hammer2_gf_exp[failb];
+	coeff_diff_inv = hammer2_gf_inv[coeff_a ^ coeff_b];
+
+	for (d = 0; d < bytes; d++) {
+		uint8_t Pxy, Qxy, B, A;
+
+		Pxy = p[d];
+		for (z = 0; z < ndata; z++) {
+			if (z != faila && z != failb)
+				Pxy ^= ((uint8_t *)ptrs[z])[d];
+		}
+
+		Qxy = q[d];
+		for (z = 0; z < ndata; z++) {
+			if (z != faila && z != failb)
+				Qxy ^= hammer2_gf_mul(hammer2_gf_exp[z],
+						       ((uint8_t *)ptrs[z])[d]);
+		}
+
+		B = hammer2_gf_mul(hammer2_gf_mul(Pxy, coeff_a) ^ Qxy,
+				   coeff_diff_inv);
+		A = Pxy ^ B;
+
+		dpa[d] = A;
+		dpb[d] = B;
+	}
+}
+
+void
+hammer2_raid6_datap_recov(int ndisks, size_t bytes, int faila, void **ptrs)
+{
+	int ndata = ndisks - 2;
+	uint8_t *p = ptrs[ndisks - 2];
+	uint8_t *q = ptrs[ndisks - 1];
+	uint8_t *dpa;
+	uint8_t coeff_inv;
+	size_t d;
+	int z;
+
+	dpa = ptrs[faila];
+	coeff_inv = hammer2_gf_inv[hammer2_gf_exp[faila]];
+
+	for (d = 0; d < bytes; d++) {
+		uint8_t Qx;
+
+		Qx = q[d];
+		for (z = 0; z < ndata; z++) {
+			if (z != faila)
+				Qx ^= hammer2_gf_mul(hammer2_gf_exp[z],
+						      ((uint8_t *)ptrs[z])[d]);
+		}
+
+		dpa[d] = hammer2_gf_mul(Qx, coeff_inv);
+	}
+
+	for (d = 0; d < bytes; d++) {
+		uint8_t pv = 0;
+		for (z = 0; z < ndata; z++)
+			pv ^= ((uint8_t *)ptrs[z])[d];
+		p[d] = pv;
+	}
+}
+
+void
+hammer2_raid6_dual_recov(int ndisks, size_t bytes,
+			 int faila, int failb, void **ptrs)
+{
+	int ndata = ndisks - 2;
+
+	if (faila >= ndata) {
+		hammer2_raid6_gen_syndrome(ndisks, bytes, ptrs);
+	} else if (failb >= ndata) {
+		if (failb == ndisks - 1) {
+			uint8_t *p = ptrs[ndisks - 2];
+			uint8_t *dpa = ptrs[faila];
+			size_t d;
+			int z;
+
+			for (d = 0; d < bytes; d++) {
+				uint8_t val = p[d];
+				for (z = 0; z < ndata; z++) {
+					if (z != faila)
+						val ^= ((uint8_t *)ptrs[z])[d];
+				}
+				dpa[d] = val;
+			}
+			hammer2_raid6_gen_syndrome(ndisks, bytes, ptrs);
+		} else {
+			hammer2_raid6_datap_recov(ndisks, bytes, faila, ptrs);
+		}
+	} else {
+		hammer2_raid6_2data_recov(ndisks, bytes, faila, failb, ptrs);
+	}
+}
+
+/* ===== Test infrastructure ===== */
+
+static int tests_run = 0;
+static int tests_passed = 0;
+static int tests_failed = 0;
+
+#define TEST_BLOCK_SIZE	4096	/* test with 4KB blocks */
+
+#define CHECK(cond, fmt, ...) do {					\
+	tests_run++;							\
+	if (!(cond)) {							\
+		printf("FAIL: " fmt "\n", ##__VA_ARGS__);		\
+		tests_failed++;						\
+	} else {							\
+		tests_passed++;						\
+	}								\
+} while (0)
+
+/*
+ * Fill buffer with pseudo-random data seeded by disk index + stripe.
+ */
+static void
+fill_random(uint8_t *buf, size_t len, unsigned int seed)
+{
+	unsigned int state = seed ^ 0xdeadbeef;
+	size_t i;
+
+	for (i = 0; i < len; i++) {
+		state = state * 1103515245 + 12345;
+		buf[i] = (uint8_t)(state >> 16);
+	}
+}
+
+/* ===== Test 1: GF(2^8) field properties ===== */
+static void
+test_gf_field_properties(void)
+{
+	int a, b, c;
+
+	printf("  Test 1: GF(2^8) field properties\n");
+
+	/* Identity: a * 1 = a */
+	for (a = 0; a < 256; a++) {
+		CHECK(hammer2_gf_mul(a, 1) == a,
+		    "mul identity: %d * 1 = %d (expected %d)",
+		    a, hammer2_gf_mul(a, 1), a);
+	}
+
+	/* Zero: a * 0 = 0 */
+	for (a = 0; a < 256; a++) {
+		CHECK(hammer2_gf_mul(a, 0) == 0,
+		    "mul zero: %d * 0 = %d",
+		    a, hammer2_gf_mul(a, 0));
+	}
+
+	/* Commutativity: a * b = b * a */
+	for (a = 0; a < 256; a++) {
+		for (b = 0; b < 256; b++) {
+			CHECK(hammer2_gf_mul(a, b) == hammer2_gf_mul(b, a),
+			    "commutativity: %d*%d=%d, %d*%d=%d",
+			    a, b, hammer2_gf_mul(a, b),
+			    b, a, hammer2_gf_mul(b, a));
+		}
+	}
+
+	/* Inverse: a * inv(a) = 1 for all a != 0 */
+	for (a = 1; a < 256; a++) {
+		uint8_t inv = hammer2_gf_inv[a];
+		CHECK(hammer2_gf_mul(a, inv) == 1,
+		    "inverse: %d * inv(%d)=%d = %d (expected 1)",
+		    a, a, inv, hammer2_gf_mul(a, inv));
+	}
+
+	/* Division: (a * b) / b = a for all b != 0 */
+	for (a = 0; a < 256; a++) {
+		for (b = 1; b < 256; b++) {
+			uint8_t prod = hammer2_gf_mul(a, b);
+			CHECK(hammer2_gf_div(prod, b) == a,
+			    "division: (%d*%d)/%d = %d (expected %d)",
+			    a, b, b, hammer2_gf_div(prod, b), a);
+		}
+	}
+
+	/* mul2 consistency: mul2(a) = mul_table[a][2] */
+	for (a = 0; a < 256; a++) {
+		CHECK(hammer2_gf_mul2(a) == hammer2_gf_mul(a, 2),
+		    "mul2 consistency: mul2(%d)=%d, table=%d",
+		    a, hammer2_gf_mul2(a), hammer2_gf_mul(a, 2));
+	}
+
+	/* Associativity (spot check): (a*b)*c = a*(b*c) */
+	for (a = 0; a < 256; a += 17) {
+		for (b = 0; b < 256; b += 19) {
+			for (c = 0; c < 256; c += 23) {
+				uint8_t ab_c = hammer2_gf_mul(
+				    hammer2_gf_mul(a, b), c);
+				uint8_t a_bc = hammer2_gf_mul(
+				    a, hammer2_gf_mul(b, c));
+				CHECK(ab_c == a_bc,
+				    "assoc: (%d*%d)*%d=%d, %d*(%d*%d)=%d",
+				    a, b, c, ab_c, a, b, c, a_bc);
+			}
+		}
+	}
+
+	/* Exp/log consistency: exp[log[a]] = a for a != 0 */
+	for (a = 1; a < 256; a++) {
+		CHECK(hammer2_gf_exp[hammer2_gf_log[a]] == a,
+		    "exp/log: exp[log[%d]] = %d",
+		    a, hammer2_gf_exp[hammer2_gf_log[a]]);
+	}
+
+	/* Power: gf_pow(2, i) = gf_exp[i] for i < 255 */
+	for (a = 0; a < 255; a++) {
+		CHECK(hammer2_gf_pow(2, a) == hammer2_gf_exp[a],
+		    "pow: pow(2,%d)=%d, exp[%d]=%d",
+		    a, hammer2_gf_pow(2, a), a, hammer2_gf_exp[a]);
+	}
+
+	/* Generator order: 2^255 = 1 (wraps) */
+	{
+		uint8_t x = 1;
+		int i;
+		for (i = 0; i < 255; i++)
+			x = hammer2_gf_mul2(x);
+		CHECK(x == 1, "generator order: 2^255 = %d (expected 1)", x);
+	}
+
+	printf("    Field properties: %d tests\n", tests_run);
+}
+
+/* ===== Test 2: Syndrome generation ===== */
+static void
+test_syndrome_generation(void)
+{
+	int ndisks, ndata;
+	int prev = tests_run;
+
+	printf("  Test 2: Syndrome generation\n");
+
+	/*
+	 * Test with 4..8 total disks.
+	 * Verify P = XOR of all data, Q matches manual computation.
+	 */
+	for (ndisks = 4; ndisks <= 8; ndisks++) {
+		uint8_t *bufs[8];
+		void *ptrs[8];
+		uint8_t *p_verify, *q_verify;
+		size_t d;
+		int i, z;
+
+		ndata = ndisks - 2;
+
+		/* Allocate and fill data disks */
+		for (i = 0; i < ndisks; i++) {
+			bufs[i] = malloc(TEST_BLOCK_SIZE);
+			ptrs[i] = bufs[i];
+		}
+		for (i = 0; i < ndata; i++)
+			fill_random(bufs[i], TEST_BLOCK_SIZE, i * 1000 + ndisks);
+		/* P and Q will be computed */
+		memset(bufs[ndisks - 2], 0, TEST_BLOCK_SIZE);
+		memset(bufs[ndisks - 1], 0, TEST_BLOCK_SIZE);
+
+		/* Generate syndromes */
+		hammer2_raid6_gen_syndrome(ndisks, TEST_BLOCK_SIZE, ptrs);
+
+		/* Verify P = XOR of all data disks */
+		p_verify = calloc(1, TEST_BLOCK_SIZE);
+		for (i = 0; i < ndata; i++) {
+			for (d = 0; d < TEST_BLOCK_SIZE; d++)
+				p_verify[d] ^= bufs[i][d];
+		}
+		CHECK(memcmp(bufs[ndisks - 2], p_verify, TEST_BLOCK_SIZE) == 0,
+		    "P parity mismatch for ndisks=%d", ndisks);
+
+		/* Verify Q = sum(data[i] * 2^i) */
+		q_verify = calloc(1, TEST_BLOCK_SIZE);
+		for (i = 0; i < ndata; i++) {
+			for (d = 0; d < TEST_BLOCK_SIZE; d++) {
+				q_verify[d] ^= hammer2_gf_mul(
+				    hammer2_gf_exp[i], bufs[i][d]);
+			}
+		}
+		CHECK(memcmp(bufs[ndisks - 1], q_verify, TEST_BLOCK_SIZE) == 0,
+		    "Q parity mismatch for ndisks=%d", ndisks);
+
+		free(p_verify);
+		free(q_verify);
+		for (i = 0; i < ndisks; i++)
+			free(bufs[i]);
+	}
+
+	printf("    Syndrome generation: %d tests\n", tests_run - prev);
+}
+
+/* ===== Test 3: Two data disk recovery ===== */
+static void
+test_2data_recovery(void)
+{
+	int ndisks, ndata;
+	int prev = tests_run;
+
+	printf("  Test 3: Two data disk recovery (all combinations)\n");
+
+	for (ndisks = 4; ndisks <= 8; ndisks++) {
+		uint8_t *orig[8];
+		uint8_t *bufs[8];
+		void *ptrs[8];
+		int i, fa, fb;
+
+		ndata = ndisks - 2;
+
+		/* Allocate original data and working copies */
+		for (i = 0; i < ndisks; i++) {
+			orig[i] = malloc(TEST_BLOCK_SIZE);
+			bufs[i] = malloc(TEST_BLOCK_SIZE);
+			ptrs[i] = bufs[i];
+		}
+		for (i = 0; i < ndata; i++)
+			fill_random(orig[i], TEST_BLOCK_SIZE, i * 7 + ndisks * 13);
+
+		/* Generate reference P and Q */
+		for (i = 0; i < ndisks; i++)
+			memcpy(bufs[i], orig[i], TEST_BLOCK_SIZE);
+		hammer2_raid6_gen_syndrome(ndisks, TEST_BLOCK_SIZE, ptrs);
+		/* Save computed P and Q as original */
+		memcpy(orig[ndisks - 2], bufs[ndisks - 2], TEST_BLOCK_SIZE);
+		memcpy(orig[ndisks - 1], bufs[ndisks - 1], TEST_BLOCK_SIZE);
+
+		/* Test every pair of data disk failures */
+		for (fa = 0; fa < ndata; fa++) {
+			for (fb = fa + 1; fb < ndata; fb++) {
+				/* Restore all disks */
+				for (i = 0; i < ndisks; i++)
+					memcpy(bufs[i], orig[i], TEST_BLOCK_SIZE);
+
+				/* Zero out failed disks */
+				memset(bufs[fa], 0, TEST_BLOCK_SIZE);
+				memset(bufs[fb], 0, TEST_BLOCK_SIZE);
+
+				/* Recover */
+				hammer2_raid6_dual_recov(ndisks, TEST_BLOCK_SIZE,
+				    fa, fb, ptrs);
+
+				CHECK(memcmp(bufs[fa], orig[fa], TEST_BLOCK_SIZE) == 0,
+				    "2data recovery disk %d failed (ndisks=%d, fail=%d,%d)",
+				    fa, ndisks, fa, fb);
+				CHECK(memcmp(bufs[fb], orig[fb], TEST_BLOCK_SIZE) == 0,
+				    "2data recovery disk %d failed (ndisks=%d, fail=%d,%d)",
+				    fb, ndisks, fa, fb);
+			}
+		}
+
+		for (i = 0; i < ndisks; i++) {
+			free(orig[i]);
+			free(bufs[i]);
+		}
+	}
+
+	printf("    2-data recovery: %d tests\n", tests_run - prev);
+}
+
+/* ===== Test 4: Data + P recovery ===== */
+static void
+test_datap_recovery(void)
+{
+	int ndisks, ndata;
+	int prev = tests_run;
+
+	printf("  Test 4: Data + P parity recovery\n");
+
+	for (ndisks = 4; ndisks <= 8; ndisks++) {
+		uint8_t *orig[8];
+		uint8_t *bufs[8];
+		void *ptrs[8];
+		int i, fa;
+
+		ndata = ndisks - 2;
+
+		for (i = 0; i < ndisks; i++) {
+			orig[i] = malloc(TEST_BLOCK_SIZE);
+			bufs[i] = malloc(TEST_BLOCK_SIZE);
+			ptrs[i] = bufs[i];
+		}
+		for (i = 0; i < ndata; i++)
+			fill_random(orig[i], TEST_BLOCK_SIZE, i * 31 + ndisks * 97);
+
+		for (i = 0; i < ndisks; i++)
+			memcpy(bufs[i], orig[i], TEST_BLOCK_SIZE);
+		hammer2_raid6_gen_syndrome(ndisks, TEST_BLOCK_SIZE, ptrs);
+		memcpy(orig[ndisks - 2], bufs[ndisks - 2], TEST_BLOCK_SIZE);
+		memcpy(orig[ndisks - 1], bufs[ndisks - 1], TEST_BLOCK_SIZE);
+
+		/* Fail each data disk + P */
+		for (fa = 0; fa < ndata; fa++) {
+			int p_idx = ndisks - 2;
+
+			for (i = 0; i < ndisks; i++)
+				memcpy(bufs[i], orig[i], TEST_BLOCK_SIZE);
+
+			memset(bufs[fa], 0, TEST_BLOCK_SIZE);
+			memset(bufs[p_idx], 0, TEST_BLOCK_SIZE);
+
+			hammer2_raid6_dual_recov(ndisks, TEST_BLOCK_SIZE,
+			    fa, p_idx, ptrs);
+
+			CHECK(memcmp(bufs[fa], orig[fa], TEST_BLOCK_SIZE) == 0,
+			    "data+P recovery disk %d failed (ndisks=%d)",
+			    fa, ndisks);
+			CHECK(memcmp(bufs[p_idx], orig[p_idx], TEST_BLOCK_SIZE) == 0,
+			    "data+P recovery P failed (ndisks=%d, data fail=%d)",
+			    ndisks, fa);
+		}
+
+		for (i = 0; i < ndisks; i++) {
+			free(orig[i]);
+			free(bufs[i]);
+		}
+	}
+
+	printf("    Data+P recovery: %d tests\n", tests_run - prev);
+}
+
+/* ===== Test 5: Data + Q recovery ===== */
+static void
+test_dataq_recovery(void)
+{
+	int ndisks, ndata;
+	int prev = tests_run;
+
+	printf("  Test 5: Data + Q parity recovery\n");
+
+	for (ndisks = 4; ndisks <= 8; ndisks++) {
+		uint8_t *orig[8];
+		uint8_t *bufs[8];
+		void *ptrs[8];
+		int i, fa;
+
+		ndata = ndisks - 2;
+
+		for (i = 0; i < ndisks; i++) {
+			orig[i] = malloc(TEST_BLOCK_SIZE);
+			bufs[i] = malloc(TEST_BLOCK_SIZE);
+			ptrs[i] = bufs[i];
+		}
+		for (i = 0; i < ndata; i++)
+			fill_random(orig[i], TEST_BLOCK_SIZE, i * 41 + ndisks * 53);
+
+		for (i = 0; i < ndisks; i++)
+			memcpy(bufs[i], orig[i], TEST_BLOCK_SIZE);
+		hammer2_raid6_gen_syndrome(ndisks, TEST_BLOCK_SIZE, ptrs);
+		memcpy(orig[ndisks - 2], bufs[ndisks - 2], TEST_BLOCK_SIZE);
+		memcpy(orig[ndisks - 1], bufs[ndisks - 1], TEST_BLOCK_SIZE);
+
+		/* Fail each data disk + Q */
+		for (fa = 0; fa < ndata; fa++) {
+			int q_idx = ndisks - 1;
+
+			for (i = 0; i < ndisks; i++)
+				memcpy(bufs[i], orig[i], TEST_BLOCK_SIZE);
+
+			memset(bufs[fa], 0, TEST_BLOCK_SIZE);
+			memset(bufs[q_idx], 0, TEST_BLOCK_SIZE);
+
+			hammer2_raid6_dual_recov(ndisks, TEST_BLOCK_SIZE,
+			    fa, q_idx, ptrs);
+
+			CHECK(memcmp(bufs[fa], orig[fa], TEST_BLOCK_SIZE) == 0,
+			    "data+Q recovery disk %d failed (ndisks=%d)",
+			    fa, ndisks);
+			CHECK(memcmp(bufs[q_idx], orig[q_idx], TEST_BLOCK_SIZE) == 0,
+			    "data+Q recovery Q failed (ndisks=%d, data fail=%d)",
+			    ndisks, fa);
+		}
+
+		for (i = 0; i < ndisks; i++) {
+			free(orig[i]);
+			free(bufs[i]);
+		}
+	}
+
+	printf("    Data+Q recovery: %d tests\n", tests_run - prev);
+}
+
+/* ===== Test 6: P + Q recovery (both parity) ===== */
+static void
+test_pq_recovery(void)
+{
+	int ndisks, ndata;
+	int prev = tests_run;
+
+	printf("  Test 6: P + Q parity recovery (regenerate)\n");
+
+	for (ndisks = 4; ndisks <= 8; ndisks++) {
+		uint8_t *orig[8];
+		uint8_t *bufs[8];
+		void *ptrs[8];
+		int i;
+
+		ndata = ndisks - 2;
+
+		for (i = 0; i < ndisks; i++) {
+			orig[i] = malloc(TEST_BLOCK_SIZE);
+			bufs[i] = malloc(TEST_BLOCK_SIZE);
+			ptrs[i] = bufs[i];
+		}
+		for (i = 0; i < ndata; i++)
+			fill_random(orig[i], TEST_BLOCK_SIZE, i * 61 + ndisks * 71);
+
+		for (i = 0; i < ndisks; i++)
+			memcpy(bufs[i], orig[i], TEST_BLOCK_SIZE);
+		hammer2_raid6_gen_syndrome(ndisks, TEST_BLOCK_SIZE, ptrs);
+		memcpy(orig[ndisks - 2], bufs[ndisks - 2], TEST_BLOCK_SIZE);
+		memcpy(orig[ndisks - 1], bufs[ndisks - 1], TEST_BLOCK_SIZE);
+
+		/* Zero out both P and Q */
+		memset(bufs[ndisks - 2], 0, TEST_BLOCK_SIZE);
+		memset(bufs[ndisks - 1], 0, TEST_BLOCK_SIZE);
+
+		hammer2_raid6_dual_recov(ndisks, TEST_BLOCK_SIZE,
+		    ndisks - 2, ndisks - 1, ptrs);
+
+		CHECK(memcmp(bufs[ndisks - 2], orig[ndisks - 2], TEST_BLOCK_SIZE) == 0,
+		    "P+Q recovery P failed (ndisks=%d)", ndisks);
+		CHECK(memcmp(bufs[ndisks - 1], orig[ndisks - 1], TEST_BLOCK_SIZE) == 0,
+		    "P+Q recovery Q failed (ndisks=%d)", ndisks);
+
+		for (i = 0; i < ndisks; i++) {
+			free(orig[i]);
+			free(bufs[i]);
+		}
+	}
+
+	printf("    P+Q recovery: %d tests\n", tests_run - prev);
+}
+
+/* ===== Test 7: Edge cases ===== */
+static void
+test_edge_cases(void)
+{
+	int prev = tests_run;
+
+	printf("  Test 7: Edge cases\n");
+
+	/* All-zero data */
+	{
+		int ndisks = 4;
+		uint8_t *bufs[4];
+		void *ptrs[4];
+		int i;
+
+		for (i = 0; i < ndisks; i++) {
+			bufs[i] = calloc(1, TEST_BLOCK_SIZE);
+			ptrs[i] = bufs[i];
+		}
+
+		hammer2_raid6_gen_syndrome(ndisks, TEST_BLOCK_SIZE, ptrs);
+
+		/* P and Q of all-zero data should be all zeros */
+		{
+			uint8_t *zero = calloc(1, TEST_BLOCK_SIZE);
+			CHECK(memcmp(bufs[2], zero, TEST_BLOCK_SIZE) == 0,
+			    "all-zero data: P not zero");
+			CHECK(memcmp(bufs[3], zero, TEST_BLOCK_SIZE) == 0,
+			    "all-zero data: Q not zero");
+			free(zero);
+		}
+
+		for (i = 0; i < ndisks; i++)
+			free(bufs[i]);
+	}
+
+	/* All-0xFF data */
+	{
+		int ndisks = 4;
+		uint8_t *bufs[4];
+		void *ptrs[4];
+		uint8_t *orig_p, *orig_q;
+		int i;
+
+		for (i = 0; i < ndisks; i++) {
+			bufs[i] = malloc(TEST_BLOCK_SIZE);
+			ptrs[i] = bufs[i];
+		}
+		memset(bufs[0], 0xFF, TEST_BLOCK_SIZE);
+		memset(bufs[1], 0xFF, TEST_BLOCK_SIZE);
+
+		hammer2_raid6_gen_syndrome(ndisks, TEST_BLOCK_SIZE, ptrs);
+
+		/* P = 0xFF ^ 0xFF = 0x00 for 2 data disks */
+		{
+			size_t d;
+			int p_ok = 1;
+			for (d = 0; d < TEST_BLOCK_SIZE; d++) {
+				if (bufs[2][d] != 0x00) {
+					p_ok = 0;
+					break;
+				}
+			}
+			CHECK(p_ok, "all-0xFF P should be 0x00 for 2 data disks");
+		}
+
+		/* Save P, Q, then test recovery */
+		orig_p = malloc(TEST_BLOCK_SIZE);
+		orig_q = malloc(TEST_BLOCK_SIZE);
+		memcpy(orig_p, bufs[2], TEST_BLOCK_SIZE);
+		memcpy(orig_q, bufs[3], TEST_BLOCK_SIZE);
+
+		/* Fail both data disks */
+		memset(bufs[0], 0, TEST_BLOCK_SIZE);
+		memset(bufs[1], 0, TEST_BLOCK_SIZE);
+		hammer2_raid6_dual_recov(ndisks, TEST_BLOCK_SIZE, 0, 1, ptrs);
+		{
+			uint8_t *ff = malloc(TEST_BLOCK_SIZE);
+			memset(ff, 0xFF, TEST_BLOCK_SIZE);
+			CHECK(memcmp(bufs[0], ff, TEST_BLOCK_SIZE) == 0,
+			    "all-0xFF recovery disk 0");
+			CHECK(memcmp(bufs[1], ff, TEST_BLOCK_SIZE) == 0,
+			    "all-0xFF recovery disk 1");
+			free(ff);
+		}
+
+		free(orig_p);
+		free(orig_q);
+		for (i = 0; i < ndisks; i++)
+			free(bufs[i]);
+	}
+
+	/* Single byte blocks */
+	{
+		int ndisks = 4;
+		uint8_t d0 = 0x42, d1 = 0x99;
+		uint8_t p, q;
+		uint8_t *bufs[4];
+		void *ptrs[4];
+		uint8_t orig0, orig1;
+
+		bufs[0] = &d0;
+		bufs[1] = &d1;
+		bufs[2] = &p;
+		bufs[3] = &q;
+		ptrs[0] = bufs[0]; ptrs[1] = bufs[1];
+		ptrs[2] = bufs[2]; ptrs[3] = bufs[3];
+
+		hammer2_raid6_gen_syndrome(4, 1, ptrs);
+
+		CHECK(p == (d0 ^ d1),
+		    "single byte P: got 0x%02x expected 0x%02x",
+		    p, d0 ^ d1);
+
+		/* Q = d0 * 2^0 ^ d1 * 2^1 = d0 ^ mul2(d1) */
+		CHECK(q == (d0 ^ hammer2_gf_mul2(d1)),
+		    "single byte Q: got 0x%02x expected 0x%02x",
+		    q, d0 ^ hammer2_gf_mul2(d1));
+
+		/* Recover from 2 data failures on single byte */
+		orig0 = d0;
+		orig1 = d1;
+		d0 = 0;
+		d1 = 0;
+		hammer2_raid6_dual_recov(4, 1, 0, 1, ptrs);
+		CHECK(d0 == orig0, "single byte recovery d0: got 0x%02x expected 0x%02x",
+		    d0, orig0);
+		CHECK(d1 == orig1, "single byte recovery d1: got 0x%02x expected 0x%02x",
+		    d1, orig1);
+	}
+
+	printf("    Edge cases: %d tests\n", tests_run - prev);
+}
+
+/* ===== Test 8: Large array (max disks) ===== */
+static void
+test_large_array(void)
+{
+	int ndisks = 16;	/* 14 data + 2 parity */
+	int ndata = ndisks - 2;
+	uint8_t *orig[16];
+	uint8_t *bufs[16];
+	void *ptrs[16];
+	int prev = tests_run;
+	int i, fa, fb;
+
+	printf("  Test 8: Large array (%d disks, all 2-failure combos)\n", ndisks);
+
+	for (i = 0; i < ndisks; i++) {
+		orig[i] = malloc(TEST_BLOCK_SIZE);
+		bufs[i] = malloc(TEST_BLOCK_SIZE);
+		ptrs[i] = bufs[i];
+	}
+	for (i = 0; i < ndata; i++)
+		fill_random(orig[i], TEST_BLOCK_SIZE, i * 137 + 42);
+
+	for (i = 0; i < ndisks; i++)
+		memcpy(bufs[i], orig[i], TEST_BLOCK_SIZE);
+	hammer2_raid6_gen_syndrome(ndisks, TEST_BLOCK_SIZE, ptrs);
+	memcpy(orig[ndisks - 2], bufs[ndisks - 2], TEST_BLOCK_SIZE);
+	memcpy(orig[ndisks - 1], bufs[ndisks - 1], TEST_BLOCK_SIZE);
+
+	/* Test all C(16,2) = 120 failure pairs */
+	for (fa = 0; fa < ndisks; fa++) {
+		for (fb = fa + 1; fb < ndisks; fb++) {
+			for (i = 0; i < ndisks; i++)
+				memcpy(bufs[i], orig[i], TEST_BLOCK_SIZE);
+
+			memset(bufs[fa], 0, TEST_BLOCK_SIZE);
+			memset(bufs[fb], 0, TEST_BLOCK_SIZE);
+
+			hammer2_raid6_dual_recov(ndisks, TEST_BLOCK_SIZE,
+			    fa, fb, ptrs);
+
+			CHECK(memcmp(bufs[fa], orig[fa], TEST_BLOCK_SIZE) == 0,
+			    "large array recovery disk %d (fail %d,%d)",
+			    fa, fa, fb);
+			CHECK(memcmp(bufs[fb], orig[fb], TEST_BLOCK_SIZE) == 0,
+			    "large array recovery disk %d (fail %d,%d)",
+			    fb, fa, fb);
+		}
+	}
+
+	for (i = 0; i < ndisks; i++) {
+		free(orig[i]);
+		free(bufs[i]);
+	}
+
+	printf("    Large array: %d tests (%d failure combinations)\n",
+	    tests_run - prev, ndisks * (ndisks - 1) / 2);
+}
+
+/* ===== Main ===== */
+int
+main(int argc, char **argv)
+{
+	clock_t start, end;
+
+	printf("HAMMER2 RAID 6 GF(2^8) Unit Tests\n");
+	printf("==================================\n\n");
+
+	printf("Initializing GF(2^8) tables...\n");
+	start = clock();
+	hammer2_raid6_init();
+	end = clock();
+	printf("  Table init: %.3f ms\n\n",
+	    (double)(end - start) / CLOCKS_PER_SEC * 1000.0);
+
+	printf("Running tests (block size = %d bytes):\n\n", TEST_BLOCK_SIZE);
+
+	test_gf_field_properties();
+	printf("\n");
+	test_syndrome_generation();
+	printf("\n");
+	test_2data_recovery();
+	printf("\n");
+	test_datap_recovery();
+	printf("\n");
+	test_dataq_recovery();
+	printf("\n");
+	test_pq_recovery();
+	printf("\n");
+	test_edge_cases();
+	printf("\n");
+	test_large_array();
+
+	printf("\n==================================\n");
+	printf("Results: %d passed, %d failed, %d total\n",
+	    tests_passed, tests_failed, tests_run);
+
+	if (tests_failed > 0) {
+		printf("SOME TESTS FAILED\n");
+		return 1;
+	}
+	printf("ALL TESTS PASSED\n");
+	return 0;
+}
