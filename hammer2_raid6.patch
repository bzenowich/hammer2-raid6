+			      curthread->td_ucred, NULL) == 0 && cap == 0) {
+			kprintf("hammer2: WARNING: %s cannot flush its write "
+				"cache\n", e->path);
+			++bad;
+		}
+	}
+	if (bad) {
+		kprintf("hammer2: WARNING: %d device(s) drop cache flushes; "
+			"a power loss can lose or corrupt recently written "
+			"data on them\n", bad);
+	}
