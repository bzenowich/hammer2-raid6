+ * allocator reuse a slot that still has live cols.
+ */
+/*
+ * The space map slot of a v3 DATA/DIRENT blockref.  Returns 0 for any
+ * other blockref.
+ */
+static int
+hammer2_raid6_bref_slot(hammer2_dev_t *hmp, const hammer2_blockref_t *bref,
+			uint64_t *slotp)
+{
+	hammer2_off_t phys_off;
+	uint64_t slot;
+
+	if (bref->type != HAMMER2_BREF_TYPE_DATA &&
+	    bref->type != HAMMER2_BREF_TYPE_DIRENT)
+		return 0;
+	phys_off = bref->data_off & ~HAMMER2_OFF_MASK_RADIX;
+	if (phys_off < HAMMER2_ZONE_SEG64)
+		return 0;
+	slot = hammer2_raid6_slot(phys_off, hmp->raid_config.stripe_unit);
+	if (slot >= hmp->stripe_num_slots)
+		return 0;
+	*slotp = slot;
+	return 1;
+}
+
+static int
+hammer2_raid6_record_bref(hammer2_dev_t *hmp, const hammer2_blockref_t *bref)
+{
+	uint64_t slot;
+
+	if (!hammer2_raid6_bref_slot(hmp, bref, &slot))
+		return 0;
+
+	hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+	hmp->stripe_bitmap[slot / 8] |= (uint8_t)(1 << (slot % 8));
+	if (slot >= hmp->stripe_cursor)
+		hmp->stripe_cursor = slot + 1;
+	hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+	return 0;
+}
+
+static int
+hammer2_raid6_walk_chain(hammer2_dev_t *hmp, hammer2_chain_t *parent)
+{
+	hammer2_chain_t *chain = NULL;
+	hammer2_blockref_t bref;
+	int first = 1;
+	int error;
+
+	for (;;) {
+		error = hammer2_chain_scan(parent, &chain, &bref, &first,
+					   HAMMER2_LOOKUP_ALWAYS);
+		if (error & HAMMER2_ERROR_EOF) {
+			error = 0;
+			break;
+		}
+		if (error)
+			break;
+
+		(void)hammer2_raid6_record_bref(hmp, &bref);
+
+		if (chain) {
+			error = hammer2_raid6_walk_chain(hmp, chain);
+			if (error)
+				break;
+		}
+	}
+	if (chain) {
+		hammer2_chain_unlock(chain);
+		hammer2_chain_drop(chain);
+	}
+	return error;
+}
+
+int
+hammer2_raid6_rebuild_stripe_bitmap(hammer2_dev_t *hmp)
+{
+	int error;
+
+	KKASSERT(hammer2_raid6_v3(hmp));
+	KKASSERT(hmp->stripe_bitmap != NULL);
+
+	bzero(hmp->stripe_bitmap, hmp->stripe_bitmap_size);
+	hmp->stripe_cursor = 0;
+
+	hammer2_chain_lock(&hmp->vchain, HAMMER2_RESOLVE_ALWAYS);
+	error = hammer2_raid6_walk_chain(hmp, &hmp->vchain);
+	hammer2_chain_unlock(&hmp->vchain);
+	hammer2_raid6_sm_dirty_all(hmp);
+	return error;
+}
+
+/*
+ * Check the stripe layout recorded in the volume header and allocate
+ * the in-memory space map.  Returns EINVAL for a v3 volume made before
+ * the layout (docs/capacity.md); it has to be re-made.
+ */
+int
+hammer2_raid6_sm_init(hammer2_dev_t *hmp)
+{
+	hammer2_raid_config_t *rc = &hmp->raid_config;
+	uint64_t nslots = rc->rz_num_slots;
+	uint64_t npages;
+	uint64_t slot;
+
+	if (rc->rz_layout < HAMMER2_RZ_LAYOUT_MIN ||
+	    rc->rz_layout > HAMMER2_RZ_LAYOUT) {
+		kprintf("hammer2: RAID6 v3 volume has stripe layout %u, "
+			"this kernel handles %u..%u; re-run newfs_hammer2 "
+			"or use a newer kernel\n",
+			rc->rz_layout, HAMMER2_RZ_LAYOUT_MIN,
+			HAMMER2_RZ_LAYOUT);
+		return EINVAL;
+	}
+	npages = (nslots + HAMMER2_SM_PAGE_SLOTS - 1) / HAMMER2_SM_PAGE_SLOTS;
+	if (nslots == 0 || npages != rc->rz_sm_pages ||
+	    npages > HAMMER2_SM_MAX_PAGES ||
+	    rc->rz_sm_copy != (npages + 1) * HAMMER2_SM_PAGE ||
+	    hmp->md_nextents == 0) {
+		kprintf("hammer2: RAID6 v3 space map geometry invalid "
+			"(slots %ju pages %u copy %ju extents %u)\n",
+			(uintmax_t)nslots, rc->rz_sm_pages,
+			(uintmax_t)rc->rz_sm_copy, hmp->md_nextents);
+		return EINVAL;
+	}
+
+	hmp->stripe_num_slots = nslots;
+	hmp->sm_npages = (uint32_t)npages;
+	hmp->stripe_bitmap_size = (size_t)((nslots + 7) / 8);
+	/*
+	 * The allocator scans the bitmap and the data mask 64 bits at a
+	 * time: round the allocation up so the last word is readable.
+	 */
+	hmp->stripe_bitmap = kmalloc(roundup2(hmp->stripe_bitmap_size, 8),
+				     M_HAMMER2, M_WAITOK | M_ZERO);
+	hmp->stripe_data_mask = kmalloc(roundup2(hmp->stripe_bitmap_size, 8),
+					M_HAMMER2, M_WAITOK | M_ZERO);
+	hmp->stripe_data_slots = 0;
+	for (slot = 0; slot < nslots; slot++) {
+		if (hammer2_raid6_slot_is_data(hmp, slot)) {
+			setbit(hmp->stripe_data_mask, slot);
+			++hmp->stripe_data_slots;
+		}
+	}
+	hmp->sm_dirty = kmalloc((size_t)npages, M_HAMMER2, M_WAITOK | M_ZERO);
+	hmp->sm_crc[0] = kmalloc((size_t)npages * sizeof(uint32_t),
+				 M_HAMMER2, M_WAITOK | M_ZERO);
+	hmp->sm_crc[1] = kmalloc((size_t)npages * sizeof(uint32_t),
+				 M_HAMMER2, M_WAITOK | M_ZERO);
+	hmp->stripe_bf_seen = kmalloc((size_t)nslots, M_HAMMER2,
+				      M_WAITOK | M_ZERO);
+	hmp->stripe_bf_new = kmalloc(hmp->stripe_bitmap_size, M_HAMMER2,
+				     M_WAITOK | M_ZERO);
+	hmp->stripe_bf_staged = kmalloc(hmp->stripe_bitmap_size, M_HAMMER2,
+					M_WAITOK | M_ZERO);
+	hmp->stripe_open = kmalloc(hmp->stripe_bitmap_size, M_HAMMER2,
+				   M_WAITOK | M_ZERO);
+	hmp->stripe_bf_active = 0;
+	hmp->stripe_bf_complete = 0;
+	hmp->stripe_cursor = 0;
+	hmp->stripe_generation = hmp->voldata.raid_config.rz_sm_gen;
+	hmp->rb_wgen = hmp->voldata.raid_config.rz_rb_wgen;
+	hmp->stripe_bitmap_invalid = 0;
+	spin_init(&hmp->stripe_bitmap_spin, "h2smap");
+	hmp->stripe_next_disk = 0;
+	return 0;
+}
+
+void
+hammer2_raid6_sm_destroy(hammer2_dev_t *hmp)
+{
+	uint8_t **bfp[] = { &hmp->stripe_bf_seen, &hmp->stripe_bf_new,
+			    &hmp->stripe_bf_staged, &hmp->stripe_open };
+	int c;
+
+	for (c = 0; c < 4; c++) {
+		if (*bfp[c]) {
+			kfree(*bfp[c], M_HAMMER2);
+			*bfp[c] = NULL;
+		}
+	}
+	if (hmp->stripe_bitmap) {
+		kfree(hmp->stripe_bitmap, M_HAMMER2);
+		hmp->stripe_bitmap = NULL;
+	}
+	if (hmp->stripe_data_mask) {
+		kfree(hmp->stripe_data_mask, M_HAMMER2);
+		hmp->stripe_data_mask = NULL;
+	}
+	if (hmp->sm_dirty) {
+		kfree(hmp->sm_dirty, M_HAMMER2);
+		hmp->sm_dirty = NULL;
+	}
+	for (c = 0; c < 2; c++) {
+		if (hmp->sm_crc[c]) {
+			kfree(hmp->sm_crc[c], M_HAMMER2);
+			hmp->sm_crc[c] = NULL;
+		}
+	}
+}
+
+/*
+ * Make the next two flushes write both copies whole: after a walk
+ * rebuild, and when a disk comes back whose copies are stale.
+ */
+void
+hammer2_raid6_sm_dirty_all(hammer2_dev_t *hmp)
+{
+	if (hmp->sm_dirty == NULL)
+		return;
+	hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+	memset(hmp->sm_dirty, 3, hmp->sm_npages);
+	hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+}
+
+/*
+ * Return the device for disk i when it can hold a current space map
+ * copy: present, open and not failed.  A failed disk stops receiving
+ * copies, so its copies are stale and must not be loaded.
+ */
+static struct vnode *
+hammer2_raid6_sm_devvp(hammer2_dev_t *hmp, int i)
+{
+	hammer2_devvp_t *e = hmp->volumes[i].dev;
+
+	if (e == NULL || e->devvp == NULL || !e->open)
+		return NULL;
+	if (hmp->raid_failed[i])
+		return NULL;
+	return e->devvp;
+}
+
+static uint32_t
+hammer2_raid6_sm_hdr_crc(const hammer2_sm_header_t *hdr)
+{
+	uint32_t c;
+
+	c = hammer2_icrc32(hdr, offsetof(hammer2_sm_header_t, hdr_crc));
+	return hammer2_icrc32c((const char *)hdr + HAMMER2_SM_CRC_OFF,
+			       hdr->npages * sizeof(uint32_t), c);
+}
+
+/*
+ * Load the space map copy committed by the volume header: copy
+ * rz_sm_gen & 1, generation rz_sm_gen.  The CRC table comes from the
+ * first disk with a valid header; each page is taken from the first
+ * disk whose copy matches its CRC, so one stale or damaged disk does
+ * not cost the whole map.  If any page is missing everywhere the map
+ * is marked invalid and the mount path rebuilds it with a walk.
+ */
+void
+hammer2_raid6_sm_read(hammer2_dev_t *hmp)
+{
+	hammer2_raid_config_t *rc = &hmp->raid_config;
+	uint64_t gen = hmp->voldata.raid_config.rz_sm_gen;
+	int c = (int)(gen & 1);
+	hammer2_off_t base = rc->rz_sm_off + c * rc->rz_sm_copy;
+	uint32_t npages = hmp->sm_npages;
+	uint32_t *crcs = hmp->sm_crc[c];
+	hammer2_sm_header_t *hdr;
+	struct vnode *devvp;
+	struct buf *bp;
+	uint64_t cursor = 0;
+	uint64_t slot;
+	uint32_t p;
+	int found = 0;
+	int i, j;
+
+	for (i = 0; i < hmp->nvolumes && !found; i++) {
+		devvp = hammer2_raid6_sm_devvp(hmp, i);
+		if (devvp == NULL)
+			continue;
+		bp = NULL;
+		if (bread(devvp, base, HAMMER2_SM_PAGE, &bp)) {
+			if (bp)
+				brelse(bp);
+			continue;
+		}
+		hdr = (hammer2_sm_header_t *)bp->b_data;
+		if (hdr->magic == HAMMER2_SM_MAGIC &&
+		    hdr->version == HAMMER2_SM_VERSION &&
+		    hdr->ndisks == rc->ndisks &&
+		    hdr->stripe_unit == rc->stripe_unit &&
+		    hdr->num_slots == hmp->stripe_num_slots &&
+		    hdr->npages == npages &&
+		    hdr->generation == gen &&
+		    hdr->copy == (uint32_t)c &&
+		    hdr->hdr_crc == hammer2_raid6_sm_hdr_crc(hdr)) {
+			bcopy((char *)bp->b_data + HAMMER2_SM_CRC_OFF, crcs,
+			      npages * sizeof(uint32_t));
+			cursor = hdr->cursor;
+			found = 1;
+		}
+		brelse(bp);
+	}
+	if (!found) {
+		kprintf("hammer2: no valid space map header for "
+			"generation %ju\n", (uintmax_t)gen);
+		goto invalid;
+	}
+
+	for (p = 0; p < npages; p++) {
+		int ok = 0;
+
+		for (i = 0; i < hmp->nvolumes && !ok; i++) {
+			devvp = hammer2_raid6_sm_devvp(hmp, i);
+			if (devvp == NULL)
+				continue;
+			bp = NULL;
+			if (bread(devvp, base + (1 + (off_t)p) * HAMMER2_SM_PAGE,
+				  HAMMER2_SM_PAGE, &bp) == 0 &&
+			    hammer2_icrc32(bp->b_data, HAMMER2_SM_PAGE) ==
+			    crcs[p]) {
+				/* one byte per slot, nonzero: in use */
+				for (j = 0; j < HAMMER2_SM_PAGE_SLOTS; j++) {
+					slot = (uint64_t)p *
+					    HAMMER2_SM_PAGE_SLOTS + j;
+					if (slot < hmp->stripe_num_slots &&
+					    ((uint8_t *)bp->b_data)[j])
+						setbit(hmp->stripe_bitmap,
+						    slot);
+				}
+				ok = 1;
+			}
+			if (bp)
+				brelse(bp);
+		}
+		if (!ok) {
+			kprintf("hammer2: space map page %u of generation "
+				"%ju bad on every disk\n", p, (uintmax_t)gen);
+			goto invalid;
+		}
+	}
+
+	hmp->stripe_cursor = cursor;
+
+	/*
+	 * Nothing says what the other copy holds; the next flush, which
+	 * writes it, rewrites it whole.
+	 */
+	memset(hmp->sm_dirty, 1 << (c ^ 1), npages);
+	return;
+
+invalid:
+	bzero(hmp->stripe_bitmap, hmp->stripe_bitmap_size);
+	hmp->stripe_bitmap_invalid = 1;
+}
+
+/*
+ * bwrite() of a space map page to member disk_idx, given up on after
+ * io_timeout_ms (R11); a member that hangs is failed, without the voldata
+ * lock (the caller may hold it).
+ */
+static int
+hammer2_sm_bwrite(hammer2_dev_t *hmp, int disk_idx, struct buf *bp)
+{
+	int error;
+
+	HAMMER2_RSTAT_WR(hmp, disk_idx, HAMMER2_RSC_VOLHDR, bp->b_bcount);
+	/* -1: not a fault injection point, as bwrite() was not */
+	if (hammer2_bwrite_start(bp, -1) == 0)
+		return 0;
+	error = hammer2_bwrite_wait(bp);
+	if (error == ETIMEDOUT) {
+		hammer2_raid6_mark_failed(hmp, disk_idx, HAMMER2_FAIL_DEFER);
+	}
+	return error;
+}
+
+/*
+ * Write space map generation stripe_generation + 1 to its copy on every
+ * live disk, synchronously.  Called by the flush before the volume
+ * headers; the cache flush that precedes each volume header write makes
+ * the copy durable before the header that names it.  The copy is the
+ * one the on-disk headers do not name, so a crash part way leaves the
+ * committed copy alone.
+ *
+ * Only pages changed since the copy was last written are written.  A
+ * page that fails on any disk stays dirty.  Returns the new generation
+ * in *genp; the caller records it in the volume header and commits it
+ * to stripe_generation once the headers are written.  Fails with EIO
+ * when no live disk took the whole copy.
+ */
+int
+hammer2_raid6_sm_write(hammer2_dev_t *hmp, uint64_t *genp)
+{
+	hammer2_raid_config_t *rc = &hmp->raid_config;
+	uint64_t gen = hmp->stripe_generation + 1;
+	int c = (int)(gen & 1);
+	uint8_t bit = (uint8_t)(1 << c);
+	hammer2_off_t base = rc->rz_sm_off + c * rc->rz_sm_copy;
+	uint32_t npages = hmp->sm_npages;
+	int derr[HAMMER2_MAX_VOLUMES];
+	hammer2_sm_header_t *hdr;
+	struct vnode *devvp;
+	struct buf *bp;
+	char *pbuf;
+	uint32_t p;
+	int perr;
+	int i, j;
+
+	bzero(derr, sizeof(derr));
+	pbuf = kmalloc(HAMMER2_SM_PAGE, M_HAMMER2, M_WAITOK);
+
+	/*
+	 * Shared rebuild_lk, as for any writer to a member: a disk that
+	 * goes away is failed and its buffers thrown out under the
+	 * exclusive lock, and a buffer getblk() makes here meanwhile
+	 * panics vinvalbuf().
+	 */
+	lockmgr(&hmp->rebuild_lk, LK_SHARED);
+
+	for (p = 0; p < npages; p++) {
+		if ((hmp->sm_dirty[p] & bit) == 0)
+			continue;
+		hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+		for (j = 0; j < HAMMER2_SM_PAGE_SLOTS; j++) {
+			uint64_t slot = (uint64_t)p * HAMMER2_SM_PAGE_SLOTS + j;
+
+			pbuf[j] = (slot < hmp->stripe_num_slots &&
+			    isset(hmp->stripe_bitmap, slot)) ? 1 : 0;
+		}
+		hmp->sm_dirty[p] &= ~bit;
+		hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+		hmp->sm_crc[c][p] = hammer2_icrc32(pbuf, HAMMER2_SM_PAGE);
+
+		perr = 0;
+		for (i = 0; i < hmp->nvolumes; i++) {
+			devvp = hammer2_raid6_sm_devvp(hmp, i);
+			if (devvp == NULL)
+				continue;
+			if (derr[i]) {
+				/* this copy is lost already; do not wait again */
+				perr = 1;
+				continue;
+			}
+			bp = getblk(devvp,
+				    base + (1 + (off_t)p) * HAMMER2_SM_PAGE,
+				    HAMMER2_SM_PAGE, GETBLK_KVABIO, 0);
+			bkvasync(bp);
+			bcopy(pbuf, bp->b_data, HAMMER2_SM_PAGE);
+			if (hammer2_sm_bwrite(hmp, i, bp)) {
+				derr[i] = 1;
+				perr = 1;
+			}
+		}
+		if (perr) {
+			hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+			hmp->sm_dirty[p] |= bit;
+			hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+		}
+	}
+
+	bzero(pbuf, HAMMER2_SM_PAGE);
+	hdr = (hammer2_sm_header_t *)pbuf;
+	hdr->magic = HAMMER2_SM_MAGIC;
+	hdr->version = HAMMER2_SM_VERSION;
+	hdr->ndisks = rc->ndisks;
+	hdr->stripe_unit = rc->stripe_unit;
+	hdr->num_slots = hmp->stripe_num_slots;
+	hdr->generation = gen;
+	hdr->cursor = hmp->stripe_cursor;
+	hdr->npages = npages;
+	hdr->copy = (uint32_t)c;
+	bcopy(hmp->sm_crc[c], pbuf + HAMMER2_SM_CRC_OFF,
+	      npages * sizeof(uint32_t));
+	hdr->hdr_crc = hammer2_raid6_sm_hdr_crc(hdr);
+
+	perr = EIO;
+	for (i = 0; i < hmp->nvolumes; i++) {
+		devvp = hammer2_raid6_sm_devvp(hmp, i);
+		if (devvp == NULL || derr[i])
+			continue;
+		bp = getblk(devvp, base, HAMMER2_SM_PAGE, GETBLK_KVABIO, 0);
+		bkvasync(bp);
+		bcopy(pbuf, bp->b_data, HAMMER2_SM_PAGE);
+		if (hammer2_sm_bwrite(hmp, i, bp) == 0)
+			perr = 0;
+	}
+	lockmgr(&hmp->rebuild_lk, LK_RELEASE);
+	kfree(pbuf, M_HAMMER2);
+
+	if (perr)
+		kprintf("hammer2: space map generation %ju not written "
+			"on any disk\n", (uintmax_t)gen);
+	*genp = gen;
+	return perr;
+}
+
+/*
+ * Open-row tracking — see hmp->open_rows comment in hammer2.h.
+ *
+ * Each entry tracks a row (stripe slot) allocated during the current
+ * TXG that hasn't sealed P/Q yet.  The allocator packs additional
+ * chains into existing open rows so up to ndata chains share one
+ * row's parity columns.  Rows seal when full (n_alloc == ndata and
+ * every alloc'd col has col_data) or at TXG flush boundary.
+ *
+ * Stored as a TAILQ.  Entries are kmalloc'd at register time and
+ * kfree'd at seal time — no fixed cap, never force-seal an
+ * incomplete row.
+ */
+
+static int hammer2_orow_cmp(struct hammer2_open_row *, struct hammer2_open_row *);
+RB_PROTOTYPE_STATIC(hammer2_orow_tree, hammer2_open_row, rbnode,
+		    hammer2_orow_cmp);
+
+static int
+hammer2_orow_cmp(struct hammer2_open_row *a, struct hammer2_open_row *b)
+{
+	if (a->row_id < b->row_id)
+		return -1;
+	if (a->row_id > b->row_id)
+		return 1;
+	return 0;
+}
+
+RB_GENERATE_STATIC(hammer2_orow_tree, hammer2_open_row, rbnode, hammer2_orow_cmp);
+
+/*
+ * The open row of slot `row_id`, or NULL.  Caller holds
+ * stripe_bitmap_spin.
+ */
+static struct hammer2_open_row *
+hammer2_raid6_open_row_find(hammer2_dev_t *hmp, uint64_t row_id)
+{
+	struct hammer2_open_row key;
+
+	key.row_id = row_id;
+	return RB_FIND(hammer2_orow_tree, &hmp->open_rows_tree, &key);
+}
+
+void
+hammer2_raid6_open_rows_init(hammer2_dev_t *hmp)
+{
+	if (hmp->open_rows_inited)
+		return;
+	TAILQ_INIT(&hmp->open_rows);
+	TAILQ_INIT(&hmp->open_rows_pack);
+	RB_INIT(&hmp->open_rows_tree);
+	hmp->open_rows_inited = 1;
+	hmp->open_rows_count = 0;
+	hmp->open_rows_high = 0;
+}
+
+static hammer2_io_t *hammer2_raid6_subcol_close_locked(hammer2_dev_t *hmp,
+				struct hammer2_subcol *sc);
+static void hammer2_raid6_subcol_drop(struct hammer2_subcol *sc,
+				hammer2_io_t *dio);
+
+void
+hammer2_raid6_open_rows_free(hammer2_dev_t *hmp)
+{
+	struct hammer2_open_row *r;
+	struct hammer2_subcol *sc;
+	hammer2_io_t *dio;
+	int d;
+
+	if (!hmp->open_rows_inited)
+		return;
+	/*
+	 * A sub-column still open holds a pin on its dio.  The unmount
+	 * flush has closed it; this is for a mount that never flushed.
+	 */
+	for (;;) {
+		hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+		sc = hmp->sc_open;
+		dio = NULL;
+		if (sc)
+			dio = hammer2_raid6_subcol_close_locked(hmp, sc);
+		hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+		if (dio)
+			hammer2_raid6_subcol_drop(sc, dio);
+		if (sc == NULL || dio == NULL)
+			break;
+	}
+	if (hmp->open_rows_count)
+		kprintf("hammer2: v3 unmount drops %ld open rows "
+			"(columns not committed)\n", hmp->open_rows_count);
+	while ((r = TAILQ_FIRST(&hmp->open_rows)) != NULL) {
+		TAILQ_REMOVE(&hmp->open_rows, r, entry);
+		RB_REMOVE(hammer2_orow_tree, &hmp->open_rows_tree, r);
+		if (hmp->stripe_open)
+			clrbit(hmp->stripe_open, r->row_id);
+		for (d = 0; d < HAMMER2_MAX_VOLUMES; d++) {
+			if (r->col_data[d]) {
+				kfree(r->col_data[d], M_HAMMER2);
+				r->col_data[d] = NULL;
+			}
+			if (r->sub[d]) {
+				/* tickets outstanding: a leak, drop the pin */
+				kfree(r->sub[d], M_HAMMER2);
+				r->sub[d] = NULL;
+			}
+		}
+		kfree(r, M_HAMMER2);
+	}
+	TAILQ_INIT(&hmp->open_rows_pack);
+	hmp->sc_open = NULL;
+	hmp->open_rows_count = 0;
+	hmp->open_rows_inited = 0;
+}
+
+/*
+ * Write a row: zero the data columns no chain reserved, write the
+ * columns putblk dropped, then P/Q over cols[].  Called without
+ * stripe_bitmap_spin; sleeps.
+ *
+ * Returns 1 if the row's parity writes were handed to the parity reaper
+ * (async_seal), which then owns the row's rz_sealing reference; else 0,
+ * and everything is on the media.
+ */
+static int
+hammer2_raid6_row_io(hammer2_dev_t *hmp, hammer2_off_t phys_off,
+		     uint64_t row_id, uint32_t alloc_mask, uint32_t dropped,
+		     int p_disk, int q_disk, hammer2_row_col_t *cols,
+		     int ncols, size_t bytes)
+{
+	void *zbuf = NULL;
+	struct buf *zbps[HAMMER2_MAX_VOLUMES];
+	int ndisks = hmp->raid_config.ndisks;
+	int nz = 0;
+	int zdisk[HAMMER2_MAX_VOLUMES];
+	struct hammer2_pq_ent *pe = NULL;
+	struct timespec ts0, ts1;
+	int d, i;
+
+	nanouptime(&ts0);
+	if (hammer2_async_seal && hmp->pq_running && ncols > 0)
+		hammer2_pq_throttle(hmp);
+	/*
+	 * Hold off the resilver's copy of this slot while we write it,
+	 * and tell it the slot is done if a rebuild is running: this seal
+	 * writes every column of the rebuilding disk.
+	 */
+	lockmgr(&hmp->rebuild_lk, LK_SHARED);
+	/*
+	 * A member that does not take this row misses it: a resume cursor
+	 * for that member's rebuild is then stale (rz_rb_wgen).
+	 */
+	for (d = 0; d < ndisks; d++) {
+		if (hmp->raid_failed[d] && !hammer2_raid6_disk_writable(hmp, d)) {
+			atomic_add_64(&hmp->rb_wgen, 1);
+			break;
+		}
+	}
+	if (hmp->rebuild_active && hmp->rebuild_done &&
+	    row_id / 8 < hmp->stripe_bitmap_size) {
+		hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+		hmp->rebuild_done[row_id / 8] |= (uint8_t)(1 << (row_id % 8));
+		hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+	}
+
+	if (ncols > 0) {
+		/*
+		 * Async seal: the row is on the reaper's list before any of
+		 * its parity-side writes exist, so a reader of its P/Q or
+		 * zero columns waits for it from here on.
+		 */
+		if (hammer2_async_seal && hmp->pq_running)
+			pe = hammer2_pq_register(hmp, phys_off);
+
+		/*
+		 * Zero data-disk columns that no chain ever reserved.  P/Q
+		 * are computed assuming those cols are zero, but the disk
+		 * itself still holds whatever bytes a prior tenant left
+		 * (or factory garbage in a never-touched region); without
+		 * this zero-write, parity reconstruction over the on-disk
+		 * column on a later resilver/scrub would yield wrong data
+		 * for the *written* columns.  Only fires for data disks NOT
+		 * in alloc_mask — disks that are reserved but whose chain
+		 * has not yet putblk'd will receive their bytes through the
+		 * chain's own bp.bdwrite path.  They are written in
+		 * parallel with each other and with P/Q, and waited for
+		 * before the seal returns.
+		 */
+		for (d = 0; d < ndisks; d++) {
+			struct buf *zbp;
+			int werr;
+
+			if (d == p_disk || d == q_disk)
+				continue;
+			if (alloc_mask & (1U << d))
+				continue;
+			if (!hammer2_raid6_disk_writable(hmp, d))
+				continue;
+			if (hmp->volumes[d].dev == NULL ||
+			    hmp->volumes[d].dev->devvp == NULL)
+				continue;
+			HAMMER2_RSTAT_WR(hmp, d, HAMMER2_RSC_ZERO, bytes);
+			if (hmp->raid_failed[d]) {
+				/* rebuilding disk: never wait on its bufs */
+				if (zbuf == NULL)
+					zbuf = kmalloc(bytes, M_HAMMER2,
+						       M_WAITOK | M_ZERO);
+				werr = hammer2_io_raid6_write_nowait(
+				    hmp->volumes[d].dev->devvp, phys_off,
+				    zbuf, (int)bytes);
+				if (werr)
+					hammer2_raid6_write_failed(hmp, d,
+								   werr);
+				continue;
+			}
+			zbp = getblk(hmp->volumes[d].dev->devvp, phys_off,
+				     (int)bytes, GETBLK_KVABIO, 0);
+			if (zbp == NULL)
+				continue;
+			bkvasync(zbp);
+			bzero(zbp->b_data, bytes);
+			zbp->b_flags |= B_RELBUF | B_NOCACHE;
+			/* a column left non-zero makes P/Q wrong for it */
+			if (pe && pe->defer) {
+				BUF_KERNPROC(zbp);
+				hammer2_pq_add(pe, zbp, d);
+			} else if (hammer2_bwrite_start(zbp, d)) {
+				if (pe) {
+					hammer2_pq_add(pe, zbp, d);
+				} else {
+					zdisk[nz] = d;
+					zbps[nz++] = zbp;
+				}
+			}
+		}
+
+		/*
+		 * putblk skips the data column of a failed disk.  Write it
+		 * here if that disk now takes writes: it is being rebuilt,
+		 * or it came back online since the putblk.
+		 */
+		for (i = 0; i < ncols; i++) {
+			int werr;
+
+			d = cols[i].disk_idx;
+			if ((dropped & (1U << d)) == 0)
+				continue;
+			if (!hammer2_raid6_disk_writable(hmp, d))
+				continue;
+			if (hmp->volumes[d].dev == NULL ||
+			    hmp->volumes[d].dev->devvp == NULL)
+				continue;
+			HAMMER2_RSTAT_WR(hmp, d, HAMMER2_RSC_DATA, bytes);
+			werr = hammer2_io_raid6_write_nowait(
+			    hmp->volumes[d].dev->devvp, phys_off,
+			    cols[i].data, (int)bytes);
+			if (werr)
+				hammer2_raid6_write_failed(hmp, d, werr);
+		}
+
+		/*
+		 * write_row auto-fails a member whose P/Q write fails; an
+		 * error back means redundancy is exhausted, which
+		 * auto_fail_disk has already reported.
+		 */
+		(void)hammer2_io_raid6_write_row(hmp, phys_off, cols,
+						 ncols, bytes, pe);
+
+		for (i = 0; i < nz; i++) {
+			int werr = hammer2_bwrite_wait(zbps[i]);
+
+			if (werr)
+				hammer2_raid6_write_failed(hmp, zdisk[i],
+							   werr);
+		}
+	}
+	lockmgr(&hmp->rebuild_lk, LK_RELEASE);
+	if (zbuf)
+		kfree(zbuf, M_HAMMER2);
+	if (pe)
+		hammer2_pq_handoff(hmp, pe);
+	nanouptime(&ts1);
+	atomic_add_long(&hammer2_rz_seal_ns,
+	    (long)((ts1.tv_sec - ts0.tv_sec) * 1000000000L +
+		   (ts1.tv_nsec - ts0.tv_nsec)));
+	atomic_add_long(&hammer2_rz_seal_cnt, 1);
+	return pe != NULL;
+}
+
+/*
+ * Take a row off every list and index.  Caller holds stripe_bitmap_spin.
+ * The row's entry is free for the caller to reuse; its columns stay in
+ * col_data[] for hammer2_raid6_row_write_free().
+ */
+static void
+hammer2_raid6_open_row_unlink_locked(hammer2_dev_t *hmp,
+				     struct hammer2_open_row *r)
+{
+	TAILQ_REMOVE(&hmp->open_rows, r, entry);
+	RB_REMOVE(hammer2_orow_tree, &hmp->open_rows_tree, r);
+	if (r->packable) {
+		TAILQ_REMOVE(&hmp->open_rows_pack, r, pentry);
+		r->packable = 0;
+	}
+	hmp->open_rows_count--;
+	clrbit(hmp->stripe_open, r->row_id);
+	/* until its write is done the media holds no P/Q of this row yet */
+	atomic_add_int(&hmp->rz_sealing, 1);
+}
+
+/*
+ * Write an unlinked row's columns and P/Q, free the columns and the
+ * row.  Called without the spin; sleeps.
+ */
+static void
+hammer2_raid6_row_write_free(hammer2_dev_t *hmp, struct hammer2_open_row *r)
+{
+	hammer2_row_col_t cols[HAMMER2_MAX_VOLUMES];
+	void *to_free[HAMMER2_MAX_VOLUMES];
+	int ncols = 0;
+	int handed;
+	int d, i;
+
+	for (d = 0; d < hmp->raid_config.ndisks; d++) {
+		if ((r->alloc_mask & (1U << d)) == 0)
+			continue;
+		if (r->col_data[d] == NULL)
+			continue;
+		cols[ncols].disk_idx = d;
+		cols[ncols].data = r->col_data[d];
+		cols[ncols].bytes = r->bytes;
+		to_free[ncols] = r->col_data[d];
+		r->col_data[d] = NULL;
+		ncols++;
+	}
+	handed = hammer2_raid6_row_io(hmp, r->phys_off, r->row_id,
+				      r->alloc_mask, r->dropped_mask,
+				      r->p_disk, r->q_disk, cols, ncols,
+				      r->bytes);
+	for (i = 0; i < ncols; i++)
+		kfree(to_free[i], M_HAMMER2);
+	kfree(r, M_HAMMER2);
+	if (!handed)
+		atomic_add_int(&hmp->rz_sealing, -1);
+}
+
+/*
+ * Seal a row: unlink it and write it.  Caller holds stripe_bitmap_spin
+ * and has checked that every reserved column has its data; the spin is
+ * released around the (sleeping) I/O and re-acquired before returning.
+ */
+static void
+hammer2_raid6_seal_row_locked_to_unlocked(hammer2_dev_t *hmp,
+					  struct hammer2_open_row *r)
+{
+	hammer2_raid6_open_row_unlink_locked(hmp, r);
+	hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+	hammer2_raid6_row_write_free(hmp, r);
+	hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+}
+
+/*
+ * Every reserved column of the row has its data.  alloc_mask is 32
+ * bits: loop over the array's disks, not HAMMER2_MAX_VOLUMES, or the
+ * shift wraps and a col_data[] past the array counts as missing.
+ */
+static int
+hammer2_raid6_row_complete(hammer2_dev_t *hmp, struct hammer2_open_row *r)
+{
+	int d;
+
+	for (d = 0; d < hmp->raid_config.ndisks; d++) {
+		if ((r->alloc_mask & (1U << d)) && r->col_data[d] == NULL)
+			return 0;
+	}
+	return 1;
+}
+
+/*
+ * Can the row take another column?  Used for the packable list and by
+ * the put that fills a row.
+ */
+static int
+hammer2_raid6_row_can_take(hammer2_dev_t *hmp, struct hammer2_open_row *r)
+{
+	return r->n_alloc < hmp->raid_config.ndata;
+}
+
+/*
+ * Walk the packable rows (current generation, room for a column) for
+ * one with a free data disk that isn't p_disk/q_disk/failed/already
+ * allocated.  On success, mark the disk as allocated, return
+ * phys_off + disk_idx.  Caller already holds stripe_bitmap_spin.
+ *
+ * Returns 1 on success, 0 if no open row could absorb.  next_disk is
+ * advanced on success to spread chains across disks.  A row that
+ * cannot take a column leaves the list.
+ */
+static int
+hammer2_raid6_open_row_pack_locked(hammer2_dev_t *hmp,
+				   hammer2_off_t *phys_off_out,
+				   int *disk_idx_out,
+				   struct hammer2_open_row **row_out)
+{
+	struct hammer2_open_row *r;
+	struct hammer2_open_row *nr;
+	uint32_t failed_mask = 0;
+	int d, candidate;
+
+	if (!hmp->open_rows_inited)
+		return 0;
+
+	for (d = 0; d < hmp->raid_config.ndisks; d++) {
+		if (hmp->raid_failed[d])
+			failed_mask |= 1U << d;
+	}
+
+	TAILQ_FOREACH_MUTABLE(r, &hmp->open_rows_pack, pentry, nr) {
+		if (!hammer2_raid6_row_can_take(hmp, r)) {
+			TAILQ_REMOVE(&hmp->open_rows_pack, r, pentry);
+			r->packable = 0;
+			continue;
+		}
+		candidate = hammer2_raid6_pick_data_disk(hmp, r->p_disk,
+		    r->q_disk, failed_mask | r->alloc_mask);
+		if (candidate < 0) {
+			/* every writable data disk is taken: the row is full */
+			TAILQ_REMOVE(&hmp->open_rows_pack, r, pentry);
+			r->packable = 0;
+			continue;
+		}
+		r->alloc_mask |= (1U << candidate);
+		r->n_alloc++;
+		if (!hammer2_raid6_row_can_take(hmp, r)) {
+			TAILQ_REMOVE(&hmp->open_rows_pack, r, pentry);
+			r->packable = 0;
+		}
+		*phys_off_out = r->phys_off;
+		*disk_idx_out = candidate;
+		*row_out = r;
+		return 1;
+	}
+	return 0;
+}
+
+/*
+ * Place a freshly-allocated row into open_rows[].  Called from
+ * stripe_alloc after the bitmap scan with stripe_bitmap_spin held, so
+ * the caller allocates the entry `r` (zeroed) before taking the lock.
+ */
+static void
+hammer2_raid6_open_row_register_locked(hammer2_dev_t *hmp,
+				       struct hammer2_open_row *r,
+				       uint64_t row_id,
+				       hammer2_off_t phys_off,
+				       int disk_idx)
+{
+	hammer2_raid_config_t *rc = &hmp->raid_config;
+	int ndata = rc->ndata;
+	int p_disk, q_disk;
+
+	hammer2_raid6_pq(row_id, rc->ndisks, &p_disk, &q_disk);
+
+	/*
+	 * TAILQ-backed tracker — never force-seal.  Each new row
+	 * has its own entry; entries are freed at seal time.
+	 * Memory is bounded by (in-flight rows) × (per-entry metadata
+	 * + per-col_data buffer); typical TXG flushes drain everything
+	 * via hammer2_raid6_seal_all_open_rows.
+	 */
+	r->phys_off   = phys_off;
+	r->gen        = hmp->rz_gen;
+	r->row_id     = row_id;
+	r->p_disk     = p_disk;
+	r->q_disk     = q_disk;
+	r->alloc_mask = (1U << disk_idx);
+	r->n_alloc    = 1;
+	r->ndata      = ndata;
+	r->bytes      = rc->stripe_unit;
+
+	TAILQ_INSERT_TAIL(&hmp->open_rows, r, entry);
+	RB_INSERT(hammer2_orow_tree, &hmp->open_rows_tree, r);
+	if (hammer2_raid6_row_can_take(hmp, r)) {
+		TAILQ_INSERT_TAIL(&hmp->open_rows_pack, r, pentry);
+		r->packable = 1;
+	}
+	setbit(hmp->stripe_open, row_id);
+	hmp->open_rows_count++;
+	if (hmp->open_rows_count > hmp->open_rows_high)
+		hmp->open_rows_high = hmp->open_rows_count;
+	if (hmp->open_rows_count > hammer2_rz_open_high)
+		hammer2_rz_open_high = hmp->open_rows_count;
+}
+
+/*
+ * Return 1 if the column bref names cannot take another put in place:
+ * its row has sealed (no open row) or the column's data is already in
+ * the row.  Return 0 if it is still pending, i.e. a put is on its way
+ * and a new put coalesces into it.  A column in a sealed row sits under
+ * P/Q that are already on disk, and an arrived one may be sealed by
+ * another chain's put at any moment, so a chain that rewrites it in the
+ * same TXG must take a fresh slot (oct-review.md §10.3).  A pending
+ * column keeps its row open, so this cannot race a seal.
+ */
+int
+hammer2_raid6_col_arrived(hammer2_dev_t *hmp, const hammer2_blockref_t *bref)
+{
+	struct hammer2_open_row *r;
+	uint64_t slot;
+	int arrived = 1;
+
+	if (!hammer2_raid6_bref_slot(hmp, bref, &slot))
+		return 0;
+	hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+	if (isset(hmp->stripe_open, slot)) {
+		r = hammer2_raid6_open_row_find(hmp, slot);
+		if (r)
+			arrived = (r->col_data[bref->copyid] != NULL);
+	}
+	hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+	return arrived;
+}
+
+/*
+ * Putblk → open_row sink.  Takes ownership of `data` (kfree'd when
+ * row seals).  If every reserved col then has its data and the row is
+ * full, seal it; a complete row of an older generation wakes the flush.
+ */
+void
+hammer2_raid6_open_row_add_data(hammer2_dev_t *hmp, hammer2_off_t phys_off,
+				int disk_idx, void *data, size_t bytes,
+				int dropped)
+{
+	struct hammer2_open_row *r;
+	void *to_free = NULL;
+	int wake = 0;
+
+	/*
+	 * Every chain that makes it through stripe_alloc has a row
+	 * registered before its bp's putblk can fire add_data, and a
+	 * row leaves the list only once all its reserved cols have
+	 * arrived.  A miss means a chain bypassed the allocator's
+	 * register path, or putblk'd again after its row sealed, and
+	 * we'd otherwise silently drop its bytes from P/Q.
+	 */
+	KKASSERT(hmp->open_rows_inited);
+
+	hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+	r = hammer2_raid6_open_row_find(hmp, hammer2_raid6_slot(phys_off,
+					     hmp->raid_config.stripe_unit));
+	if (r == NULL) {
+		hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+		panic("hammer2: v3 putblk for a row not open: phys %016jx "
+		      "disk %d", (uintmax_t)phys_off, disk_idx);
+	}
+	KKASSERT(r->phys_off == phys_off && r->bytes == bytes);
+	KKASSERT(r->alloc_mask & (1U << disk_idx));
+
+	/*
+	 * A column is put once.  chain_modify gives a chain whose column
+	 * has arrived a fresh slot (hammer2_raid6_col_arrived), so a second
+	 * put here means a dio dirtied again without a modify; the latest
+	 * copy wins, which is only right while the row stays open, and it
+	 * is counted (vfs.hammer2.rz_put_anomaly).  kfree the old copy
+	 * after the spinlock is released: it can sleep on the kernel map.
+	 */
+	to_free = r->col_data[disk_idx];
+	if (to_free)
+		hammer2_rz_put_anomaly++;
+	r->col_data[disk_idx] = data;
+	if (dropped)
+		r->dropped_mask |= 1U << disk_idx;
+	else
+		r->dropped_mask &= ~(1U << disk_idx);
+
+	/*
+	 * A full row seals here.  A row of an older generation is sealed
+	 * by the flush, which is told when its last column has arrived.
+	 */
+	if (hammer2_raid6_row_complete(hmp, r)) {
+		if (r->gen != hmp->rz_gen && hmp->rz_gen_waiting)
+			wake = 1;
+		if (r->n_alloc >= r->ndata) {
+			hammer2_rz_seal_full++;
+			atomic_add_64(&hmp->rs_seal_full, 1);
+			hammer2_raid6_seal_row_locked_to_unlocked(hmp, r);
+		}
+	}
+	hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+
+	if (wake)
+		wakeup(&hmp->open_rows);
+	if (to_free)
+		kfree(to_free, M_HAMMER2);
+}
+
+/*
+ * Release a reservation whose column will never be put: the write
+ * failed between stripe_alloc and putblk (the dio was errored, so
+ * putblk had no data to hand over).  The column is put as a zero
+ * buffer flagged dropped, so the row seals with zero in that column
+ * (on disk and in P/Q) instead of making every later flush wait for it.
+ * Nothing happens if the row is gone or the column already arrived.
+ * Counted in vfs.hammer2.rz_col_released.
+ */
+void
+hammer2_raid6_col_release(hammer2_dev_t *hmp, hammer2_off_t phys_off,
+			  int disk_idx)
+{
+	struct hammer2_open_row *r;
+	void *zero;
+	size_t bytes;
+	int need = 0;
+
+	if (!hmp->open_rows_inited || disk_idx < 0)
+		return;
+	bytes = hmp->raid_config.stripe_unit;
+	zero = kmalloc(bytes, M_HAMMER2, M_WAITOK | M_ZERO);
+	hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+	r = hammer2_raid6_open_row_find(hmp, hammer2_raid6_slot(phys_off,
+					     bytes));
+	if (r)
+		need = ((r->alloc_mask & (1U << disk_idx)) &&
+			r->col_data[disk_idx] == NULL);
+	hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+	if (need) {
+		hammer2_rz_col_released++;
+		hammer2_raid6_open_row_add_data(hmp, phys_off, disk_idx,
+						zero, bytes, 1);
+	} else {
+		kfree(zero, M_HAMMER2);
+	}
+}
+
+/*
+ * Seal the open rows at a TXG flush, before VOP_FSYNC and the volume
+ * header (oct-review.md §10.2).  Called after the last chain flush has
+ * returned: every chain the header can commit was allocated before this
+ * point, so its row is of the current generation or an older one.
+ *
+ * Advance rz_gen, which closes every existing row to new reservations
+ * (packing takes only rows of the current generation), then seal each
+ * older row once its reserved columns have all arrived.  A column is
+ * pending only between the allocation and the put of one strategy
+ * write, so the wait is short; the row is sealed in full, never with a
+ * column missing.
+ *
+ * If no column arrives for vfs.hammer2.raid6_gen_wait_ms the flush
+ * fails with EAGAIN: the caller must not write the volume header.  The
+ * rows stay on the list and the next flush waits for them again.
+ *
+ * One pass over the older rows (they are the head of open_rows, which
+ * is in registration order) moves every complete one to a private
+ * list; they are then written with the spinlock dropped.  Writing a
+ * row counts as progress and restarts the wait.
+ */
+int
+hammer2_raid6_seal_all_open_rows(hammer2_dev_t *hmp)
+{
+	TAILQ_HEAD(, hammer2_open_row) sealq = TAILQ_HEAD_INITIALIZER(sealq);
+	struct hammer2_open_row *r;
+	struct hammer2_open_row *nr;
+	struct hammer2_open_row *stuck;
+	struct hammer2_subcol *sc;
+	hammer2_io_t *dio;
+	int deadline;
+	int d;
+
+	if (!hmp->open_rows_inited)
+		return 0;
+
+	hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+	hmp->rz_gen++;
+	while ((r = TAILQ_FIRST(&hmp->open_rows_pack)) != NULL) {
+		TAILQ_REMOVE(&hmp->open_rows_pack, r, pentry);
+		r->packable = 0;
+	}
+	/*
+	 * Close the open sub-column (always of the generation that just
+	 * ended) and drop its pin if no chain is mid-write; the last
+	 * chain's subcol_done drops it otherwise.  The column then arrives
+	 * and the row wait below covers it, with the same timeout.
+	 */
+	if ((sc = hmp->sc_open) != NULL) {
+		dio = hammer2_raid6_subcol_close_locked(hmp, sc);
+		if (dio) {
+			hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+			hammer2_raid6_subcol_drop(sc, dio);
+			hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+		}
+	}
+	deadline = ticks + (int)((long)hz * hammer2_raid6_gen_wait_ms / 1000);
+	for (;;) {
+		stuck = NULL;
+		TAILQ_FOREACH_MUTABLE(r, &hmp->open_rows, entry, nr) {
+			if (r->gen == hmp->rz_gen)
+				break;
+			if (!hammer2_raid6_row_complete(hmp, r)) {
+				if (stuck == NULL)
+					stuck = r;
+				continue;
+			}
+			hammer2_rz_seal_flush++;
+			atomic_add_64(&hmp->rs_seal_flush, 1);
+			if (r->n_alloc < r->ndata) {
+				hammer2_rz_seal_flush_short++;
+				atomic_add_64(&hmp->rs_seal_partial, 1);
+			}
+			hammer2_raid6_open_row_unlink_locked(hmp, r);
+			TAILQ_INSERT_TAIL(&sealq, r, entry);
+		}
+		if (!TAILQ_EMPTY(&sealq)) {
+			hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+			while ((r = TAILQ_FIRST(&sealq)) != NULL) {
+				TAILQ_REMOVE(&sealq, r, entry);
+				hammer2_raid6_row_write_free(hmp, r);
+			}
+			hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+			/* progress: the wait starts over */
+			deadline = ticks +
+			    (int)((long)hz * hammer2_raid6_gen_wait_ms / 1000);
+			continue;
+		}
+		if (stuck == NULL)
+			break;
+		if ((int)(ticks - deadline) >= 0) {
+			uint32_t pend = 0;
+			uint64_t row_id = stuck->row_id;
+			hammer2_off_t phys_off = stuck->phys_off;
+			uint32_t gen = stuck->gen;
+			uint32_t now = hmp->rz_gen;
+
+			for (d = 0; d < hmp->raid_config.ndisks; d++) {
+				if ((stuck->alloc_mask & (1U << d)) &&
+				    stuck->col_data[d] == NULL)
+					pend |= 1U << d;
+			}
+			hammer2_rz_gen_wait_fail++;
+			hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+			kprintf("hammer2: v3 flush failed: row %ju phys %016jx "
+				"gen %u (now %u) still waits for columns "
+				"%08x after %d ms\n",
+				(uintmax_t)row_id, (uintmax_t)phys_off, gen,
+				now, pend, hammer2_raid6_gen_wait_ms);
+			return EAGAIN;
+		}
+		hmp->rz_gen_waiting++;
+		ssleep(&hmp->open_rows, &hmp->stripe_bitmap_spin, 0,
+		       "h2rzgen", hz / 10 ? hz / 10 : 1);
+		hmp->rz_gen_waiting--;
+	}
+	hammer2_rz_open_left = hmp->open_rows_count;
+	hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+	return 0;
+}
+
+/*
+ * Return 1 if stripe slot `slot` may hold a parity row.  Everything up
+ * to the end of metadata extent 0 (space map, aux area, metadata zone),
+ * the reserved segment at the start of every 2 GB zone (volume header
+ * backups, freemap blocks) and any further metadata extent hold per-disk
+ * or mirrored data instead (docs/capacity.md): the allocator never
+ * places a row there, and the resilver must not rebuild one there from
+ * parity.
+ */
+int
+hammer2_raid6_slot_is_data(hammer2_dev_t *hmp, uint64_t slot)
+{
+	uint64_t stripe_unit = hmp->raid_config.stripe_unit;
+	hammer2_off_t off = HAMMER2_ZONE_SEG64 + slot * stripe_unit;
+	hammer2_off_t zoff = off & HAMMER2_ZONE_MASK64;
+	uint32_t ex;
+
+	if (slot >= hmp->stripe_num_slots)
+		return 0;
+	if (zoff < HAMMER2_ZONE_SEG64 ||
+	    zoff + stripe_unit > HAMMER2_ZONE_BYTES64)
+		return 0;
+	if (off < hmp->md_extents[0].md_off + hmp->md_extents[0].md_size)
+		return 0;
+	for (ex = 1; ex < hmp->md_nextents; ex++) {
+		hammer2_off_t mo = hmp->md_extents[ex].md_off;
+		hammer2_off_t ms = hmp->md_extents[ex].md_size;
+		if (off + stripe_unit > mo && off < mo + ms)
+			return 0;
+	}
+	return 1;
+}
+
+/*
+ * Usable size and free space of a v3 array for statfs.  The freemap only
+ * covers metadata on v3 (data rows live in the stripe bitmap), and it
+ * spans the raw size of every disk, so allocator_size/free mean nothing
+ * to the user.  Report the rows (ndata columns each) plus the metadata
+ * zone, counted once because it is mirrored.  A partly packed row counts
+ * as full, so free space is never overstated.
+ */
+void
+hammer2_raid6_space(hammer2_dev_t *hmp, hammer2_off_t *totalp,
+		    hammer2_off_t *freep)
+{
+	hammer2_off_t dtotal, dfree, mtotal, mfree;
+
+	hammer2_raid6_space_split(hmp, &dtotal, &dfree, &mtotal, &mfree);
+	*totalp = dtotal + mtotal;
+	*freep = dfree + mfree;
+}
+
+/*
+ * The same, split into the data rows and the (mirrored) metadata zone.
+ * Both limits matter: a flush that cannot get a metadata block fails just
+ * as a data write that finds no free row does.
+ */
+void
+hammer2_raid6_space_split(hammer2_dev_t *hmp, hammer2_off_t *dtotalp,
+		    hammer2_off_t *dfreep, hammer2_off_t *mtotalp,
+		    hammer2_off_t *mfreep)
+{
+	hammer2_off_t row_bytes;
+	hammer2_off_t md_size = 0;
+	hammer2_off_t md_used;
+	uint64_t slot;
+	uint64_t used;
+	uint32_t ex;
+	size_t i;
+
+	row_bytes = hmp->raid_config.stripe_unit * hmp->raid_config.ndata;
+	for (ex = 0; ex < hmp->md_nextents; ex++)
+		md_size += hmp->md_extents[ex].md_size;
+
+	if (hmp->stripe_bitmap == NULL) {
+		*dtotalp = 0;
+		*dfreep = 0;
+		*mtotalp = md_size;
+		*mfreep = 0;
+		return;
+	}
+	if (hmp->stripe_data_slots == 0) {
+		for (slot = 0; slot < hmp->stripe_num_slots; slot++) {
+			if (hammer2_raid6_slot_is_data(hmp, slot))
+				++hmp->stripe_data_slots;
+		}
+	}
+
+	/*
+	 * Counting is unlocked; a racing allocation only makes the figure
+	 * slightly stale.  Recount at most once a second.
+	 */
+	if (hmp->stripe_used_ticks == 0 ||
+	    (u_int)(ticks - hmp->stripe_used_ticks) >= (u_int)hz) {
+		used = 0;
+		for (i = 0; i < hmp->stripe_bitmap_size; i++)
+			used += bitcount32(hmp->stripe_bitmap[i]);
+		hmp->stripe_used_slots = used;
+		hmp->stripe_used_ticks = ticks ? ticks : 1;
+	}
+	used = hmp->stripe_used_slots;
+	if (used > hmp->stripe_data_slots)
+		used = hmp->stripe_data_slots;
+
+	/*
+	 * Every freemap allocation on v3 is metadata.
+	 */
+	md_used = hmp->voldata.allocator_size - hmp->voldata.allocator_free;
+	if (md_used > md_size)
+		md_used = md_size;
+
+	*dtotalp = hmp->stripe_data_slots * row_bytes;
+	*dfreep = (hmp->stripe_data_slots - used) * row_bytes;
+	*mtotalp = md_size;
+	*mfreep = md_size - md_used;
+}
+
+/*
+ * Find the first free data slot in [from, to): a clear bit in
+ * stripe_bitmap that is set in stripe_data_mask (slots outside the
+ * metadata extents, see hammer2_raid6_slot_is_data).  Scans 64 slots
+ * at a time; bit n of byte j is slot 8j+n, which on a little-endian
+ * machine is bit (slot % 64) of word slot / 64.  Caller holds
+ * stripe_bitmap_spin.
+ */
+static int
+hammer2_raid6_find_free_slot(hammer2_dev_t *hmp, uint64_t from, uint64_t to,
+			     uint64_t *slotp)
+{
+	const uint64_t *bm = (const uint64_t *)hmp->stripe_bitmap;
+	const uint64_t *dm = (const uint64_t *)hmp->stripe_data_mask;
+	uint64_t avail;
+	uint64_t wi;
+
+	while (from < to) {
+		wi = from / 64;
+		avail = dm[wi] & ~bm[wi];
+		avail &= ~(uint64_t)0 << (from % 64);
+		if ((to - 1) / 64 == wi && (to % 64) != 0)
+			avail &= ((uint64_t)1 << (to % 64)) - 1;
+		if (avail) {
+			*slotp = wi * 64 + (uint64_t)(ffsl((long)avail) - 1);
+			return 1;
+		}
+		from = (wi + 1) * 64;
+	}
+	return 0;
+}
+
+/*
+ * Sub-offset of a chain of `bytes` inside its column, for the test hook
+ * vfs.hammer2.raid6_subcol_test (oct-review.md section 11.5 step 2).  The
+ * column stays private to the chain; only data_off gains an offset, so
+ * the read, scrub, degraded read, self-heal and resilver paths see what
+ * a shared column will give them.  A power-of-two size is placed at a
+ * multiple of itself, as the packing allocator will place it.  64 KB
+ * chains, and everything when the hook is off, stay at 0.
+ */
+static uint32_t
+hammer2_raid6_test_off(uint64_t slot, size_t bytes)
+{
+	uint32_t n;
+
+	if (hammer2_raid6_subcol_test == 0 || bytes >= HAMMER2_PBUFSIZE ||
+	    bytes < HAMMER2_ALLOC_MIN)
+		return 0;
+	n = (uint32_t)(HAMMER2_PBUFSIZE / bytes);
+	if (hammer2_raid6_subcol_test == 1)
+		return (uint32_t)(HAMMER2_PBUFSIZE - bytes);
+	return (uint32_t)(bytes * (1 + (slot * 2654435761U + bytes) % (n - 1)));
+}
+
+/*
+ * The chain's column is still pending and private (nothing else lives in
+ * it), so a resize may move the chain inside it.  Keep the offset if the
+ * new size is aligned to it and fits, else pick a new one.  Only the
+ * offset bits of data_off change; the caller sets the radix.
+ */
+static void
+hammer2_raid6_replace_private(hammer2_chain_t *chain)
+{
+	hammer2_blockref_t *bref = &chain->bref;
+	hammer2_off_t cur;
+	hammer2_off_t base;
+	uint64_t slot;
+	size_t nbytes = chain->bytes;
+
+	if (!hammer2_raid6_bref_slot(chain->hmp, bref, &slot))
+		return;
+	base = bref->data_off & ~(hammer2_off_t)(HAMMER2_PBUFSIZE - 1);
+	cur = bref->data_off & (HAMMER2_PBUFSIZE - 1) &
+	      ~(hammer2_off_t)HAMMER2_OFF_MASK_RADIX;
+	if (nbytes == 0 || nbytes > HAMMER2_PBUFSIZE ||
+	    ((cur % nbytes) == 0 && cur + nbytes <= HAMMER2_PBUFSIZE))
+		return;
+	cur = hammer2_raid6_test_off(slot, nbytes);
+	bref->data_off = base | cur | (bref->data_off & HAMMER2_OFF_MASK_RADIX);
+}
+
+/*
+ * Sub-columns (oct-review.md section 11.4).  A sub-column is a column of
+ * an open row that several small data chains share.  Its used_mask has
+ * one bit per 1 KB; a chain of power-of-two size S takes the first free
+ * S-aligned range.  The sub-column holds one ref on the column's dio (the
+ * pin), so the column is put exactly once, when the sub-column closes
+ * and the last ref goes.  Each chain that has a range and has not yet
+ * finished its write holds a ticket (HAMMER2_CHAIN_SUBHELD, counted in
+ * npending); the pin is not dropped while any is out.  There is at most
+ * one open sub-column (hmp->sc_open), always of the current generation.
+ */
+
+/*
+ * Mark a sub-column closed to new chains.  Caller holds
+ * stripe_bitmap_spin.  If no ticket is out, returns the pin for the
+ * caller to drop (hammer2_raid6_subcol_drop(), spin released), else NULL
+ * and the last subcol_done drops it.
+ */
+static hammer2_io_t *
+hammer2_raid6_subcol_close_locked(hammer2_dev_t *hmp, struct hammer2_subcol *sc)
+{
+	hammer2_io_t *dio = NULL;
+
+	sc->closing = 1;
+	if (hmp->sc_open == sc)
+		hmp->sc_open = NULL;
+	if (sc->npending == 0 && sc->pinning == 0 && sc->dio != NULL) {
+		dio = sc->dio;
+		sc->dio = NULL;
+		sc->row->sub[sc->disk] = NULL;
+	}
+	return dio;
+}
+
+/*
+ * Drop the pin of a closed sub-column and free it.  The put of the
+ * column happens here unless another ref on the dio is still out, in
+ * which case it happens at that ref's drop.
+ */
+static void
+hammer2_raid6_subcol_drop(struct hammer2_subcol *sc, hammer2_io_t *dio)
+{
+	atomic_add_long(&hammer2_rz_subcol_close, 1);
+	hammer2_io_putblk(&dio);
+	kfree(sc, M_HAMMER2);
+}
+
+/*
+ * First free range of `units` 1 KB units aligned to `units` (a power of
+ * two, 1-32).  Returns 1 and the unit offset, or 0.
+ */
+static int
+hammer2_raid6_subcol_find(uint64_t used, int units, int *offp)
+{
+	uint64_t want = ((uint64_t)1 << units) - 1;
+	int i;
+
+	for (i = 0; i + units <= 64; i += units) {
+		if ((used & (want << i)) == 0) {
+			*offp = i;
+			return 1;
+		}
+	}
+	return 0;
+}
+
+/*
+ * The chain finished (or abandoned) its write: give back its ticket.
+ * Idempotent.  The last ticket of a closed sub-column drops the pin.
+ * Called with the chain locked, after its own dio ref is dropped, so
+ * that the put of the column (the pin drop) includes its bytes.
+ */
+void
+hammer2_raid6_subcol_done(hammer2_chain_t *chain)
+{
+	hammer2_dev_t *hmp;
+	struct hammer2_open_row *r;
+	struct hammer2_subcol *sc = NULL;
+	hammer2_io_t *dio = NULL;
+	uint64_t slot;
+
+	if ((chain->flags & HAMMER2_CHAIN_SUBHELD) == 0)
+		return;
+	hmp = chain->hmp;
+	hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+	if (chain->flags & HAMMER2_CHAIN_SUBHELD) {
+		atomic_clear_int(&chain->flags, HAMMER2_CHAIN_SUBHELD);
+		if (hammer2_raid6_bref_slot(hmp, &chain->bref, &slot) &&
+		    (r = hammer2_raid6_open_row_find(hmp, slot)) != NULL &&
+		    (sc = r->sub[chain->bref.copyid]) != NULL &&
+		    sc->npending > 0) {
+			sc->npending--;
+			if (sc->closing && sc->npending == 0)
+				dio = hammer2_raid6_subcol_close_locked(hmp,
+									sc);
+		} else {
+			sc = NULL;
+			kprintf("hammer2: v3 sub-column ticket without a "
+				"sub-column: data_off %016jx copyid %d\n",
+				(uintmax_t)chain->bref.data_off,
+				chain->bref.copyid);
+		}
+	}
+	hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+	if (dio)
+		hammer2_raid6_subcol_drop(sc, dio);
+}
+
+/*
+ * Safety net for chains that leave the write paths holding a ticket
+ * (chain freed, or cleaned by the flush).  Counted: it should stay 0.
+ */
+void
+hammer2_raid6_subcol_net(hammer2_chain_t *chain)
+{
+	if (chain->flags & HAMMER2_CHAIN_SUBHELD) {
+		atomic_add_long(&hammer2_rz_subcol_stale, 1);
+		hammer2_raid6_subcol_done(chain);
+	}
+}
+
+/*
+ * chain_modify could not use the slot it was given (the dio read
+ * failed): give it back.  A sub-column chain just returns its ticket,
+ * the column is put by the pin as usual and the chain's bytes in it are
+ * zero.  A private column that will never be put is released.
+ */
+void
+hammer2_raid6_chain_release(hammer2_dev_t *hmp, hammer2_chain_t *chain)
+{
+	struct hammer2_open_row *r;
+	uint64_t slot;
+	int sub = 0;
+
+	if (chain->flags & HAMMER2_CHAIN_SUBHELD) {
+		hammer2_raid6_subcol_done(chain);
+		return;
+	}
+	if (hammer2_raid6_bref_slot(hmp, &chain->bref, &slot)) {
+		hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+		r = hammer2_raid6_open_row_find(hmp, slot);
+		if (r && (r->sub_mask & (1U << chain->bref.copyid)))
+			sub = 1;
+		hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+	}
+	if (sub == 0) {
+		hammer2_raid6_col_release(hmp, chain->bref.data_off &
+		    HAMMER2_RAID6_COLUMN_MASK, chain->bref.copyid);
+	}
+}
+
+/*
+ * Reserve a column for a new chain or sub-column: a column of an open
+ * row of the current generation if one has room, else a free slot,
+ * registered as a new row.  Caller holds stripe_bitmap_spin and passes
+ * a zeroed *newrowp, set to NULL if used (the caller frees it
+ * otherwise, after releasing the spin).  Returns the column's per-disk
+ * phys_off, its disk and its row.  ENOSPC if there is no free slot.
+ */
+static int
+hammer2_raid6_col_reserve_locked(hammer2_dev_t *hmp,
+				 struct hammer2_open_row **newrowp,
+				 hammer2_off_t *phys_offp, int *diskp,
+				 struct hammer2_open_row **rowp)
+{
+	hammer2_raid_config_t *rc = &hmp->raid_config;
+	uint64_t stripe_unit = rc->stripe_unit;
+	uint64_t max_stripes = hmp->stripe_num_slots;
+	uint64_t slot;
+	uint64_t start;
+	uint64_t byte_idx;
+	int bit_idx;
+	int disk_idx;
+	int p_disk, q_disk;
+	hammer2_off_t phys_off;
+	hammer2_off_t pack_off;
+	int pack_disk_idx;
+	uint32_t failed_mask = 0;
+	int d, tries;
+
+	/*
+	 * 6C packing: try to land in an existing open row first so a row
+	 * can be filled with up to ndata chains before P/Q is computed.
+	 */
+	if (hammer2_raid6_open_row_pack_locked(hmp, &pack_off,
+	    &pack_disk_idx, rowp)) {
+		slot = hammer2_raid6_slot(pack_off, stripe_unit);
+		hammer2_raid6_sm_touch(hmp, slot);
+		if (hmp->stripe_bf_active)
+			setbit(hmp->stripe_bf_new, slot);
+		*phys_offp = pack_off;
+		*diskp = pack_disk_idx;
+		return 0;
+	}
+
+	/*
+	 * Next free data slot from the cursor, wrapping once, with a data
+	 * disk that is not P, Q or failed (round-robin).  A failed disk
+	 * gets no data: a column there would only be rebuilt from parity
+	 * and discarded.  If P/Q of the slot leave no live data disk (two
+	 * data disks down), try the next slot: P/Q rotate, so one of any
+	 * ndisks slots has a live data disk unless too many are failed.
+	 */
+	for (d = 0; d < rc->ndisks; d++) {
+		if (hmp->raid_failed[d])
+			failed_mask |= 1U << d;
+	}
+	start = hmp->stripe_cursor;
+	if (start >= max_stripes)
+		start = 0;
+	for (tries = 0; ; tries++) {
+		if (tries >= rc->ndisks)
+			return ENOSPC;
+		if (!hammer2_raid6_find_free_slot(hmp, start, max_stripes,
+		    &slot) &&
+		    !hammer2_raid6_find_free_slot(hmp, 0, start, &slot))
+			return ENOSPC;
+		hammer2_raid6_pq(slot, rc->ndisks, &p_disk, &q_disk);
+		disk_idx = hammer2_raid6_pick_data_disk(hmp, p_disk, q_disk,
+		    failed_mask);
+		if (disk_idx >= 0)
+			break;
+		start = slot + 1;
+		if (start >= max_stripes)
+			start = 0;
+	}
+	byte_idx = slot / 8;
+	bit_idx  = (int)(slot % 8);
+	hmp->stripe_bitmap[byte_idx] |= (uint8_t)(1 << bit_idx);
+	hammer2_raid6_sm_touch(hmp, slot);
+	if (hmp->stripe_bf_active)
+		setbit(hmp->stripe_bf_new, slot);
+	hmp->stripe_cursor = slot + 1;
+
+	phys_off = HAMMER2_ZONE_SEG64 + slot * stripe_unit;
+	/*
+	 * Register the newly-allocated row so subsequent allocations
+	 * within the same TXG can pack into it.
+	 */
+	hammer2_raid6_open_row_register_locked(hmp, *newrowp, slot, phys_off,
+					       disk_idx);
+	*rowp = *newrowp;
+	*newrowp = NULL;
+	*phys_offp = phys_off;
+	*diskp = disk_idx;
+	return 0;
+}
+
+/*
+ * Place a chain in the open sub-column, opening one in a new column if
+ * there is none or the chain finds no aligned range.  Returns 0 with
+ * data_off, copyid and a ticket set, ENOSPC, or 1 if the chain could not
+ * be placed (the pin failed) and takes a private column instead.
+ */
+static int
+hammer2_raid6_subcol_alloc(hammer2_dev_t *hmp, hammer2_chain_t *chain)
+{
+	struct hammer2_open_row *newrow;
+	struct hammer2_open_row *row;
+	struct hammer2_subcol *newsc;
+	struct hammer2_subcol *sc;
+	struct hammer2_subcol *oldsc = NULL;
+	hammer2_io_t *olddio = NULL;
+	hammer2_io_t *dio = NULL;
+	hammer2_blockref_t bref;
+	hammer2_off_t phys_off;
+	int units = (int)(chain->bytes >> 10);
+	int radix = 0;
+	int disk;
+	int off;
+	int error;
+	int n;
+
+	for (n = (int)chain->bytes; n > 1; n >>= 1)
+		radix++;
+	newrow = kmalloc(sizeof(*newrow), M_HAMMER2, M_WAITOK | M_ZERO);
+	newsc = kmalloc(sizeof(*newsc), M_HAMMER2, M_WAITOK | M_ZERO);
+
+	hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+again:
+	sc = hmp->sc_open;
+	if (sc != NULL) {
+		if (sc->pinning) {
+			/* its creator is still getting the dio */
+			ssleep(&hmp->sc_open, &hmp->stripe_bitmap_spin, 0,
+			       "h2rzsc", hz);
+			goto again;
+		}
+		if (sc->row->gen == hmp->rz_gen &&
+		    hammer2_raid6_subcol_find(sc->used_mask, units, &off)) {
+			sc->used_mask |= (((uint64_t)1 << units) - 1) << off;
+			sc->npending++;
+			atomic_set_int(&chain->flags, HAMMER2_CHAIN_SUBHELD);
+			phys_off = sc->row->phys_off;
+			disk = sc->disk;
+			if (sc->used_mask == ~(uint64_t)0)
+				(void)hammer2_raid6_subcol_close_locked(hmp,
+									sc);
+			hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+			kfree(newrow, M_HAMMER2);
+			kfree(newsc, M_HAMMER2);
+			chain->bref.data_off = phys_off |
+			    ((hammer2_off_t)off << 10) | (hammer2_off_t)radix;
+			chain->bref.copyid = (uint8_t)disk;
+			atomic_add_long(&hammer2_rz_subcol_chains, 1);
+			return 0;
+		}
+		/* full, or no aligned range: close it and open the next */
+		atomic_add_long(&hammer2_rz_subcol_nofit, 1);
+		olddio = hammer2_raid6_subcol_close_locked(hmp, sc);
+		oldsc = sc;
+	}
+
+	error = hammer2_raid6_col_reserve_locked(hmp, &newrow, &phys_off,
+						 &disk, &row);
+	if (error) {
+		hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+		if (olddio)
+			hammer2_raid6_subcol_drop(oldsc, olddio);
+		if (newrow)
+			kfree(newrow, M_HAMMER2);
+		kfree(newsc, M_HAMMER2);
+		return error;
+	}
+	sc = newsc;
+	newsc = NULL;
+	sc->row = row;
+	sc->disk = disk;
+	sc->pinning = 1;
+	sc->npending = 1;
+	sc->used_mask = (((uint64_t)1 << units) - 1);	/* at offset 0 */
+	row->sub_mask |= 1U << disk;
+	row->sub[disk] = sc;
+	hmp->sc_open = sc;
+	atomic_set_int(&chain->flags, HAMMER2_CHAIN_SUBHELD);
+	hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+	if (newrow)
+		kfree(newrow, M_HAMMER2);
+	if (olddio)
+		hammer2_raid6_subcol_drop(oldsc, olddio);
+	atomic_add_long(&hammer2_rz_cols_alloc, 1);
+	atomic_add_long(&hammer2_rz_subcol_open, 1);
+
+	/*
+	 * The pin: the whole column, NEW, so the buffer is zero-filled once
+	 * and every chain that follows finds the dio good and takes its own
+	 * ref.  Other allocators wait for pinning to clear.
+	 */
+	bzero(&bref, sizeof(bref));
+	bref.type = HAMMER2_BREF_TYPE_DATA;
+	bref.copyid = (uint8_t)disk;
+	error = hammer2_io_new(hmp, HAMMER2_BREF_TYPE_DATA,
+			       phys_off | HAMMER2_PBUFRADIX,
+			       HAMMER2_PBUFSIZE, &dio, &bref);
+
+	hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+	sc->pinning = 0;
+	if (error == 0) {
+		sc->dio = dio;
+	} else {
+		/* give the reservation up; the chain takes a private column */
+		sc->closing = 1;
+		sc->npending--;
+		if (hmp->sc_open == sc)
+			hmp->sc_open = NULL;
+		row->sub[disk] = NULL;
+		atomic_clear_int(&chain->flags, HAMMER2_CHAIN_SUBHELD);
+	}
+	hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+	wakeup(&hmp->sc_open);
+	if (error) {
+		hammer2_io_putblk(&dio);
+		hammer2_raid6_col_release(hmp, phys_off, disk);
+		kfree(sc, M_HAMMER2);
+		return 1;
+	}
+	chain->bref.data_off = phys_off | (hammer2_off_t)radix;
+	chain->bref.copyid = (uint8_t)disk;
+	atomic_add_long(&hammer2_rz_subcol_chains, 1);
+	return 0;
+}
+
+/*
+ * A chain modified again while MODIFIED: should it take a fresh slot
+ * (return 1) or reuse its column (0)?  The column of a chain that has
+ * arrived, or whose row has sealed, is not ours any more.  A pending
+ * private one is, and the chain may have a new size
+ * (hammer2_chain_resize sets chain->bytes first), so it is re-placed
+ * inside the column.
+ *
+ * A pending sub-column column is shared.  While the sub-column is open
+ * (nothing of it has been put) the chain keeps its range if the new
+ * size fits it and otherwise takes a free aligned range of the same
+ * column; if there is none, or the sub-column is closed, it takes a
+ * fresh slot and the old range stays a hole (oct-review.md section 11.4,
+ * "Arrived").
+ */
+int
+hammer2_raid6_col_rewrite(hammer2_dev_t *hmp, hammer2_chain_t *chain)
+{
+	struct hammer2_open_row *r;
+	struct hammer2_subcol *sc;
+	hammer2_io_t *dio = NULL;
+	hammer2_off_t doff;
+	uint64_t slot;
+	int d = chain->bref.copyid;
+	int units, ounits, off;
+
+	if (!hammer2_raid6_bref_slot(hmp, &chain->bref, &slot))
+		return 0;
+	hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+	r = isset(hmp->stripe_open, slot) ?
+	    hammer2_raid6_open_row_find(hmp, slot) : NULL;
+	if (r == NULL || r->col_data[d] != NULL) {
+		hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+		return 1;
+	}
+	if ((r->sub_mask & (1U << d)) == 0) {
+		hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+		hammer2_raid6_replace_private(chain);
+		return 0;
+	}
+	sc = r->sub[d];
+	if (sc == NULL || sc->closing || sc->pinning) {
+		hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+		return 1;
+	}
+	units = (int)(chain->bytes >> 10);
+	ounits = (chain->bref.data_off & HAMMER2_OFF_MASK_RADIX) ?
+	    (int)((1U << (int)(chain->bref.data_off &
+	    HAMMER2_OFF_MASK_RADIX)) >> 10) : 0;
+	if (units > 32 || units == 0) {
+		/* not a sub-column size any more: a private column */
+		hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+		return 1;
+	}
+	if (units <= ounits) {
+		/* the range it has is big enough; the radix shrinks */
+		if ((chain->flags & HAMMER2_CHAIN_SUBHELD) == 0) {
+			sc->npending++;
+			atomic_set_int(&chain->flags, HAMMER2_CHAIN_SUBHELD);
+		}
+		hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+		atomic_add_long(&hammer2_rz_subcol_inplace, 1);
+		return 0;
+	}
+	if (hammer2_raid6_subcol_find(sc->used_mask, units, &off)) {
+		sc->used_mask |= (((uint64_t)1 << units) - 1) << off;
+		if ((chain->flags & HAMMER2_CHAIN_SUBHELD) == 0) {
+			sc->npending++;
+			atomic_set_int(&chain->flags, HAMMER2_CHAIN_SUBHELD);
+		}
+		doff = chain->bref.data_off;
+		doff &= ~(hammer2_off_t)((HAMMER2_PBUFSIZE - 1) &
+					 ~HAMMER2_OFF_MASK_RADIX);
+		chain->bref.data_off = doff | ((hammer2_off_t)off << 10);
+		if (sc->used_mask == ~(uint64_t)0)
+			dio = hammer2_raid6_subcol_close_locked(hmp, sc);
+		hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+		if (dio)
+			hammer2_raid6_subcol_drop(sc, dio);
+		atomic_add_long(&hammer2_rz_subcol_chains, 1);
+		return 0;
+	}
+	/* no room to grow: close it, the chain takes a fresh slot */
+	atomic_add_long(&hammer2_rz_subcol_nofit, 1);
+	dio = hammer2_raid6_subcol_close_locked(hmp, sc);
+	hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+	if (dio)
+		hammer2_raid6_subcol_drop(sc, dio);
+	return 1;
+}
+
+/*
+ * Allocate a physical stripe slot for a RAIDZ2-native (v3) data column.
+ * Sets chain->bref.data_off to the physical column offset on the chosen disk
+ * and chain->bref.copyid to the disk index (0..ndisks-1).
+ *
+ * Returns 0 on success, ENOSPC if no free stripe slot is available.
+ *
+ * The caller holds the chain in the appropriate state for modification.
+ * The stripe bitmap spinlock protects concurrent alloc/free.
+ *
+ * With vfs.hammer2.raid6_subcol_max set, a DATA chain of that size or
+ * less shares a column (hammer2_raid6_subcol_alloc); otherwise, and for
+ * everything else, every chain takes a column of its own.
+ */
+int
+hammer2_raid6_stripe_alloc(hammer2_dev_t *hmp, hammer2_chain_t *chain)
+{
+	hammer2_raid_config_t *rc = &hmp->raid_config;
+	struct hammer2_open_row *newrow;
+	struct hammer2_open_row *row;
+	hammer2_off_t phys_off;
+	int disk_idx;
+	int radix;
+	int error;
+	int n;
+
+	/*
+	 * The chain is moving to a new range: it gives back a ticket it
+	 * still holds in the column it is leaving.
+	 */
+	if (chain->flags & HAMMER2_CHAIN_SUBHELD)
+		hammer2_raid6_subcol_done(chain);
+
+	if (hammer2_raid6_subcol_max >= HAMMER2_ALLOC_MIN &&
+	    chain->bref.type == HAMMER2_BREF_TYPE_DATA &&
+	    chain->bytes >= HAMMER2_ALLOC_MIN &&
+	    chain->bytes <= 32768 &&
+	    chain->bytes <= (size_t)hammer2_raid6_subcol_max &&
+	    (chain->bytes & (chain->bytes - 1)) == 0) {
+		error = hammer2_raid6_subcol_alloc(hmp, chain);
+		if (error <= 0)
+			return error;
+	}
+
+	/*
+	 * The open_rows entry for a new row, allocated here because
+	 * kmalloc(M_WAITOK) may sleep and the scan holds a spinlock.
+	 */
+	newrow = kmalloc(sizeof(*newrow), M_HAMMER2, M_WAITOK | M_ZERO);
+	hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+	error = hammer2_raid6_col_reserve_locked(hmp, &newrow, &phys_off,
+						 &disk_idx, &row);
+	hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+	if (newrow)
+		kfree(newrow, M_HAMMER2);
+	if (error)
+		return error;
+
+	/* Compute radix (log2 of chain->bytes) */
+	radix = 0;
+	n = chain->bytes;
+	while (n > 1) { n >>= 1; radix++; }
+
+	/*
+	 * v3 encoding: bref.data_off holds only per-disk phys_off | radix.
+	 * Disk identity lives exclusively in bref.copyid.  The DIO cache
+	 * synthesizes a (disk_idx<<56)|phys_off key at lookup time to keep
+	 * per-disk entries distinct.
+	 */
+	chain->bref.data_off = phys_off |
+	    hammer2_raid6_test_off(hammer2_raid6_slot(phys_off,
+	    rc->stripe_unit), chain->bytes) | (hammer2_off_t)radix;
+	chain->bref.copyid   = (uint8_t)disk_idx;
+	atomic_add_long(&hammer2_rz_cols_alloc, 1);
+
+	return 0;
+}
+
+/*
+ * v3 bulkfree (docs/capacity.md, Freeing).
+ *
+ * Data slots are never freed when a chain is modified or deleted: a
+ * snapshot may still reference the old block, and the tree that drops
+ * it may not be committed yet.  Instead the bulkfree ioctl scans a
+ * snapshot of the committed topology, every PFS and snapshot included,
+ * and hammer2_raid6_bf_mark() records each data slot it references.
+ *
+ * Flushes do not wait for frontend transactions, so a slot allocated
+ * just before the pass may be in no committed tree yet.  Freeing is
+ * therefore two-stage, as in the freemap: a slot that a pass finds
+ * unreferenced is staged, and freed by the next pass if that one finds
+ * it unreferenced too.  A slot allocated while a pass runs
+ * (stripe_bf_new) is kept and unstaged.  The bulkfree ioctl syncs
+ * before every pass, so the two scans see different commits.
+ *
+ * The staged set is in memory only; after a remount the first pass
+ * stages again.
+ *
+ * Liveness is kept per column.  The space map stays per row (one
+ * in-use byte per slot, v1 format, unchanged), because a sealed row's
+ * P/Q cover all its columns and a dead column cannot be reused without
+ * a read-modify-write; so a row is freed when no column of it is live,
+ * exactly as before.  Several chains share a column (sub-columns), and
+ * the column, hence the row, stays until the last of them is gone: the
+ * scan ORs a bit per column (the chain's disk, copyid) into
+ * stripe_bf_seen[slot], and a chain dying only drops out of the next
+ * scan.  The mask is rebuilt by every scan and never written to disk,
+ * so a crash cannot leave it stale and the on-disk map keeps its meaning
+ * for an older kernel.  It gives the count of live and dead columns
+ * (vfs.hammer2.rz_bf_*) and is what a later resilver or scrub can use to
+ * skip dead columns.
+ */
+void
+hammer2_raid6_bf_begin(hammer2_dev_t *hmp)
+{
+	bzero(hmp->stripe_bf_seen, (size_t)hmp->stripe_num_slots);
+	hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+	bzero(hmp->stripe_bf_new, hmp->stripe_bitmap_size);
+	hmp->stripe_bf_active = 1;
+	hmp->stripe_bf_complete = 0;
+	hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+}
+
+/*
+ * Scan callback: record a referenced data slot and return 1, or return
+ * 0 if the blockref is not a v3 data slot.  Only the scan writes
+ * stripe_bf_seen.
+ */
+int
+hammer2_raid6_bf_mark(hammer2_dev_t *hmp, const hammer2_blockref_t *bref)
+{
+	uint64_t slot;
+
+	if (!hammer2_raid6_bref_slot(hmp, bref, &slot))
+		return 0;
+	hmp->stripe_bf_seen[slot] |= HAMMER2_RAID6_BF_COLBIT(bref->copyid);
+	return 1;
+}
+
+/*
+ * End a pass.  If the scan covered the whole committed tree
+ * (stripe_bf_complete, set by hammer2_bulkfree_pass), apply it to the
+ * space map one page at a time.
+ */
+void
+hammer2_raid6_bf_end(hammer2_dev_t *hmp)
+{
+	uint64_t nslots = hmp->stripe_num_slots;
+	uint64_t base;
+	uint64_t slot;
+	uint64_t end;
+	long nfreed = 0;
+	long nstaged = 0;
+	long nfixed = 0;
+	long nrows = 0;
+	long ncols = 0;
+
+	if (hmp->stripe_bf_complete == 0) {
+		hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+		hmp->stripe_bf_active = 0;
+		hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+		kprintf("hammer2: v3 bulkfree: scan incomplete, "
+			"space map unchanged\n");
+		return;
+	}
+
+	for (base = 0; base < nslots; base += HAMMER2_SM_PAGE_SLOTS) {
+		end = base + HAMMER2_SM_PAGE_SLOTS;
+		if (end > nslots)
+			end = nslots;
+		hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+		for (slot = base; slot < end; slot++) {
+			/*
+			 * A row that is still open has columns in flight
+			 * that no committed tree references yet: neither
+			 * free it nor stage it.
+			 */
+			if (isset(hmp->stripe_open, slot))
+				continue;
+			if (hmp->stripe_bf_seen[slot] ||
+			    isset(hmp->stripe_bf_new, slot)) {
+				clrbit(hmp->stripe_bf_staged, slot);
+				if (hmp->stripe_bf_seen[slot]) {
+					++nrows;
+					ncols += bitcount32(
+					    hmp->stripe_bf_seen[slot]);
+				}
+				/*
+				 * Referenced by the committed tree but
+				 * free in the map: take it back.
+				 */
+				if (isclr(hmp->stripe_bitmap, slot) &&
+				    isclr(hmp->stripe_bf_new, slot) &&
+				    hammer2_raid6_slot_is_data(hmp, slot)) {
+					setbit(hmp->stripe_bitmap, slot);
+					hammer2_raid6_sm_touch(hmp, slot);
+					++nfixed;
+				}
+				continue;
+			}
+			if (isclr(hmp->stripe_bitmap, slot)) {
+				clrbit(hmp->stripe_bf_staged, slot);
+				continue;
+			}
+			if (isset(hmp->stripe_bf_staged, slot)) {
+				clrbit(hmp->stripe_bitmap, slot);
+				hmp->rz_free_epoch++;
+				clrbit(hmp->stripe_bf_staged, slot);
+				hammer2_raid6_sm_touch(hmp, slot);
+				++nfreed;
+			} else {
+				setbit(hmp->stripe_bf_staged, slot);
+				++nstaged;
+			}
+		}
+		hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+	}
+	hammer2_spin_ex(&hmp->stripe_bitmap_spin);
+	hmp->stripe_bf_active = 0;
+	hmp->stripe_used_ticks = 0;
+	hammer2_spin_unex(&hmp->stripe_bitmap_spin);
+
+	/*
+	 * A row referenced by the committed tree holds ndata columns, of
+	 * which popcount(mask) are live.  The others are dead: no chain
+	 * is in them (or the row was sealed short), and they stay held
+	 * until the row's last live column dies (no hole reuse, 11.6).
+	 */
+	hammer2_rz_bf_rows_freed += nfreed;
+	hammer2_rz_bf_reclaimed += nfixed;
+	hammer2_rz_bf_rows_live = nrows;
+	hammer2_rz_bf_cols_live = ncols;
+	hammer2_rz_bf_cols_dead =
+	    nrows * (long)hmp->raid_config.ndata - ncols;
+	kprintf("hammer2: v3 bulkfree: %ld rows freed, %ld staged, "
+		"%ld reclaimed; %ld rows live, %ld columns live, "
+		"%ld dead\n", nfreed, nstaged, nfixed, nrows, ncols,
+		hammer2_rz_bf_cols_dead);
+}
