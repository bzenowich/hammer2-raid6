+ * everything else refuses the array rather than misreading it.
+ */
+static void
+hammer2_verify_volumes_3(const hammer2_ondisk_t *fsp,
+			 const hammer2_volume_data_t *rootvoldata)
+{
+	const hammer2_raid_config_t *rc;
+	const hammer2_volume_t *vol;
+	int i, nvolumes = 0;
+
+	if (!hammer2_raid6_ok)
+		errx(1, "RAID6 arrays are not supported by this command");
+	if (rootvoldata == NULL)
+		errx(1, "No root volume header");
+	rc = &rootvoldata->raid_config;
+	if (rc->raid_type != HAMMER2_RAID_TYPE_RAID6)
+		errx(1, "Volume version %d but raid_type is %d",
+		     fsp->version, rc->raid_type);
+
+	for (i = 0; i < HAMMER2_MAX_VOLUMES; ++i) {
+		vol = &fsp->volumes[i];
+		if (vol->id == -1)
+			continue;
+		if (vol->id >= rc->ndisks)
+			errx(1, "%s has disk id %d, array has %d disks",
+			     vol->path, vol->id, rc->ndisks);
+		nvolumes++;
+	}
+	if (nvolumes != rc->ndisks)
+		errx(1, "RAID6 array has %d disks, %d specified",
+		     rc->ndisks, nvolumes);
+	hammer2_raid6_ndisks = rc->ndisks;
