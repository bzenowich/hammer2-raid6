+/* ===== Test 4: Data + P recovery ===== */
+static void
+test_datap_recovery(void)
+{
+	int ndisks, ndata;
+	int prev = tests_run;
+
+	printf("  Test 4: Data + P parity recovery\n");
+
+	for (ndisks = 4; ndisks <= 8; ndisks++) {
+		uint8_t *orig[8];
+		uint8_t *bufs[8];
+		void *ptrs[8];
+		int i, fa;
+
+		ndata = ndisks - 2;
+
+		for (i = 0; i < ndisks; i++) {
+			orig[i] = malloc(TEST_BLOCK_SIZE);
+			bufs[i] = malloc(TEST_BLOCK_SIZE);
+			ptrs[i] = bufs[i];
+		}
+		for (i = 0; i < ndata; i++)
+			fill_random(orig[i], TEST_BLOCK_SIZE, i * 31 + ndisks * 97);
+
+		for (i = 0; i < ndisks; i++)
+			memcpy(bufs[i], orig[i], TEST_BLOCK_SIZE);
+		hammer2_raid6_gen_syndrome(ndisks, TEST_BLOCK_SIZE, ptrs);
+		memcpy(orig[ndisks - 2], bufs[ndisks - 2], TEST_BLOCK_SIZE);
+		memcpy(orig[ndisks - 1], bufs[ndisks - 1], TEST_BLOCK_SIZE);
+
+		/* Fail each data disk + P */
+		for (fa = 0; fa < ndata; fa++) {
+			int p_idx = ndisks - 2;
+
+			for (i = 0; i < ndisks; i++)
+				memcpy(bufs[i], orig[i], TEST_BLOCK_SIZE);
+
+			memset(bufs[fa], 0, TEST_BLOCK_SIZE);
+			memset(bufs[p_idx], 0, TEST_BLOCK_SIZE);
+
+			hammer2_raid6_dual_recov(ndisks, TEST_BLOCK_SIZE,
+			    fa, p_idx, ptrs);
+
+			CHECK(memcmp(bufs[fa], orig[fa], TEST_BLOCK_SIZE) == 0,
+			    "data+P recovery disk %d failed (ndisks=%d)",
+			    fa, ndisks);
+			CHECK(memcmp(bufs[p_idx], orig[p_idx], TEST_BLOCK_SIZE) == 0,
+			    "data+P recovery P failed (ndisks=%d, data fail=%d)",
+			    ndisks, fa);
+		}
+
+		for (i = 0; i < ndisks; i++) {
+			free(orig[i]);
+			free(bufs[i]);
+		}
+	}
+
+	printf("    Data+P recovery: %d tests\n", tests_run - prev);
+}
