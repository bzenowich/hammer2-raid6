+/* ===== Test 6: P + Q recovery (both parity) ===== */
+static void
+test_pq_recovery(void)
+{
+	int ndisks, ndata;
+	int prev = tests_run;
+
+	printf("  Test 6: P + Q parity recovery (regenerate)\n");
+
+	for (ndisks = 4; ndisks <= 8; ndisks++) {
+		uint8_t *orig[8];
+		uint8_t *bufs[8];
+		void *ptrs[8];
+		int i;
+
+		ndata = ndisks - 2;
+
+		for (i = 0; i < ndisks; i++) {
+			orig[i] = malloc(TEST_BLOCK_SIZE);
+			bufs[i] = malloc(TEST_BLOCK_SIZE);
+			ptrs[i] = bufs[i];
+		}
+		for (i = 0; i < ndata; i++)
+			fill_random(orig[i], TEST_BLOCK_SIZE, i * 61 + ndisks * 71);
+
+		for (i = 0; i < ndisks; i++)
+			memcpy(bufs[i], orig[i], TEST_BLOCK_SIZE);
+		hammer2_raid6_gen_syndrome(ndisks, TEST_BLOCK_SIZE, ptrs);
+		memcpy(orig[ndisks - 2], bufs[ndisks - 2], TEST_BLOCK_SIZE);
+		memcpy(orig[ndisks - 1], bufs[ndisks - 1], TEST_BLOCK_SIZE);
+
+		/* Zero out both P and Q */
+		memset(bufs[ndisks - 2], 0, TEST_BLOCK_SIZE);
+		memset(bufs[ndisks - 1], 0, TEST_BLOCK_SIZE);
+
+		hammer2_raid6_dual_recov(ndisks, TEST_BLOCK_SIZE,
+		    ndisks - 2, ndisks - 1, ptrs);
+
+		CHECK(memcmp(bufs[ndisks - 2], orig[ndisks - 2], TEST_BLOCK_SIZE) == 0,
+		    "P+Q recovery P failed (ndisks=%d)", ndisks);
+		CHECK(memcmp(bufs[ndisks - 1], orig[ndisks - 1], TEST_BLOCK_SIZE) == 0,
+		    "P+Q recovery Q failed (ndisks=%d)", ndisks);
+
+		for (i = 0; i < ndisks; i++) {
+			free(orig[i]);
+			free(bufs[i]);
+		}
+	}
+
+	printf("    P+Q recovery: %d tests\n", tests_run - prev);
+}
+
+/* ===== Test 7: Edge cases ===== */
+static void
+test_edge_cases(void)
+{
+	int prev = tests_run;
+
+	printf("  Test 7: Edge cases\n");
+
+	/* All-zero data */
+	{
+		int ndisks = 4;
+		uint8_t *bufs[4];
+		void *ptrs[4];
+		int i;
+
+		for (i = 0; i < ndisks; i++) {
+			bufs[i] = calloc(1, TEST_BLOCK_SIZE);
+			ptrs[i] = bufs[i];
+		}
+
+		hammer2_raid6_gen_syndrome(ndisks, TEST_BLOCK_SIZE, ptrs);
+
+		/* P and Q of all-zero data should be all zeros */
+		{
+			uint8_t *zero = calloc(1, TEST_BLOCK_SIZE);
+			CHECK(memcmp(bufs[2], zero, TEST_BLOCK_SIZE) == 0,
+			    "all-zero data: P not zero");
+			CHECK(memcmp(bufs[3], zero, TEST_BLOCK_SIZE) == 0,
+			    "all-zero data: Q not zero");
+			free(zero);
+		}
+
+		for (i = 0; i < ndisks; i++)
+			free(bufs[i]);
+	}
+
+	/* All-0xFF data */
+	{
+		int ndisks = 4;
+		uint8_t *bufs[4];
+		void *ptrs[4];
+		uint8_t *orig_p, *orig_q;
+		int i;
+
+		for (i = 0; i < ndisks; i++) {
+			bufs[i] = malloc(TEST_BLOCK_SIZE);
+			ptrs[i] = bufs[i];
+		}
+		memset(bufs[0], 0xFF, TEST_BLOCK_SIZE);
+		memset(bufs[1], 0xFF, TEST_BLOCK_SIZE);
+
+		hammer2_raid6_gen_syndrome(ndisks, TEST_BLOCK_SIZE, ptrs);
+
+		/* P = 0xFF ^ 0xFF = 0x00 for 2 data disks */
+		{
+			size_t d;
+			int p_ok = 1;
+			for (d = 0; d < TEST_BLOCK_SIZE; d++) {
+				if (bufs[2][d] != 0x00) {
+					p_ok = 0;
+					break;
+				}
+			}
+			CHECK(p_ok, "all-0xFF P should be 0x00 for 2 data disks");
+		}
+
+		/* Save P, Q, then test recovery */
+		orig_p = malloc(TEST_BLOCK_SIZE);
+		orig_q = malloc(TEST_BLOCK_SIZE);
+		memcpy(orig_p, bufs[2], TEST_BLOCK_SIZE);
+		memcpy(orig_q, bufs[3], TEST_BLOCK_SIZE);
+
+		/* Fail both data disks */
+		memset(bufs[0], 0, TEST_BLOCK_SIZE);
+		memset(bufs[1], 0, TEST_BLOCK_SIZE);
+		hammer2_raid6_dual_recov(ndisks, TEST_BLOCK_SIZE, 0, 1, ptrs);
+		{
+			uint8_t *ff = malloc(TEST_BLOCK_SIZE);
+			memset(ff, 0xFF, TEST_BLOCK_SIZE);
+			CHECK(memcmp(bufs[0], ff, TEST_BLOCK_SIZE) == 0,
+			    "all-0xFF recovery disk 0");
+			CHECK(memcmp(bufs[1], ff, TEST_BLOCK_SIZE) == 0,
+			    "all-0xFF recovery disk 1");
+			free(ff);
+		}
+
+		free(orig_p);
+		free(orig_q);
+		for (i = 0; i < ndisks; i++)
+			free(bufs[i]);
+	}
+
+	/* Single byte blocks */
+	{
+		int ndisks = 4;
+		uint8_t d0 = 0x42, d1 = 0x99;
+		uint8_t p, q;
+		uint8_t *bufs[4];
+		void *ptrs[4];
+		uint8_t orig0, orig1;
+
+		bufs[0] = &d0;
+		bufs[1] = &d1;
+		bufs[2] = &p;
+		bufs[3] = &q;
+		ptrs[0] = bufs[0]; ptrs[1] = bufs[1];
+		ptrs[2] = bufs[2]; ptrs[3] = bufs[3];
+
+		hammer2_raid6_gen_syndrome(4, 1, ptrs);
+
+		CHECK(p == (d0 ^ d1),
+		    "single byte P: got 0x%02x expected 0x%02x",
+		    p, d0 ^ d1);
+
+		/* Q = d0 * 2^0 ^ d1 * 2^1 = d0 ^ mul2(d1) */
+		CHECK(q == (d0 ^ hammer2_gf_mul2(d1)),
+		    "single byte Q: got 0x%02x expected 0x%02x",
+		    q, d0 ^ hammer2_gf_mul2(d1));
+
+		/* Recover from 2 data failures on single byte */
+		orig0 = d0;
+		orig1 = d1;
+		d0 = 0;
+		d1 = 0;
+		hammer2_raid6_dual_recov(4, 1, 0, 1, ptrs);
+		CHECK(d0 == orig0, "single byte recovery d0: got 0x%02x expected 0x%02x",
+		    d0, orig0);
+		CHECK(d1 == orig1, "single byte recovery d1: got 0x%02x expected 0x%02x",
+		    d1, orig1);
+	}
+
+	printf("    Edge cases: %d tests\n", tests_run - prev);
+}
+
+/* ===== Test 8: Large array (max disks) ===== */
+static void
+test_large_array(void)
+{
+	int ndisks = 16;	/* 14 data + 2 parity */
+	int ndata = ndisks - 2;
+	uint8_t *orig[16];
+	uint8_t *bufs[16];
+	void *ptrs[16];
+	int prev = tests_run;
+	int i, fa, fb;
+
+	printf("  Test 8: Large array (%d disks, all 2-failure combos)\n", ndisks);
+
+	for (i = 0; i < ndisks; i++) {
+		orig[i] = malloc(TEST_BLOCK_SIZE);
+		bufs[i] = malloc(TEST_BLOCK_SIZE);
+		ptrs[i] = bufs[i];
+	}
+	for (i = 0; i < ndata; i++)
+		fill_random(orig[i], TEST_BLOCK_SIZE, i * 137 + 42);
+
+	for (i = 0; i < ndisks; i++)
+		memcpy(bufs[i], orig[i], TEST_BLOCK_SIZE);
+	hammer2_raid6_gen_syndrome(ndisks, TEST_BLOCK_SIZE, ptrs);
+	memcpy(orig[ndisks - 2], bufs[ndisks - 2], TEST_BLOCK_SIZE);
+	memcpy(orig[ndisks - 1], bufs[ndisks - 1], TEST_BLOCK_SIZE);
+
+	/* Test all C(16,2) = 120 failure pairs */
+	for (fa = 0; fa < ndisks; fa++) {
+		for (fb = fa + 1; fb < ndisks; fb++) {
+			for (i = 0; i < ndisks; i++)
+				memcpy(bufs[i], orig[i], TEST_BLOCK_SIZE);
+
+			memset(bufs[fa], 0, TEST_BLOCK_SIZE);
+			memset(bufs[fb], 0, TEST_BLOCK_SIZE);
+
+			hammer2_raid6_dual_recov(ndisks, TEST_BLOCK_SIZE,
+			    fa, fb, ptrs);
+
+			CHECK(memcmp(bufs[fa], orig[fa], TEST_BLOCK_SIZE) == 0,
+			    "large array recovery disk %d (fail %d,%d)",
+			    fa, fa, fb);
+			CHECK(memcmp(bufs[fb], orig[fb], TEST_BLOCK_SIZE) == 0,
+			    "large array recovery disk %d (fail %d,%d)",
+			    fb, fa, fb);
+		}
+	}
+
+	for (i = 0; i < ndisks; i++) {
+		free(orig[i]);
+		free(bufs[i]);
+	}
+
+	printf("    Large array: %d tests (%d failure combinations)\n",
+	    tests_run - prev, ndisks * (ndisks - 1) / 2);
+}
+
+/* ===== Main ===== */
+int
+main(int argc, char **argv)
+{
+	clock_t start, end;
+
+	printf("HAMMER2 RAID 6 GF(2^8) Unit Tests\n");
+	printf("==================================\n\n");
+
+	printf("Initializing GF(2^8) tables...\n");
+	start = clock();
+	hammer2_raid6_init();
+	end = clock();
+	printf("  Table init: %.3f ms\n\n",
+	    (double)(end - start) / CLOCKS_PER_SEC * 1000.0);
+
+	printf("Running tests (block size = %d bytes):\n\n", TEST_BLOCK_SIZE);
+
+	test_gf_field_properties();
+	printf("\n");
+	test_syndrome_generation();
+	printf("\n");
+	test_2data_recovery();
+	printf("\n");
+	test_datap_recovery();
+	printf("\n");
+	test_dataq_recovery();
+	printf("\n");
+	test_pq_recovery();
+	printf("\n");
+	test_edge_cases();
+	printf("\n");
+	test_large_array();
+
+	printf("\n==================================\n");
+	printf("Results: %d passed, %d failed, %d total\n",
+	    tests_passed, tests_failed, tests_run);
+
+	if (tests_failed > 0) {
+		printf("SOME TESTS FAILED\n");
+		return 1;
+	}
+	printf("ALL TESTS PASSED\n");
+	return 0;
+}
