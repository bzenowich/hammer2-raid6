+/*
+ * Display RAID status for a HAMMER2 filesystem.
+ * Reads the volume header directly from the device to show the
+ * RAID configuration and disk states.
+ */
+static int
+cmd_raid_status(const char *devpath)
+{
+	hammer2_volume_data_t voldata;
+	hammer2_raid_config_t *rc;
+	int fd, i;
+
+	fd = open(devpath, O_RDONLY);
+	if (fd < 0) {
+		fprintf(stderr, "Cannot open %s: %s\n",
+			devpath, strerror(errno));
+		return 1;
+	}
+	if (hammer2_read_volume_header(fd, devpath, &voldata) < 0) {
+		fprintf(stderr, "Cannot read volume header from %s\n",
+			devpath);
+		close(fd);
+		return 1;
+	}
+	close(fd);
+
+	if (voldata.version < HAMMER2_VOL_VERSION_RAID6) {
+		printf("Filesystem version %d does not support RAID\n",
+		       voldata.version);
+		return 0;
+	}
+
+	rc = &voldata.raid_config;
+	if (rc->raid_type == 0) {
+		printf("RAID type:       JBOD (no RAID)\n");
+		return 0;
+	}
+
+	printf("RAID type:       RAID %d\n", rc->raid_type);
+	printf("Total disks:     %d\n", rc->ndisks);
+	printf("Data disks:      %d\n", rc->ndata);
+	printf("Parity disks:    2 (P + Q)\n");
+	printf("Stripe unit:     %s (%jd bytes)\n",
+	       sizetostr(rc->stripe_unit), (intmax_t)rc->stripe_unit);
+	printf("Array size:      %s (%jd bytes)\n",
+	       sizetostr(rc->array_size), (intmax_t)rc->array_size);
+	printf("Flags:           0x%08x", rc->flags);
+	if (rc->flags & HAMMER2_RAID6_FLAG_DEGRADED)
+		printf(" DEGRADED");
+	if (rc->flags & HAMMER2_RAID6_FLAG_REBUILDING)
+		printf(" REBUILDING");
+	printf("\n");
+
+	printf("\nDisk states:\n");
+	for (i = 0; i < rc->ndisks; i++) {
+		printf("  disk %2d: %s\n", i,
+		       raid_disk_state_str(rc->disk_state[i]));
+	}
+
+	return 0;
