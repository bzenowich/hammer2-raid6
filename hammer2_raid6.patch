+/*
+ * RAID 6 disk replacement (online resilver).
+ *
+ * Identifies the failed disk by matching old_dev against volume paths,
+ * opens new_dev, resilvering all data to it, then atomically swaps it
+ * into the volume array.
+ */
+static int
+hammer2_ioctl_raid_replace(hammer2_inode_t *ip, void *data)
+{
+	hammer2_ioc_raid_replace_t *rr = data;
+	hammer2_dev_t *hmp;
+	struct vnode *new_devvp = NULL;
+	struct nlookupdata nd;
+	int failed_disk_idx = -1;
+	int error;
+	int i;
+
+	hmp = ip->pmp->pfs_hmps[0];
+	if (hmp == NULL)
+		return EINVAL;
+	if (hmp->raid_type != HAMMER2_RAID_TYPE_RAID6)
+		return ENOTSUP;
+
+	/* Ensure path is NUL-terminated */
+	rr->old_dev[sizeof(rr->old_dev) - 1] = 0;
+	rr->new_dev[sizeof(rr->new_dev) - 1] = 0;
+
+	/* Find which disk index matches old_dev */
+	for (i = 0; i < hmp->nvolumes; i++) {
+		if (hmp->volumes[i].dev->path &&
+		    strcmp(hmp->volumes[i].dev->path, rr->old_dev) == 0) {
+			failed_disk_idx = i;
+			break;
+		}
+	}
+	if (failed_disk_idx < 0) {
+		kprintf("hammer2: raid replace: %s not found in array\n",
+			rr->old_dev);
+		return ENOENT;
+	}
+
+	/* Open the replacement device */
+	error = nlookup_init(&nd, rr->new_dev, UIO_SYSSPACE, NLC_FOLLOW);
+	if (error == 0)
+		error = nlookup(&nd);
+	if (error == 0)
+		error = cache_vref(&nd.nl_nch, nd.nl_cred, &new_devvp);
+	nlookup_done(&nd);
+	if (error) {
+		kprintf("hammer2: raid replace: cannot open %s: %d\n",
+			rr->new_dev, error);
+		return error;
+	}
+	if (!vn_isdisk(new_devvp, &error)) {
+		vrele(new_devvp);
+		return error;
+	}
+
+	/* Open the device for writing */
+	vn_lock(new_devvp, LK_EXCLUSIVE | LK_RETRY);
+	error = VOP_OPEN(new_devvp, FREAD | FWRITE, FSCRED, NULL);
+	vn_unlock(new_devvp);
+	if (error) {
+		vrele(new_devvp);
+		kprintf("hammer2: raid replace: cannot open %s: %d\n",
+			rr->new_dev, error);
+		return error;
+	}
+
+	kprintf("hammer2: RAID6 resilver disk %d (%s) -> %s\n",
+		failed_disk_idx, rr->old_dev, rr->new_dev);
+
+	/* Run the resilver (this may take a long time) */
+	error = hammer2_io_raid6_resilver(hmp, failed_disk_idx, new_devvp);
+	if (error) {
+		kprintf("hammer2: resilver failed: %d\n", error);
+		VOP_CLOSE(new_devvp, FREAD | FWRITE, NULL);
+		vrele(new_devvp);
+		return error;
+	}
+
+	/*
+	 * Atomically swap the volume entry to point at the new device.
+	 * Update the in-memory RAID state.
+	 */
+	hammer2_voldata_lock(hmp);
+
+	/* Close old device if it is still open (may be failed/gone) */
+	if (hmp->volumes[failed_disk_idx].dev->open) {
+		VOP_CLOSE(hmp->volumes[failed_disk_idx].dev->devvp,
+			  FREAD | FWRITE, NULL);
+		hmp->volumes[failed_disk_idx].dev->open = 0;
+	}
+
+	hmp->volumes[failed_disk_idx].dev->devvp = new_devvp;
+	if (hmp->volumes[failed_disk_idx].dev->path) {
+		kfree(hmp->volumes[failed_disk_idx].dev->path, M_HAMMER2);
+	}
+	hmp->volumes[failed_disk_idx].dev->path =
+		kstrdup(rr->new_dev, M_HAMMER2);
+	hmp->volumes[failed_disk_idx].dev->open = 1;
+
+	/* Update DIO devvp for any cached DIOs on old device (best-effort) */
+
+	/* Clear failure state */
+	if (hmp->raid_failed[failed_disk_idx]) {
+		hmp->raid_failed[failed_disk_idx] = 0;
+		atomic_add_int(&hmp->raid_nfailed, -1);
+	}
+
+	/* Update on-disk RAID config disk state */
+	hmp->raid_config.disk_state[failed_disk_idx] =
+		HAMMER2_RAID6_DISK_ONLINE;
+	hammer2_voldata_modify(hmp);
+
+	hammer2_voldata_unlock(hmp);
+
+	/* Flush the updated config to all disks */
+	hammer2_vfs_sync(ip->pmp->mp, MNT_WAIT);
+
+	kprintf("hammer2: RAID6 resilver disk %d complete\n", failed_disk_idx);
+	rr->error = 0;
+	rr->progress = 100;
+
+	return 0;
+}
+
+/*
+ * Mark a RAID6 disk as failed from userspace.
+ *
+ * After this call the kernel stops submitting I/O to that device.
+ * The device can then be detached (e.g. vnconfig -u) without EBUSY.
+ * Use HAMMER2IOC_RAID_REPLACE to resilver onto a replacement disk.
+ */
+static int
+hammer2_ioctl_raid_fail_disk(hammer2_inode_t *ip, void *data)
+{
+	hammer2_ioc_raid_fail_disk_t *rfd = data;
+	hammer2_dev_t *hmp;
+	int i;
+
+	hmp = ip->pmp->pfs_hmps[0];
+	if (hmp == NULL)
+		return EINVAL;
+	if (hmp->raid_type != HAMMER2_RAID_TYPE_RAID6)
+		return ENOTSUP;
+	if (hmp->raid_nfailed >= 2) {
+		kprintf("hammer2: raid fail-disk: already %d disk(s) failed, "
+			"cannot tolerate more\n", hmp->raid_nfailed);
+		return ENXIO;
+	}
+
+	rfd->dev[sizeof(rfd->dev) - 1] = 0;
+
+	for (i = 0; i < hmp->nvolumes; i++) {
+		if (hmp->volumes[i].dev->path == NULL)
+			continue;
+		if (strcmp(hmp->volumes[i].dev->path, rfd->dev) != 0)
+			continue;
+
+		if (!hmp->raid_failed[i]) {
+			hmp->raid_failed[i] = 1;
+			atomic_add_int(&hmp->raid_nfailed, 1);
+			/* Update on-disk disk_state */
+			hammer2_voldata_lock(hmp);
+			hmp->raid_config.disk_state[i] =
+				HAMMER2_RAID6_DISK_FAILED;
+			hmp->raid_config.flags |= HAMMER2_RAID6_FLAG_DEGRADED;
+			hammer2_voldata_modify(hmp);
+			hammer2_voldata_unlock(hmp);
+			/*
+			 * Release the open file reference on the failed disk.
+			 * This allows the block device to be detached
+			 * (e.g. vnconfig -u) without EBUSY.
+			 * The vnode itself remains valid (still referenced
+			 * via dev->devvp), so getblk() still works for
+			 * degraded reconstruction buffers.
+			 */
+			if (hmp->volumes[i].dev->open) {
+				vn_lock(hmp->volumes[i].dev->devvp,
+					LK_EXCLUSIVE | LK_RETRY);
+				VOP_CLOSE(hmp->volumes[i].dev->devvp,
+					  FREAD | FWRITE, NULL);
+				vn_unlock(hmp->volumes[i].dev->devvp);
+				hmp->volumes[i].dev->open = 0;
+			}
+			kprintf("hammer2: RAID6 disk %d (%s) marked failed; "
+				"operating in degraded mode\n",
+				i, rfd->dev);
+		} else {
+			kprintf("hammer2: RAID6 disk %d (%s) already failed\n",
+				i, rfd->dev);
+		}
+		rfd->disk_idx = i;
+		return 0;
+	}
+
+	kprintf("hammer2: raid fail-disk: %s not found in array\n", rfd->dev);
+	return ENOENT;
+}
+
+/*
+ * Query resilver progress.
+ *
+ * Returns the current resilver state from hmp without blocking.
+ * Safe to call while HAMMER2IOC_RAID_REPLACE is running in another thread.
+ * The stripes_done counter is updated by the resilver loop every 256 stripes.
+ */
+static int
+hammer2_ioctl_resilver_status(hammer2_inode_t *ip, void *data)
+{
+	hammer2_ioc_resilver_status_t *rs = data;
+	hammer2_dev_t *hmp;
+	uint64_t done, total;
+
+	hmp = ip->pmp->pfs_hmps[0];
+	if (hmp == NULL)
+		return EINVAL;
+	if (hmp->raid_type != HAMMER2_RAID_TYPE_RAID6)
+		return ENOTSUP;
+
+	/*
+	 * Snapshot the volatile counters.  No lock needed: the resilver
+	 * loop only writes these fields, we only read them.  A slightly
+	 * stale value is acceptable for a progress display.
+	 */
+	rs->running   = hmp->resilver_running;
+	rs->disk_idx  = hmp->resilver_disk_idx;
+	done          = hmp->resilver_stripes_done;
+	total         = hmp->resilver_stripes_total;
+	rs->stripes_done  = done;
+	rs->stripes_total = total;
+	rs->error     = 0;
+
+	if (total == 0 || !rs->running) {
+		rs->progress = rs->running ? 0 : 100;
+	} else {
+		rs->progress = (int)((done * 100) / total);
+		if (rs->progress > 99)
+			rs->progress = 99; /* reserve 100 for completion */
+	}
+
+	return 0;
+}
