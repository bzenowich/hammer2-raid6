+#include "hammer2.h"
+
+static const char *
+raid_disk_state_str(uint8_t state)
+{
+	switch (state) {
+	case HAMMER2_RAID6_DISK_ONLINE:
+		return "online";
+	case HAMMER2_RAID6_DISK_FAILED:
+		return "FAILED";
+	case HAMMER2_RAID6_DISK_REBUILDING:
+		return "rebuilding";
+	case HAMMER2_RAID6_DISK_SPARE:
+		return "spare";
+	default:
+		return "unknown";
+	}
+}
+
+/*
+ * Display RAID status for a HAMMER2 filesystem.
+ * Reads the volume header directly from the device to show the
+ * RAID configuration and disk states.
+ */
+static int
+cmd_raid_status(const char *devpath)
+{
+	hammer2_volume_data_t voldata;
+	hammer2_raid_config_t *rc;
+	int fd, i;
+
+	fd = open(devpath, O_RDONLY);
+	if (fd < 0) {
+		fprintf(stderr, "Cannot open %s: %s\n",
+			devpath, strerror(errno));
+		return 1;
+	}
+	if (hammer2_read_volume_header(fd, devpath, &voldata) < 0) {
+		fprintf(stderr, "Cannot read volume header from %s\n",
+			devpath);
+		close(fd);
+		return 1;
+	}
+	close(fd);
+
+	if (voldata.version < HAMMER2_VOL_VERSION_RAID6) {
+		printf("Filesystem version %d does not support RAID\n",
+		       voldata.version);
+		return 0;
+	}
+
+	rc = &voldata.raid_config;
+	if (rc->raid_type == 0) {
+		printf("RAID type:       JBOD (no RAID)\n");
+		return 0;
+	}
+
+	printf("RAID type:       RAID %d\n", rc->raid_type);
+	printf("Total disks:     %d\n", rc->ndisks);
+	printf("Data disks:      %d\n", rc->ndata);
+	printf("Parity disks:    2 (P + Q)\n");
+	printf("Stripe unit:     %s (%jd bytes)\n",
+	       sizetostr(rc->stripe_unit), (intmax_t)rc->stripe_unit);
+	printf("Array size:      %s (%jd bytes)\n",
+	       sizetostr(rc->array_size), (intmax_t)rc->array_size);
+	printf("Flags:           0x%08x", rc->flags);
+	if (rc->flags & HAMMER2_RAID6_FLAG_DEGRADED)
+		printf(" DEGRADED");
+	if (rc->flags & HAMMER2_RAID6_FLAG_REBUILDING)
+		printf(" REBUILDING");
+	printf("\n");
+
+	printf("\nDisk states:\n");
+	for (i = 0; i < rc->ndisks; i++) {
+		printf("  disk %2d: %s\n", i,
+		       raid_disk_state_str(rc->disk_state[i]));
+	}
+
+	return 0;
+}
+
+/*
+ * Explicitly mark a RAID6 disk as failed.
+ * After this call the kernel stops submitting I/O to the device, so it
+ * can be detached (e.g. vnconfig -u) without EBUSY.
+ * The filesystem continues to operate in degraded mode.
+ */
+static int
+cmd_raid_fail_disk(const char *sel_path, const char *dev)
+{
+	hammer2_ioc_raid_fail_disk_t rfd;
+	int fd;
+
+	fd = hammer2_ioctl_handle(sel_path);
+	if (fd < 0)
+		return 1;
+
+	bzero(&rfd, sizeof(rfd));
+	snprintf(rfd.dev, sizeof(rfd.dev), "%s", dev);
+
+	if (ioctl(fd, HAMMER2IOC_RAID_FAIL_DISK, &rfd) < 0) {
+		fprintf(stderr, "raid fail-disk: ioctl failed: %s\n",
+			strerror(errno));
+		close(fd);
+		return 1;
+	}
+	close(fd);
+
+	printf("Disk %s (index %d) marked as failed.\n", dev, rfd.disk_idx);
+	printf("Filesystem is operating in degraded mode.\n");
+	printf("You may now detach the device, then run:\n");
+	printf("  hammer2 -s <mountpoint> raid replace %s <new_dev>\n", dev);
+	return 0;
+}
+
+/*
+ * Online resilver: replace a failed RAID6 disk with a new one.
+ * The filesystem must be mounted.  The ioctl reconstructs all data
+ * from surviving disks and parity, then atomically swaps in the new disk.
+ */
+static int
+cmd_raid_replace(const char *sel_path, const char *old_dev,
+		 const char *new_dev)
+{
+	hammer2_ioc_raid_replace_t rr;
+	int fd;
+
+	fd = hammer2_ioctl_handle(sel_path);
+	if (fd < 0)
+		return 1;
+
+	bzero(&rr, sizeof(rr));
+	snprintf(rr.old_dev, sizeof(rr.old_dev), "%s", old_dev);
+	snprintf(rr.new_dev, sizeof(rr.new_dev), "%s", new_dev);
+
+	if (ioctl(fd, HAMMER2IOC_RAID_REPLACE, &rr) < 0) {
+		fprintf(stderr, "raid replace: ioctl failed: %s\n",
+			strerror(errno));
+		close(fd);
+		return 1;
+	}
+	close(fd);
+
+	printf("Resilver complete: disk %s replaced by %s\n",
+	       old_dev, new_dev);
+	return 0;
+}
+
+/*
+ * Query resilver progress from the running kernel.
+ * Prints a single human-readable line; also suitable for polling from
+ * a Web UI (add -j for JSON output once needed).
+ */
+static int
+cmd_raid_resilver_status(const char *sel_path)
+{
+	hammer2_ioc_resilver_status_t rs;
+	int fd;
+
+	fd = hammer2_ioctl_handle(sel_path);
+	if (fd < 0)
+		return 1;
+
+	bzero(&rs, sizeof(rs));
+	if (ioctl(fd, HAMMER2IOC_RAID_RESILVER_STATUS, &rs) < 0) {
+		fprintf(stderr, "raid resilver-status: ioctl failed: %s\n",
+			strerror(errno));
+		close(fd);
+		return 1;
+	}
+	close(fd);
+
+	if (!rs.running) {
+		printf("resilver: idle (no resilver in progress)\n");
+	} else {
+		printf("resilver: disk %d  %llu / %llu stripes  %d%%\n",
+		       rs.disk_idx,
+		       (unsigned long long)rs.stripes_done,
+		       (unsigned long long)rs.stripes_total,
+		       rs.progress);
+	}
+	return 0;
+}
+
+/*
+ * Dispatch RAID subcommands.
+ */
+int
+cmd_raid(const char *sel_path, int ac, const char **av)
+{
+	if (ac < 1) {
+		fprintf(stderr,
+			"raid: missing subcommand\n"
+			"    raid status <devpath>           "
+				"Show RAID status\n"
+			"    raid fail-disk <dev>            "
+				"Mark a disk failed (degraded mode)\n"
+			"    raid replace <old> <new>        "
+				"Replace a failed disk (online resilver)\n"
+			"    raid resilver-status            "
+				"Query resilver progress\n");
+		return 1;
+	}
+
+	if (strcmp(av[0], "status") == 0) {
+		if (ac < 2) {
+			fprintf(stderr, "raid status: requires device path\n");
+			return 1;
+		}
+		return cmd_raid_status(av[1]);
+	} else if (strcmp(av[0], "fail-disk") == 0) {
+		if (ac < 2) {
+			fprintf(stderr, "raid fail-disk: requires <dev>\n");
+			return 1;
+		}
+		return cmd_raid_fail_disk(sel_path, av[1]);
+	} else if (strcmp(av[0], "replace") == 0) {
+		if (ac < 3) {
+			fprintf(stderr,
+				"raid replace: requires <old_dev> <new_dev>\n");
+			return 1;
+		}
+		return cmd_raid_replace(sel_path, av[1], av[2]);
+	} else if (strcmp(av[0], "resilver-status") == 0) {
+		return cmd_raid_resilver_status(sel_path);
+	} else {
+		fprintf(stderr, "raid: unknown subcommand '%s'\n", av[0]);
+		fprintf(stderr,
+			"    raid status <devpath>           "
+				"Show RAID status\n"
+			"    raid fail-disk <dev>            "
+				"Mark a disk failed (degraded mode)\n"
+			"    raid replace <old> <new>        "
+				"Replace a failed disk (online resilver)\n"
+			"    raid resilver-status            "
+				"Query resilver progress\n");
+		return 1;
+	}
+}
