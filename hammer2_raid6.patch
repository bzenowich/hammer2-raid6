+/* ===== Test 3: Two data disk recovery ===== */
+static void
+test_2data_recovery(void)
+{
+	int ndisks, ndata;
+	int prev = tests_run;
+
+	printf("  Test 3: Two data disk recovery (all combinations)\n");
+
+	for (ndisks = 4; ndisks <= 8; ndisks++) {
+		uint8_t *orig[8];
+		uint8_t *bufs[8];
+		void *ptrs[8];
+		int i, fa, fb;
+
+		ndata = ndisks - 2;
+
+		/* Allocate original data and working copies */
+		for (i = 0; i < ndisks; i++) {
+			orig[i] = malloc(TEST_BLOCK_SIZE);
+			bufs[i] = malloc(TEST_BLOCK_SIZE);
+			ptrs[i] = bufs[i];
+		}
+		for (i = 0; i < ndata; i++)
+			fill_random(orig[i], TEST_BLOCK_SIZE, i * 7 + ndisks * 13);
+
+		/* Generate reference P and Q */
+		for (i = 0; i < ndisks; i++)
+			memcpy(bufs[i], orig[i], TEST_BLOCK_SIZE);
+		hammer2_raid6_gen_syndrome(ndisks, TEST_BLOCK_SIZE, ptrs);
+		/* Save computed P and Q as original */
+		memcpy(orig[ndisks - 2], bufs[ndisks - 2], TEST_BLOCK_SIZE);
+		memcpy(orig[ndisks - 1], bufs[ndisks - 1], TEST_BLOCK_SIZE);
+
+		/* Test every pair of data disk failures */
+		for (fa = 0; fa < ndata; fa++) {
+			for (fb = fa + 1; fb < ndata; fb++) {
+				/* Restore all disks */
+				for (i = 0; i < ndisks; i++)
+					memcpy(bufs[i], orig[i], TEST_BLOCK_SIZE);
+
+				/* Zero out failed disks */
+				memset(bufs[fa], 0, TEST_BLOCK_SIZE);
+				memset(bufs[fb], 0, TEST_BLOCK_SIZE);
+
+				/* Recover */
+				hammer2_raid6_dual_recov(ndisks, TEST_BLOCK_SIZE,
+				    fa, fb, ptrs);
+
+				CHECK(memcmp(bufs[fa], orig[fa], TEST_BLOCK_SIZE) == 0,
+				    "2data recovery disk %d failed (ndisks=%d, fail=%d,%d)",
+				    fa, ndisks, fa, fb);
+				CHECK(memcmp(bufs[fb], orig[fb], TEST_BLOCK_SIZE) == 0,
+				    "2data recovery disk %d failed (ndisks=%d, fail=%d,%d)",
+				    fb, ndisks, fa, fb);
+			}
+		}
+
+		for (i = 0; i < ndisks; i++) {
+			free(orig[i]);
+			free(bufs[i]);
+		}
+	}
+
+	printf("    2-data recovery: %d tests\n", tests_run - prev);
+}
