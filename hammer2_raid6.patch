+	snprintf(rfd.dev, sizeof(rfd.dev), "%s", dev);
+
+	if (ioctl(fd, HAMMER2IOC_RAID_FAIL_DISK, &rfd) < 0) {
+		fprintf(stderr, "raid fail-disk: ioctl failed: %s\n",
+			strerror(errno));
+		close(fd);
+		return 1;
+	}
+	close(fd);
+
+	printf("Disk %s (index %d) marked as failed.\n", dev, rfd.disk_idx);
+	printf("Filesystem is operating in degraded mode.\n");
+	printf("You may now detach the device, then run:\n");
+	printf("  hammer2 -s <mountpoint> raid replace %s <new_dev>\n", dev);
+	return 0;
+}
+
+/*
+ * Online resilver: replace a failed RAID6 disk with a new one.
+ * The filesystem must be mounted.  The ioctl reconstructs all data
+ * from surviving disks and parity, then atomically swaps in the new disk.
+ */
+static int
+cmd_raid_replace(const char *sel_path, const char *old_dev,
+		 const char *new_dev)
+{
+	hammer2_ioc_raid_replace_t rr;
+	int fd;
+
+	fd = hammer2_ioctl_handle(sel_path);
+	if (fd < 0)
+		return 1;
+
+	bzero(&rr, sizeof(rr));
+	snprintf(rr.old_dev, sizeof(rr.old_dev), "%s", old_dev);
+	snprintf(rr.new_dev, sizeof(rr.new_dev), "%s", new_dev);
+
+	if (ioctl(fd, HAMMER2IOC_RAID_REPLACE, &rr) < 0) {
+		fprintf(stderr, "raid replace: ioctl failed: %s\n",
+			strerror(errno));
+		close(fd);
+		return 1;
+	}
+	close(fd);
+
+	printf("Resilver complete: disk %s replaced by %s\n",
+	       old_dev, new_dev);
+	return 0;
+}
+
+/*
+ * Query resilver progress from the running kernel.
+ * Prints a single human-readable line; also suitable for polling from
+ * a Web UI (add -j for JSON output once needed).
+ */
+static int
+cmd_raid_resilver_status(const char *sel_path)
+{
+	hammer2_ioc_resilver_status_t rs;
+	int fd;
+
+	fd = hammer2_ioctl_handle(sel_path);
+	if (fd < 0)
+		return 1;
+
+	bzero(&rs, sizeof(rs));
+	if (ioctl(fd, HAMMER2IOC_RAID_RESILVER_STATUS, &rs) < 0) {
+		fprintf(stderr, "raid resilver-status: ioctl failed: %s\n",
+			strerror(errno));
+		close(fd);
+		return 1;
+	}
+	close(fd);
+
+	if (!rs.running) {
+		printf("resilver: idle (no resilver in progress)\n");
+	} else {
+		printf("resilver: disk %d  %llu / %llu stripes  %d%%\n",
+		       rs.disk_idx,
+		       (unsigned long long)rs.stripes_done,
+		       (unsigned long long)rs.stripes_total,
+		       rs.progress);
+	}
+	return 0;
+}
+
+/*
+ * Dispatch RAID subcommands.
+ */
+int
+cmd_raid(const char *sel_path, int ac, const char **av)
+{
+	if (ac < 1) {
+		fprintf(stderr,
+			"raid: missing subcommand\n"
+			"    raid status <devpath>           "
+				"Show RAID status\n"
+			"    raid fail-disk <dev>            "
+				"Mark a disk failed (degraded mode)\n"
+			"    raid replace <old> <new>        "
+				"Replace a failed disk (online resilver)\n"
+			"    raid resilver-status            "
+				"Query resilver progress\n");
+		return 1;
+	}
+
+	if (strcmp(av[0], "status") == 0) {
+		if (ac < 2) {
+			fprintf(stderr, "raid status: requires device path\n");
+			return 1;
+		}
+		return cmd_raid_status(av[1]);
+	} else if (strcmp(av[0], "fail-disk") == 0) {
+		if (ac < 2) {
+			fprintf(stderr, "raid fail-disk: requires <dev>\n");
+			return 1;
+		}
+		return cmd_raid_fail_disk(sel_path, av[1]);
+	} else if (strcmp(av[0], "replace") == 0) {
+		if (ac < 3) {
+			fprintf(stderr,
+				"raid replace: requires <old_dev> <new_dev>\n");
+			return 1;
+		}
+		return cmd_raid_replace(sel_path, av[1], av[2]);
+	} else if (strcmp(av[0], "resilver-status") == 0) {
+		return cmd_raid_resilver_status(sel_path);
+	} else {
+		fprintf(stderr, "raid: unknown subcommand '%s'\n", av[0]);
+		fprintf(stderr,
+			"    raid status <devpath>           "
+				"Show RAID status\n"
+			"    raid fail-disk <dev>            "
+				"Mark a disk failed (degraded mode)\n"
+			"    raid replace <old> <new>        "
+				"Replace a failed disk (online resilver)\n"
+			"    raid resilver-status            "
+				"Query resilver progress\n");
+		return 1;
+	}
+}
