+	/* check initialized volume count */
+	for (i = 0; i < HAMMER2_MAX_VOLUMES; ++i) {
+		vol = &volumes[i];
+		if (vol->id != -1) {
+			nvolumes++;
+			if (vol->size < min_size)
+				min_size = vol->size;
+		}
+	}
