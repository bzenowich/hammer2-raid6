diff --git a/sbin/hammer2/cmd_raid.c b/sbin/hammer2/cmd_raid.c
new file mode 100644
index 0000000..8e2d554
--- /dev/null
+++ b/sbin/hammer2/cmd_raid.c
@@ -0,0 +1,508 @@
+/*
+ * v3 RAIDZ2-native userspace front-end for the RAID6 ioctls.
+ *
+ * Subcommands:
+ *   raid status
+ *	HAMMER2IOC_RAID_RESILVER_STATUS
+ *   raid fail-disk <dev>
+ *	HAMMER2IOC_RAID_FAIL_DISK — stop kernel I/O to <dev>, leaving the
+ *	array degraded.  Idempotent if already failed.
+ *   raid replace <old> <new>
+ *	HAMMER2IOC_RAID_REPLACE — synchronous online resilver of <old>'s
+ *	stripe positions onto <new>.  Same path for both args is the
+ *	"reattach the same slot" case used by the test suite.
+ *   raid stats [-z] [-p] [<mountpoint>]
+ *	HAMMER2IOC_RAID_STATS — per-mount I/O counters: per-disk read and
+ *	write ops/bytes by class, row seal counts, new_preread, degraded
+ *	reads, self-heal queue, resilver slots.  -z zeroes the counters
+ *	after reading them (root).  -p prints one "name value" line per
+ *	counter for scripts instead of the table.
+ *   raid scrub [-n] [-t | -p]
+ *	HAMMER2IOC_RAID_SCRUB — walk every live DATA/DIRENT bref, verify
+ *	the CHECK code, parity-repair on mismatch; then read every
+ *	allocated row in disk order and check P and Q (rows_checked,
+ *	parity_bad, parity_repaired, parity_unlocatable).  -t skips the
+ *	parity pass (checksum walk only); -p skips the checksum walk
+ *	(parity pass only).  Default is blocking;
+ *	with -n, forks a child to run the blocking ioctl and polls
+ *	HAMMER2IOC_RAID_SCRUB_STATUS from the parent for live progress.
+ */
+
+#include "hammer2.h"
+
+#include <sys/wait.h>
+#include <unistd.h>
+
+int cmd_raid(const char *sel_path, int ac, const char **av);
+
+static int raid_scrub_blocking(const char *sel_path, uint32_t flags);
+
+static int
+raid_status(const char *sel_path)
+{
+	struct hammer2_ioc_resilver_status st;
+	int fd;
+	int rc;
+
+	fd = hammer2_ioctl_handle(sel_path);
+	if (fd < 0)
+		return 1;
+	bzero(&st, sizeof(st));
+	rc = ioctl(fd, HAMMER2IOC_RAID_RESILVER_STATUS, &st);
+	close(fd);
+	if (rc < 0) {
+		fprintf(stderr, "raid status: %s\n", strerror(errno));
+		return 1;
+	}
+	printf("running:        %d\n", st.running);
+	printf("disk_idx:       %d\n", st.disk_idx);
+	printf("progress:       %d%%\n", st.progress);
+	printf("stripes_done:   %llu\n", (unsigned long long)st.stripes_done);
+	printf("stripes_total:  %llu\n", (unsigned long long)st.stripes_total);
+	printf("error:          %d\n", st.error);
+	printf("ndisks:         %u\n", st.ndisks);
+	{
+		uint32_t i;
+		for (i = 0; i < st.ndisks && i < HAMMER2_MAX_VOLUMES; i++) {
+			const char *label;
+			switch (st.disk_state[i]) {
+			case HAMMER2_RAID6_DISK_FAILED:
+				label = "FAILED";
+				break;
+			case HAMMER2_RAID6_DISK_ONLINE:
+				label = "ONLINE";
+				break;
+			default:
+				label = "UNKNOWN";
+				break;
+			}
+			printf("disk[%u]:        %-8s cksum_err %llu  "
+			       "healed %llu  unrepairable %llu\n", i, label,
+			       (unsigned long long)st.cksum_errors[i],
+			       (unsigned long long)st.cksum_healed[i],
+			       (unsigned long long)st.cksum_unrepairable[i]);
+		}
+	}
+	printf("selfheal_writes: %llu done, %llu dropped\n",
+	       (unsigned long long)st.selfheal_writes_done,
+	       (unsigned long long)st.selfheal_writes_dropped);
+	return 0;
+}
+
+static const char *const rstat_cls[HAMMER2_RSC_NCLASS] = {
+	"data", "meta", "P", "Q", "zero", "mmirror", "volhdr",
+	"resilver", "scrub", "degraded", "selfheal", "other"
+};
+
+static void
+rstat_hum(char *buf, size_t len, uint64_t v)
+{
+	if (v >= (1ULL << 30))
+		snprintf(buf, len, "%.1fG", (double)v / (1 << 30));
+	else if (v >= (1ULL << 20))
+		snprintf(buf, len, "%.1fM", (double)v / (1 << 20));
+	else if (v >= (1ULL << 10))
+		snprintf(buf, len, "%.1fK", (double)v / (1 << 10));
+	else
+		snprintf(buf, len, "%llu", (unsigned long long)v);
+}
+
+static int
+raid_stats(const char *sel_path, int zero, int parse)
+{
+	struct hammer2_ioc_raid_stats st;
+	struct hammer2_raid_stat_disk *dk;
+	char b1[32], b2[32];
+	uint32_t i, c;
+	int fd;
+	int rc;
+	int w;
+
+	dk = calloc(HAMMER2_MAX_VOLUMES, sizeof(*dk));
+	if (dk == NULL) {
+		fprintf(stderr, "raid stats: out of memory\n");
+		return 1;
+	}
+	fd = hammer2_ioctl_handle(sel_path);
+	if (fd < 0) {
+		free(dk);
+		return 1;
+	}
+	bzero(&st, sizeof(st));
+	st.version = HAMMER2_RSTAT_VERSION;
+	st.size = sizeof(st);
+	st.disk_size = sizeof(*dk);
+	st.disks_max = HAMMER2_MAX_VOLUMES;
+	st.disks = dk;
+	st.flags = zero ? HAMMER2_RSTAT_ZERO : 0;
+	rc = ioctl(fd, HAMMER2IOC_RAID_STATS, &st);
+	close(fd);
+	if (rc < 0) {
+		if (errno == EINVAL)
+			fprintf(stderr, "raid stats: tool and kernel disagree "
+			    "(tool version %u size %zu, kernel version %u "
+			    "size %u): rebuild hammer2 and the module "
+			    "from the same tree\n", HAMMER2_RSTAT_VERSION,
+			    sizeof(st), st.version, st.size);
+		else
+			fprintf(stderr, "raid stats: %s\n", strerror(errno));
+		free(dk);
+		return 1;
+	}
+
+	if (parse) {
+		for (i = 0; i < st.ndisks; i++) {
+			for (c = 0; c < HAMMER2_RSC_NCLASS; c++) {
+				printf("rd_ops.%u.%s %llu\n", i, rstat_cls[c],
+				    (unsigned long long)dk[i].rd_ops[c]);
+				printf("rd_bytes.%u.%s %llu\n", i, rstat_cls[c],
+				    (unsigned long long)dk[i].rd_bytes[c]);
+				printf("wr_ops.%u.%s %llu\n", i, rstat_cls[c],
+				    (unsigned long long)dk[i].wr_ops[c]);
+				printf("wr_bytes.%u.%s %llu\n", i, rstat_cls[c],
+				    (unsigned long long)dk[i].wr_bytes[c]);
+			}
+		}
+#define P(f) printf(#f " %llu\n", (unsigned long long)st.f)
+		printf("ndisks %u\n", st.ndisks);
+		P(new_preread); P(new_preread_meta);
+		P(degraded_read_1); P(degraded_read_2);
+		P(selfheal_queued); P(selfheal_done); P(selfheal_dropped);
+		P(seal_full); P(seal_flush); P(seal_partial);
+		P(open_rows_cur); P(open_rows_high);
+		P(resilver_slots_copied); P(resilver_slots_skipped);
+#undef P
+		free(dk);
+		return 0;
+	}
+
+	for (w = 0; w < 2; w++) {
+		printf("%s (ops/bytes since %s)\n",
+		    w ? "writes" : "reads", zero ? "last zero" : "mount");
+		printf("%-5s", "disk");
+		for (c = 0; c < HAMMER2_RSC_NCLASS; c++)
+			printf(" %15s", rstat_cls[c]);
+		printf("\n");
+		for (i = 0; i < st.ndisks; i++) {
+			printf("%-5u", i);
+			for (c = 0; c < HAMMER2_RSC_NCLASS; c++) {
+				char cell[40];
+				uint64_t ops = w ? dk[i].wr_ops[c] :
+				    dk[i].rd_ops[c];
+				uint64_t by = w ? dk[i].wr_bytes[c] :
+				    dk[i].rd_bytes[c];
+
+				if (ops == 0) {
+					printf(" %15s", "-");
+					continue;
+				}
+				rstat_hum(b1, sizeof(b1), ops);
+				rstat_hum(b2, sizeof(b2), by);
+				snprintf(cell, sizeof(cell), "%s/%s", b1, b2);
+				printf(" %15s", cell);
+			}
+			printf("\n");
+		}
+		printf("\n");
+	}
+	printf("new_preread:       %llu   (must stay 0; metadata: %llu)\n",
+	    (unsigned long long)st.new_preread,
+	    (unsigned long long)st.new_preread_meta);
+	printf("degraded_read:     1 erasure %llu, 2 erasures %llu\n",
+	    (unsigned long long)st.degraded_read_1,
+	    (unsigned long long)st.degraded_read_2);
+	printf("selfheal:          queued %llu, done %llu, dropped %llu\n",
+	    (unsigned long long)st.selfheal_queued,
+	    (unsigned long long)st.selfheal_done,
+	    (unsigned long long)st.selfheal_dropped);
+	printf("row seals:         full %llu, flush %llu (partial %llu)\n",
+	    (unsigned long long)st.seal_full,
+	    (unsigned long long)st.seal_flush,
+	    (unsigned long long)st.seal_partial);
+	printf("open rows:         now %llu, peak %llu\n",
+	    (unsigned long long)st.open_rows_cur,
+	    (unsigned long long)st.open_rows_high);
+	printf("resilver slots:    copied %llu, skipped %llu\n",
+	    (unsigned long long)st.resilver_slots_copied,
+	    (unsigned long long)st.resilver_slots_skipped);
+	free(dk);
+	return 0;
+}
+
+static int
+raid_fail_disk(const char *sel_path, const char *dev)
+{
+	struct hammer2_ioc_raid_fail_disk rfd;
+	int fd;
+	int rc;
+
+	fd = hammer2_ioctl_handle(sel_path);
+	if (fd < 0)
+		return 1;
+	bzero(&rfd, sizeof(rfd));
+	snprintf(rfd.dev, sizeof(rfd.dev), "%s", dev);
+	rc = ioctl(fd, HAMMER2IOC_RAID_FAIL_DISK, &rfd);
+	close(fd);
+	if (rc < 0) {
+		fprintf(stderr, "raid fail-disk %s: %s\n",
+			dev, strerror(errno));
+		return 1;
+	}
+	printf("disk %d (%s) marked failed\n", rfd.disk_idx, dev);
+	return 0;
+}
+
+static int
+raid_replace(const char *sel_path, const char *old_dev, const char *new_dev)
+{
+	struct hammer2_ioc_raid_replace rr;
+	int fd;
+	int rc;
+
+	fd = hammer2_ioctl_handle(sel_path);
+	if (fd < 0)
+		return 1;
+	bzero(&rr, sizeof(rr));
+	snprintf(rr.old_dev, sizeof(rr.old_dev), "%s", old_dev);
+	snprintf(rr.new_dev, sizeof(rr.new_dev), "%s", new_dev);
+	rc = ioctl(fd, HAMMER2IOC_RAID_REPLACE, &rr);
+	close(fd);
+	if (rc < 0) {
+		fprintf(stderr, "raid replace %s -> %s: %s\n",
+			old_dev, new_dev, strerror(errno));
+		switch (errno) {
+		case EBUSY:
+			fprintf(stderr, "  %s is a member of the array, is "
+				"mounted or open elsewhere; or the disk to "
+				"replace is not failed, or a resilver is "
+				"running.  Nothing was written (details in "
+				"the kernel log).\n", new_dev);
+			break;
+		case ENOSPC:
+			fprintf(stderr, "  %s is smaller than the disk it "
+				"would replace.\n", new_dev);
+			break;
+		case ENOENT:
+			fprintf(stderr, "  %s is not a member of the array "
+				"(or %s does not exist).\n", old_dev, new_dev);
+			break;
+		case EINVAL:
+			fprintf(stderr, "  %s is not a disk.\n", new_dev);
+			break;
+		default:
+			break;
+		}
+		return 1;
+	}
+	if (rr.error) {
+		fprintf(stderr, "raid replace: kernel reported error %d\n",
+			rr.error);
+		return 1;
+	}
+	printf("raid replace %s -> %s complete\n", old_dev, new_dev);
+
+	/*
+	 * The resilver copies surviving columns verbatim — it performs no
+	 * checksum verification of its own (bitrot.md §7.4), so any latent
+	 * corruption on a surviving disk was just written to the new disk
+	 * too.  Chain a scrub to verify and repair the whole tree while
+	 * full redundancy is available again.
+	 */
+	printf("raid replace: running post-resilver scrub "
+	       "(resilver does not verify checksums)...\n");
+	return raid_scrub_blocking(sel_path, 0);
+}
+
+static void
+raid_scrub_print_final(const struct hammer2_ioc_raid_scrub *rs)
+{
+	printf("scrub complete:\n");
+	printf("  brefs_done:         %llu\n",
+	       (unsigned long long)rs->brefs_done);
+	printf("  brefs_bad:          %llu\n",
+	       (unsigned long long)rs->brefs_bad);
+	printf("  brefs_repaired:     %llu\n",
+	       (unsigned long long)rs->brefs_repaired);
+	printf("  brefs_unrepairable: %llu\n",
+	       (unsigned long long)rs->brefs_unrepairable);
+	printf("  rows_checked:       %llu\n",
+	       (unsigned long long)rs->rows_checked);
+	printf("  parity_bad:         %llu\n",
+	       (unsigned long long)rs->parity_bad);
+	printf("  parity_repaired:    %llu\n",
+	       (unsigned long long)rs->parity_repaired);
+	printf("  parity_unlocatable: %llu\n",
+	       (unsigned long long)rs->parity_unlocatable);
+	printf("  rows_skipped:       %llu\n",
+	       (unsigned long long)rs->rows_skipped);
+	printf("  error:              %d\n", rs->error);
+}
+
+/*
+ * Blocking scrub.  Returns the kernel's final counters; one ioctl
+ * per call.
+ */
+static int
+raid_scrub_blocking(const char *sel_path, uint32_t flags)
+{
+	struct hammer2_ioc_raid_scrub rs;
+	int fd;
+	int rc;
+
+	fd = hammer2_ioctl_handle(sel_path);
+	if (fd < 0)
+		return 1;
+	bzero(&rs, sizeof(rs));
+	rs.flags = flags;
+	rc = ioctl(fd, HAMMER2IOC_RAID_SCRUB, &rs);
+	close(fd);
+	if (rc < 0) {
+		fprintf(stderr, "raid scrub: %s\n", strerror(errno));
+		return 1;
+	}
+	raid_scrub_print_final(&rs);
+	return (rs.error || rs.brefs_unrepairable || rs.parity_unlocatable) ?
+	    1 : 0;
+}
+
+/*
+ * Polling scrub (-n): fork; the child issues the blocking SCRUB
+ * ioctl and exits; the parent polls SCRUB_STATUS once a second and
+ * prints progress on every change.  Useful for long scrubs where
+ * the user wants visibility into bref/sec progress without tail-f'ing
+ * dmesg.
+ */
+static int
+raid_scrub_polling(const char *sel_path, uint32_t flags)
+{
+	struct hammer2_ioc_raid_scrub rs;
+	uint64_t last_done = ~(uint64_t)0;
+	pid_t pid;
+	int status;
+	int fd;
+
+	fd = hammer2_ioctl_handle(sel_path);
+	if (fd < 0)
+		return 1;
+
+	pid = fork();
+	if (pid < 0) {
+		fprintf(stderr, "raid scrub -n: fork: %s\n", strerror(errno));
+		close(fd);
+		return 1;
+	}
+	if (pid == 0) {
+		/* Child: blocking scrub. */
+		bzero(&rs, sizeof(rs));
+		rs.flags = flags;
+		(void)ioctl(fd, HAMMER2IOC_RAID_SCRUB, &rs);
+		_exit(rs.error ? 1 : 0);
+	}
+
+	/* Parent: poll status until the child completes. */
+	for (;;) {
+		pid_t w;
+
+		sleep(1);
+		w = waitpid(pid, &status, WNOHANG);
+		if (w == pid)
+			break;
+		if (w < 0) {
+			fprintf(stderr, "raid scrub -n: waitpid: %s\n",
+				strerror(errno));
+			break;
+		}
+		bzero(&rs, sizeof(rs));
+		if (ioctl(fd, HAMMER2IOC_RAID_SCRUB_STATUS, &rs) < 0)
+			continue;
+		if (rs.brefs_done != last_done) {
+			printf("\rscrub: %llu brefs done, %llu bad, "
+			       "%llu repaired, %llu unrep    ",
+			       (unsigned long long)rs.brefs_done,
+			       (unsigned long long)rs.brefs_bad,
+			       (unsigned long long)rs.brefs_repaired,
+			       (unsigned long long)rs.brefs_unrepairable);
+			fflush(stdout);
+			last_done = rs.brefs_done;
+		}
+	}
+	printf("\n");
+
+	/* Final snapshot from STATUS (child has exited, scrub_running=0). */
+	bzero(&rs, sizeof(rs));
+	(void)ioctl(fd, HAMMER2IOC_RAID_SCRUB_STATUS, &rs);
+	close(fd);
+	raid_scrub_print_final(&rs);
+	return (rs.error || rs.brefs_unrepairable || rs.parity_unlocatable) ?
+	    1 : 0;
+}
+
+int
+cmd_raid(const char *sel_path, int ac, const char **av)
+{
+	if (ac < 1) {
+		fprintf(stderr,
+		    "raid: subcommand required (status|stats|fail-disk|replace|scrub)\n");
+		return 1;
+	}
+	if (strcmp(av[0], "status") == 0) {
+		/* Optional positional path overrides -s sel_path. */
+		const char *path = (ac >= 2) ? av[1] : sel_path;
+		return raid_status(path);
+	} else if (strcmp(av[0], "stats") == 0) {
+		const char *path = sel_path;
+		int zero = 0, parse = 0;
+		int i;
+
+		for (i = 1; i < ac; i++) {
+			if (strcmp(av[i], "-z") == 0) {
+				zero = 1;
+			} else if (strcmp(av[i], "-p") == 0) {
+				parse = 1;
+			} else if (av[i][0] != '-' && i == ac - 1) {
+				path = av[i];
+			} else {
+				fprintf(stderr, "raid stats: usage: "
+				    "stats [-z] [-p] [<mountpoint>]\n");
+				return 1;
+			}
+		}
+		return raid_stats(path, zero, parse);
+	} else if (strcmp(av[0], "fail-disk") == 0) {
+		if (ac != 2) {
+			fprintf(stderr, "raid fail-disk: requires <dev>\n");
+			return 1;
+		}
+		return raid_fail_disk(sel_path, av[1]);
+	} else if (strcmp(av[0], "replace") == 0) {
+		if (ac != 3) {
+			fprintf(stderr,
+			    "raid replace: requires <old_dev> <new_dev>\n");
+			return 1;
+		}
+		return raid_replace(sel_path, av[1], av[2]);
+	} else if (strcmp(av[0], "scrub") == 0) {
+		int poll = 0;
+		uint32_t flags = 0;
+		int i;
+
+		for (i = 1; i < ac; i++) {
+			if (strcmp(av[i], "-n") == 0) {
+				poll = 1;
+			} else if (strcmp(av[i], "-t") == 0) {
+				flags |= HAMMER2_SCRUB_NOPARITY;
+			} else if (strcmp(av[i], "-p") == 0) {
+				flags |= HAMMER2_SCRUB_NOTREE;
+			} else {
+				fprintf(stderr,
+				    "raid scrub: usage: scrub [-n] [-t | -p]\n");
+				return 1;
+			}
+		}
+		if (poll)
+			return raid_scrub_polling(sel_path, flags);
+		return raid_scrub_blocking(sel_path, flags);
+	}
+	fprintf(stderr, "raid: unknown subcommand '%s'\n", av[0]);
+	return 1;
+}
