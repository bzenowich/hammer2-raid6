+/*
+ * RAID 6 stripe write.
+ *
+ * Given a logical offset and data buffer for a single PBUFSIZE block,
+ * compute the full stripe's P and Q parity and write data + parity
+ * to the correct physical disks.
+ *
+ * This must be called with the data already written to the DIO buffer.
+ * It reads the other data columns in the same stripe (or treats
+ * unallocated columns as zero), computes parity, and issues writes
+ * to the P and Q disks.
+ */
+int
+hammer2_io_raid6_write(hammer2_dev_t *hmp, hammer2_off_t logical_off,
+		       void *data, size_t bytes)
+{
+	hammer2_raid_config_t *rc = &hmp->raid_config;
+	int ndisks = rc->ndisks;
+	int ndata = rc->ndata;
+	uint64_t stripe_unit = rc->stripe_unit;
+	uint64_t stripe_num;
+	int p_disk, q_disk;
+	int col, phys_disk, di;
+	hammer2_off_t stripe_base;
+	hammer2_off_t phys_off;
+	void *ptrs[HAMMER2_MAX_VOLUMES];
+	void *pbuf, *qbuf;
+	void *col_bufs[HAMMER2_MAX_VOLUMES];
+	hammer2_volume_t *vol;
+	struct buf *bp;
+	int error = 0;
+	int i;
+
+	KKASSERT(bytes == stripe_unit);
+	KKASSERT(hmp->raid_type == HAMMER2_RAID_TYPE_RAID6);
+
+	stripe_num = logical_off / ((uint64_t)ndata * stripe_unit);
+	stripe_base = stripe_num * (uint64_t)ndata * stripe_unit;
+
+	/* P and Q disk positions */
+	p_disk = (int)(stripe_num % ndisks);
+	q_disk = (p_disk + 1) % ndisks;
+
+	/* Allocate parity buffers */
+	pbuf = kmalloc(stripe_unit, M_HAMMER2, M_WAITOK | M_ZERO);
+	qbuf = kmalloc(stripe_unit, M_HAMMER2, M_WAITOK | M_ZERO);
+
+	/*
+	 * Build array of data column pointers for syndrome generation.
+	 * Read existing data from other columns in this stripe.
+	 */
+	for (i = 0; i < HAMMER2_MAX_VOLUMES; i++)
+		col_bufs[i] = NULL;
+
+	di = 0;
+	for (phys_disk = 0; phys_disk < ndisks; phys_disk++) {
+		if (phys_disk == p_disk || phys_disk == q_disk)
+			continue;
+		col = di++;
+		if (stripe_base + (uint64_t)col * stripe_unit == logical_off) {
+			/* This is the column being written */
+			ptrs[col] = data;
+		} else {
+			/*
+			 * Read existing data from this column.
+			 * Treat as zeros if not yet allocated (COW).
+			 */
+			vol = &hmp->volumes[phys_disk];
+			phys_off = stripe_num * stripe_unit;
+			col_bufs[col] = kmalloc(stripe_unit, M_HAMMER2,
+						M_WAITOK | M_ZERO);
+			error = breadnx(vol->dev->devvp,
+					phys_off - vol->offset,
+					stripe_unit, 0,
+					NULL, NULL, 0, &bp);
+			if (error == 0 && bp) {
+				bkvasync(bp);
+				bcopy(bp->b_data, col_bufs[col], stripe_unit);
+				brelse(bp);
+			} else {
+				if (bp)
+					brelse(bp);
+				/* Treat as zeros on error */
+				bzero(col_bufs[col], stripe_unit);
+			}
+			ptrs[col] = col_bufs[col];
+		}
+	}
+	ptrs[ndata] = pbuf;
+	ptrs[ndata + 1] = qbuf;
+
+	/* Generate P and Q syndromes */
+	hammer2_raid6_gen_syndrome(ndisks, stripe_unit, ptrs);
+
+	/* Write P parity */
+	vol = &hmp->volumes[p_disk];
+	phys_off = stripe_num * stripe_unit;
+	bp = getblk(vol->dev->devvp, phys_off - vol->offset,
+		    stripe_unit, GETBLK_KVABIO, 0);
+	if (bp) {
+		bkvasync(bp);
+		bcopy(pbuf, bp->b_data, stripe_unit);
+		bawrite(bp);
+	}
+
+	/* Write Q parity */
+	vol = &hmp->volumes[q_disk];
+	bp = getblk(vol->dev->devvp, phys_off - vol->offset,
+		    stripe_unit, GETBLK_KVABIO, 0);
+	if (bp) {
+		bkvasync(bp);
+		bcopy(qbuf, bp->b_data, stripe_unit);
+		bawrite(bp);
+	}
+
+	/* Free temporary buffers */
+	for (i = 0; i < HAMMER2_MAX_VOLUMES; i++) {
+		if (col_bufs[i])
+			kfree(col_bufs[i], M_HAMMER2);
+	}
+	kfree(pbuf, M_HAMMER2);
+	kfree(qbuf, M_HAMMER2);
+
+	return error;
+}
+
+/*
+ * RAID 6 degraded read.
+ *
+ * Read a data block from a RAID 6 array in degraded mode.
+ * When the target disk has failed, reconstruct the data from
+ * surviving disks + parity.
+ *
+ * Returns 0 on success, error code on failure.
+ * The reconstructed data is placed in the provided buffer.
+ */
+int
+hammer2_io_raid6_read_degraded(hammer2_dev_t *hmp, hammer2_off_t logical_off,
+			       void *buf, size_t bytes)
+{
+	hammer2_raid_config_t *rc = &hmp->raid_config;
+	int ndisks = rc->ndisks;
+	int ndata = rc->ndata;
+	uint64_t stripe_unit = rc->stripe_unit;
+	uint64_t stripe_num;
+	int p_disk, q_disk;
+	int target_col, target_disk;
+	int phys_disk, di, col;
+	hammer2_off_t phys_off;
+	void *ptrs[HAMMER2_MAX_VOLUMES];
+	void *col_bufs[HAMMER2_MAX_VOLUMES];
+	hammer2_volume_t *vol;
+	struct buf *bp;
+	int error = 0;
+	int faila = -1, failb = -1;
+	int i;
+
+	KKASSERT(bytes == stripe_unit);
+	KKASSERT(hmp->raid_type == HAMMER2_RAID_TYPE_RAID6);
+
+	stripe_num = logical_off / ((uint64_t)ndata * stripe_unit);
+
+	/* P and Q disk positions */
+	p_disk = (int)(stripe_num % ndisks);
+	q_disk = (p_disk + 1) % ndisks;
+
+	/* Find which physical disk the target data column maps to */
+	target_col = (int)((logical_off / stripe_unit) % ndata);
+	di = 0;
+	target_disk = -1;
+	for (phys_disk = 0; phys_disk < ndisks; phys_disk++) {
+		if (phys_disk == p_disk || phys_disk == q_disk)
+			continue;
+		if (di == target_col) {
+			target_disk = phys_disk;
+			break;
+		}
+		di++;
+	}
+	KKASSERT(target_disk >= 0);
+
+	/* Identify failed disks */
+	for (i = 0; i < HAMMER2_MAX_VOLUMES; i++)
+		col_bufs[i] = NULL;
+
+	/*
+	 * Read all columns in the stripe (including P and Q).
+	 * For failed disks, use zero-filled buffers.
+	 */
+	di = 0;
+	for (phys_disk = 0; phys_disk < ndisks; phys_disk++) {
+		if (phys_disk == p_disk || phys_disk == q_disk)
+			continue;
+		col = di++;
+
+		col_bufs[col] = kmalloc(stripe_unit, M_HAMMER2,
+					M_WAITOK | M_ZERO);
+		if (hmp->raid_failed[phys_disk]) {
+			/* Failed disk - track for recovery */
+			if (faila == -1)
+				faila = col;
+			else if (failb == -1)
+				failb = col;
+			/* Leave buffer zeroed */
+		} else {
+			vol = &hmp->volumes[phys_disk];
+			phys_off = stripe_num * stripe_unit;
+			error = breadnx(vol->dev->devvp,
+					phys_off - vol->offset,
+					stripe_unit, 0,
+					NULL, NULL, 0, &bp);
+			if (error == 0 && bp) {
+				bkvasync(bp);
+				bcopy(bp->b_data, col_bufs[col], stripe_unit);
+				brelse(bp);
+			} else {
+				if (bp)
+					brelse(bp);
+				/* Treat read error as disk failure */
+				if (faila == -1)
+					faila = col;
+				else if (failb == -1)
+					failb = col;
+			}
+		}
+		ptrs[col] = col_bufs[col];
+	}
+
+	/* Read P parity */
+	col_bufs[ndata] = kmalloc(stripe_unit, M_HAMMER2, M_WAITOK | M_ZERO);
+	if (!hmp->raid_failed[p_disk]) {
+		vol = &hmp->volumes[p_disk];
+		phys_off = stripe_num * stripe_unit;
+		error = breadnx(vol->dev->devvp, phys_off - vol->offset,
+				stripe_unit, 0, NULL, NULL, 0, &bp);
+		if (error == 0 && bp) {
+			bkvasync(bp);
+			bcopy(bp->b_data, col_bufs[ndata], stripe_unit);
+			brelse(bp);
+		} else {
+			if (bp)
+				brelse(bp);
+			if (faila == -1)
+				faila = ndata;
+			else if (failb == -1)
+				failb = ndata;
+		}
+	} else {
+		if (faila == -1)
+			faila = ndata;
+		else if (failb == -1)
+			failb = ndata;
+	}
+	ptrs[ndata] = col_bufs[ndata];
+
+	/* Read Q parity */
+	col_bufs[ndata + 1] = kmalloc(stripe_unit, M_HAMMER2,
+				       M_WAITOK | M_ZERO);
+	if (!hmp->raid_failed[q_disk]) {
+		vol = &hmp->volumes[q_disk];
+		phys_off = stripe_num * stripe_unit;
+		error = breadnx(vol->dev->devvp, phys_off - vol->offset,
+				stripe_unit, 0, NULL, NULL, 0, &bp);
+		if (error == 0 && bp) {
+			bkvasync(bp);
+			bcopy(bp->b_data, col_bufs[ndata + 1], stripe_unit);
+			brelse(bp);
+		} else {
+			if (bp)
+				brelse(bp);
+			if (faila == -1)
+				faila = ndata + 1;
+			else if (failb == -1)
+				failb = ndata + 1;
+		}
+	} else {
+		if (faila == -1)
+			faila = ndata + 1;
+		else if (failb == -1)
+			failb = ndata + 1;
+	}
+	ptrs[ndata + 1] = col_bufs[ndata + 1];
+
+	/* Perform recovery */
+	if (faila >= 0 && failb >= 0) {
+		hammer2_raid6_dual_recov(ndisks, stripe_unit,
+					faila, failb, ptrs);
+	} else if (faila >= 0) {
+		/* Single failure - use P to recover data */
+		hammer2_raid6_dual_recov(ndisks, stripe_unit,
+					faila, ndisks - 1, ptrs);
+	}
+
+	/* Copy the target column's data to output buffer */
+	bcopy(ptrs[target_col], buf, stripe_unit);
+
+	/* Free temporary buffers */
+	for (i = 0; i <= ndata + 1; i++) {
+		if (col_bufs[i])
+			kfree(col_bufs[i], M_HAMMER2);
+	}
+
+	return 0;
+}
