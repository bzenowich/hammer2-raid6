+/*
+ * Fill buffer with pseudo-random data seeded by disk index + stripe.
+ */
+static void
+fill_random(uint8_t *buf, size_t len, unsigned int seed)
+{
+	unsigned int state = seed ^ 0xdeadbeef;
+	size_t i;
+
+	for (i = 0; i < len; i++) {
+		state = state * 1103515245 + 12345;
+		buf[i] = (uint8_t)(state >> 16);
+	}
+}
+
+/* ===== Test 1: GF(2^8) field properties ===== */
+static void
+test_gf_field_properties(void)
+{
+	int a, b, c;
+
+	printf("  Test 1: GF(2^8) field properties\n");
+
+	/* Identity: a * 1 = a */
+	for (a = 0; a < 256; a++) {
+		CHECK(hammer2_gf_mul(a, 1) == a,
+		    "mul identity: %d * 1 = %d (expected %d)",
+		    a, hammer2_gf_mul(a, 1), a);
+	}
+
+	/* Zero: a * 0 = 0 */
+	for (a = 0; a < 256; a++) {
+		CHECK(hammer2_gf_mul(a, 0) == 0,
+		    "mul zero: %d * 0 = %d",
+		    a, hammer2_gf_mul(a, 0));
+	}
+
+	/* Commutativity: a * b = b * a */
+	for (a = 0; a < 256; a++) {
+		for (b = 0; b < 256; b++) {
+			CHECK(hammer2_gf_mul(a, b) == hammer2_gf_mul(b, a),
+			    "commutativity: %d*%d=%d, %d*%d=%d",
+			    a, b, hammer2_gf_mul(a, b),
+			    b, a, hammer2_gf_mul(b, a));
+		}
+	}
+
+	/* Inverse: a * inv(a) = 1 for all a != 0 */
+	for (a = 1; a < 256; a++) {
+		uint8_t inv = hammer2_gf_inv[a];
+		CHECK(hammer2_gf_mul(a, inv) == 1,
+		    "inverse: %d * inv(%d)=%d = %d (expected 1)",
+		    a, a, inv, hammer2_gf_mul(a, inv));
+	}
+
+	/* Division: (a * b) / b = a for all b != 0 */
+	for (a = 0; a < 256; a++) {
+		for (b = 1; b < 256; b++) {
+			uint8_t prod = hammer2_gf_mul(a, b);
+			CHECK(hammer2_gf_div(prod, b) == a,
+			    "division: (%d*%d)/%d = %d (expected %d)",
+			    a, b, b, hammer2_gf_div(prod, b), a);
+		}
+	}
+
+	/* mul2 consistency: mul2(a) = mul_table[a][2] */
+	for (a = 0; a < 256; a++) {
+		CHECK(hammer2_gf_mul2(a) == hammer2_gf_mul(a, 2),
+		    "mul2 consistency: mul2(%d)=%d, table=%d",
+		    a, hammer2_gf_mul2(a), hammer2_gf_mul(a, 2));
+	}
+
+	/* Associativity (spot check): (a*b)*c = a*(b*c) */
+	for (a = 0; a < 256; a += 17) {
+		for (b = 0; b < 256; b += 19) {
+			for (c = 0; c < 256; c += 23) {
+				uint8_t ab_c = hammer2_gf_mul(
+				    hammer2_gf_mul(a, b), c);
+				uint8_t a_bc = hammer2_gf_mul(
+				    a, hammer2_gf_mul(b, c));
+				CHECK(ab_c == a_bc,
+				    "assoc: (%d*%d)*%d=%d, %d*(%d*%d)=%d",
+				    a, b, c, ab_c, a, b, c, a_bc);
+			}
+		}
+	}
+
+	/* Exp/log consistency: exp[log[a]] = a for a != 0 */
+	for (a = 1; a < 256; a++) {
+		CHECK(hammer2_gf_exp[hammer2_gf_log[a]] == a,
+		    "exp/log: exp[log[%d]] = %d",
+		    a, hammer2_gf_exp[hammer2_gf_log[a]]);
+	}
+
+	/* Power: gf_pow(2, i) = gf_exp[i] for i < 255 */
+	for (a = 0; a < 255; a++) {
+		CHECK(hammer2_gf_pow(2, a) == hammer2_gf_exp[a],
+		    "pow: pow(2,%d)=%d, exp[%d]=%d",
+		    a, hammer2_gf_pow(2, a), a, hammer2_gf_exp[a]);
+	}
+
+	/* Generator order: 2^255 = 1 (wraps) */
+	{
+		uint8_t x = 1;
+		int i;
+		for (i = 0; i < 255; i++)
+			x = hammer2_gf_mul2(x);
+		CHECK(x == 1, "generator order: 2^255 = %d (expected 1)", x);
+	}
+
+	printf("    Field properties: %d tests\n", tests_run);
+}
+
+/* ===== Test 2: Syndrome generation ===== */
+static void
+test_syndrome_generation(void)
+{
+	int ndisks, ndata;
+	int prev = tests_run;
+
+	printf("  Test 2: Syndrome generation\n");
+
+	/*
+	 * Test with 4..8 total disks.
+	 * Verify P = XOR of all data, Q matches manual computation.
+	 */
+	for (ndisks = 4; ndisks <= 8; ndisks++) {
+		uint8_t *bufs[8];
+		void *ptrs[8];
+		uint8_t *p_verify, *q_verify;
+		size_t d;
+		int i, z;
+
+		ndata = ndisks - 2;
+
+		/* Allocate and fill data disks */
+		for (i = 0; i < ndisks; i++) {
+			bufs[i] = malloc(TEST_BLOCK_SIZE);
+			ptrs[i] = bufs[i];
+		}
+		for (i = 0; i < ndata; i++)
+			fill_random(bufs[i], TEST_BLOCK_SIZE, i * 1000 + ndisks);
+		/* P and Q will be computed */
+		memset(bufs[ndisks - 2], 0, TEST_BLOCK_SIZE);
+		memset(bufs[ndisks - 1], 0, TEST_BLOCK_SIZE);
+
+		/* Generate syndromes */
+		hammer2_raid6_gen_syndrome(ndisks, TEST_BLOCK_SIZE, ptrs);
+
+		/* Verify P = XOR of all data disks */
+		p_verify = calloc(1, TEST_BLOCK_SIZE);
+		for (i = 0; i < ndata; i++) {
+			for (d = 0; d < TEST_BLOCK_SIZE; d++)
+				p_verify[d] ^= bufs[i][d];
+		}
+		CHECK(memcmp(bufs[ndisks - 2], p_verify, TEST_BLOCK_SIZE) == 0,
+		    "P parity mismatch for ndisks=%d", ndisks);
+
+		/* Verify Q = sum(data[i] * 2^i) */
+		q_verify = calloc(1, TEST_BLOCK_SIZE);
+		for (i = 0; i < ndata; i++) {
+			for (d = 0; d < TEST_BLOCK_SIZE; d++) {
+				q_verify[d] ^= hammer2_gf_mul(
+				    hammer2_gf_exp[i], bufs[i][d]);
+			}
+		}
+		CHECK(memcmp(bufs[ndisks - 1], q_verify, TEST_BLOCK_SIZE) == 0,
+		    "Q parity mismatch for ndisks=%d", ndisks);
+
+		free(p_verify);
+		free(q_verify);
+		for (i = 0; i < ndisks; i++)
+			free(bufs[i]);
+	}
+
+	printf("    Syndrome generation: %d tests\n", tests_run - prev);
+}
